{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node", "react"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": [
    "build.mjs",
    "index.mjs",
    "host/**/*.mjs",
    "src/**/*.cjs",
    "src/**/*.mjs",
    "src/**/*.tsx",
    "src/**/*.d.ts"
  ]
}
