{
  "name": "@allrice/d-entry-principal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./host": {
      "types": "./lib/types/host.d.ts",
      "default": "./lib/host.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./artifact": "./lib/current-principal.manifest.json",
    "./policy": {
      "types": "./lib/types/policy.d.ts",
      "default": "./lib/policy.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@allrice/contracts": "workspace:*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.2",
    "esbuild": "0.28.1",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "typescript": "5.9.3"
  },
  "imports": {
    "#principal-artifacts": "./lib/artifacts.js"
  }
}
