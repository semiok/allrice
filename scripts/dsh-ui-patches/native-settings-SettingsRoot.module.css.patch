--- a/packages/client/ui-settings-general/src/client/SettingsRoot.module.css
+++ b/packages/client/ui-settings-general/src/client/SettingsRoot.module.css
@@ -242,7 +242,26 @@
   white-space: nowrap;
 }
 
-/* No app-region rule here: the overlay portals beside #root (SettingsRoot), so
-   ui-web base.css's `body > :not(#root)` subtraction covers it wherever it
-   overlaps a chrome row's drag — including above every column, which an in-root
-   overlay could not promise once a chrome row declares drag itself. */
+/* macOS: overlays covering the window drag bands must subtract themselves
+   (Electron app-regions are geometry, not stacking). */
+:global([data-platform='darwin']) .overlay {
+  -webkit-app-region: no-drag;
+}
+
+/* Allrice: compose the published headless Modal and fit narrow workspaces. */
+.panel.panel {
+  flex-direction: row;
+  gap: 0;
+  padding: 0;
+}
+
+@media (max-width: 600px) {
+  .panel.panel { flex-direction: column; border-radius: 20px; }
+  .nav { width: 100%; padding: 18px 16px 0; gap: 12px; }
+  .navTitle { padding: 0; }
+  .navList { flex-direction: row; overflow-x: auto; padding-bottom: 4px; }
+  .navCell { flex: none; padding: 8px 10px; }
+  .content { min-height: 0; }
+  .header { height: 42px; padding-top: 4px; }
+  .options { padding: 0 16px 20px; }
+}
