#!/bin/bash
# Five real end-to-end smoke checks (rules: AGENTS.md §5 at the repository root): chat, office, csv,
# browser, reminder. Uses real model calls; takes ~5-8 minutes for all five.
#
#   smoke-test --dev [--only a,b]               shared Dev with the smoke account
#   smoke-test --instance <task> [--only a,b]   a QA instance (default: chat,browser,reminder —
#                                               cloud execution is off there, so office/csv are skipped)
set -euo pipefail
NODE="$HOME/.local/opt/node-22.23.2/bin/node"; BIN="$HOME/allrice-dev/bin"
ts=$(date +%Y%m%d-%H%M%S)
case "${1:-}" in
  --dev)
    shift
    port=$(/usr/bin/python3 -c 'import plistlib,os;print(plistlib.load(open(os.path.expanduser("~/Library/LaunchAgents/ai.bplabs.allrice-dev-web.plist"),"rb"))["EnvironmentVariables"]["ALLRICE_WEB_PORT"])')
    exec "$NODE" "$BIN/smoke-test.mjs" --url "http://127.0.0.1:$port" --creds "$HOME/allrice-dev/qa/smoke-cred.json" \
      --out "$HOME/allrice-dev/qa/smoke/$ts" "$@" ;;
  --instance)
    task=${2:?task}; shift 2
    f="$HOME/allrice-qa/$task/instance.json"; [ -f "$f" ] || { echo "no QA instance: $task" >&2; exit 2; }
    port=$(/usr/bin/python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["webPort"])' "$f")
    extra=("$@"); [[ " $* " == *" --only "* ]] || extra+=(--only chat,browser,reminder)
    exec "$NODE" "$BIN/smoke-test.mjs" --url "http://127.0.0.1:$port" --creds "$HOME/allrice-qa/$task/creds.json" \
      --out "$HOME/allrice-qa/$task/smoke/$ts" "${extra[@]}" ;;
  *) sed -n 2,9p "$0"; exit 2 ;;
esac
