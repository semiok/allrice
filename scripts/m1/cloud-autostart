#!/bin/bash
# Bring the cloud sandbox back after the Mac restarts (rules: AGENTS.md at the repository
# root). The sandbox is a colima VM; the Office renderer is a container in it with
# restart=unless-stopped, so it returns on its own once the VM's Docker daemon is up. What
# never returned on its own was the VM itself. A login agent runs this at login and
# retries it every minute until it succeeds.
#
#   cloud-autostart                  start the VM if it is stopped, then wait until the
#                                    renderer is healthy and the cloud watchdog attests ready
#   cloud-autostart status           print the VM, renderer, watchdog and login agent state
#                                    (with its last exit code); exit 1 unless all are ready
#   cloud-autostart install-agent [program]
#                                    install and load the login agent (release manager
#                                    only); program defaults to ~/allrice-dev/bin/cloud-autostart
#
# The VM profile, the colima binary and the renderer URL come from the shared Dev Worker's
# launchd plist, so they are configured in one place. This only covers starting: a VM
# that fails later is for MET-222's health checks to report. launchd login agents need a
# logged-in user: with FileVault on, nothing here (or the Dev itself) starts after an
# unattended reboot until someone logs in.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd -P)
. "$here/lib.sh"
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
LABEL=ai.bplabs.allrice-cloud-autostart
WORKER_PLIST="$HOME/Library/LaunchAgents/ai.bplabs.allrice-dev-worker.plist"
CONTAINER=allrice-office-renderer
say() { echo "[cloud-autostart $(date '+%F %T')] $*"; }

worker_env() {
  "$M1_PY" -c 'import plistlib,sys
print(plistlib.load(open(sys.argv[1],"rb"))["EnvironmentVariables"].get(sys.argv[2],""))' "$WORKER_PLIST" "$1"
}
config_missing() {
  echo "cloud-autostart: cannot read ALLRICE_CLOUD_PROFILE / ALLRICE_CLOUD_COLIMA / ALLRICE_OFFICE_RENDERER_URL from $WORKER_PLIST" >&2
  exit 2
}
PROFILE=$(worker_env ALLRICE_CLOUD_PROFILE 2>/dev/null) || config_missing
COLIMA=$(worker_env ALLRICE_CLOUD_COLIMA 2>/dev/null) || config_missing
RENDERER_URL=$(worker_env ALLRICE_OFFICE_RENDERER_URL 2>/dev/null) || config_missing
[ -n "$PROFILE" ] && [ -x "${COLIMA:-/nonexistent}" ] && [ -n "$RENDERER_URL" ] || config_missing
# The same Docker socket the Worker uses for this profile.
DOCKER_HOST_SOCKET="unix://$HOME/.colima/$PROFILE/docker.sock"

# bounded <seconds> <command...>: run in its own session and process group, with every
# descriptor beyond stdin/stdout/stderr closed. colima leaves a long-lived limactl behind:
# it must not inherit the deploy lock, and launchd must not reap it with this job's group.
# On timeout the whole group is killed, so a pipe it writes to closes. Exit 124 on timeout.
bounded() {
  "$M1_PY" -c 'import os,signal,subprocess,sys
p = subprocess.Popen(sys.argv[2:], close_fds=True, start_new_session=True)
try:
    sys.exit(p.wait(timeout=float(sys.argv[1])))
except subprocess.TimeoutExpired:
    try: os.killpg(p.pid, signal.SIGKILL)
    except ProcessLookupError: pass
    p.wait()
    sys.exit(124)' "$@"
}
vm_running() { bounded 20 "$COLIMA" status "$PROFILE" >/dev/null 2>&1; }
renderer_healthy() {
  [ "$(bounded 15 docker --host "$DOCKER_HOST_SOCKET" inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{end}}' "$CONTAINER" 2>/dev/null)" = "running healthy" ] &&
    # The container's own check passed; also confirm the port published on the host serves
    # the renderer's health endpoint.
    curl -fsS -m 5 "${RENDERER_URL%/}/health" 2>/dev/null |
      "$M1_PY" -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("ready") is True else 1)' 2>/dev/null
}
watchdog_ready() {
  bounded 20 "$COLIMA" ssh --profile "$PROFILE" -- sudo /usr/local/lib/allrice-cloud/watchdog.py --attest 2>/dev/null |
    "$M1_PY" -c 'import json,sys; sys.exit(0 if json.load(sys.stdin).get("ready") is True else 1)' 2>/dev/null
}
# until_deadline <seconds> <check>: retry the check until it passes before the deadline.
# Each probe is itself bounded; a pass that lands after the deadline does not count.
until_deadline() {
  local end=$((SECONDS + $1))
  while [ "$SECONDS" -lt "$end" ]; do
    if "$2"; then [ "$SECONDS" -le "$end" ] && return 0 || return 1; fi
    [ $((end - SECONDS)) -gt 2 ] || return 1
    sleep 2
  done
  return 1
}

case "${1:-start}" in
status)
  ok=0
  if vm_running; then echo "vm $PROFILE: running"; else echo "vm $PROFILE: stopped"; ok=1; fi
  if renderer_healthy; then echo "renderer $CONTAINER: healthy"; else echo "renderer $CONTAINER: not healthy"; ok=1; fi
  if watchdog_ready; then echo "cloud watchdog: ready"; else echo "cloud watchdog: not ready"; ok=1; fi
  # The login agent must be loaded, and its last run (launchd keeps the exit code) must
  # have succeeded or still be running: otherwise the next login will not recover.
  agent=$("$M1_LAUNCHCTL" print "gui/$M1_UID/$LABEL" 2>/dev/null || true)
  if [ -z "$agent" ]; then
    echo "agent $LABEL: not loaded"; ok=1
  else
    last=$(printf '%s\n' "$agent" | /usr/bin/awk -F'= ' '/last exit code/ {print $2; exit}')
    echo "agent $LABEL: loaded${last:+, last exit code $last}"
    case "$last" in 0 | "" | "(never exited)") ;; *) ok=1 ;; esac
  fi
  exit $ok
  ;;
start)
  if vm_running; then
    say "vm $PROFILE already running"
  else
    say "starting vm $PROFILE"
    bounded 300 "$COLIMA" start "$PROFILE" || { say "colima start failed" >&2; exit 1; }
  fi
  until_deadline 180 renderer_healthy || { say "renderer $CONTAINER not healthy within 180s" >&2; exit 1; }
  say "renderer $CONTAINER healthy at $RENDERER_URL"
  # Cloud execution needs the gVisor runtime and the VM watchdog, which the Worker checks
  # through the same attestation before every run; a running VM alone is not enough.
  until_deadline 60 watchdog_ready || {
    say "cloud watchdog not ready within 60s (gVisor runtime or watchdog service missing)" >&2
    exit 1
  }
  say "cloud watchdog attests ready"
  ;;
install-agent)
  program=${2:-$HOME/allrice-dev/bin/cloud-autostart}
  [ -x "$program" ] || { echo "cloud-autostart: $program is not executable" >&2; exit 2; }
  # Never reload under a start that is still running: its colima would carry on beside
  # the new one.
  if [ "$(job_state "$LABEL" | /usr/bin/cut -d' ' -f1)" = running ] ||
    /usr/bin/pgrep -f "colima start $PROFILE" >/dev/null 2>&1; then
    echo "cloud-autostart: a start is in progress; run install-agent again when it has finished" >&2
    exit 3
  fi
  plist="$HOME/Library/LaunchAgents/$LABEL.plist"
  "$M1_PY" - "$plist" "$LABEL" "$HOME" "$program" <<'PY'
import os, plistlib, sys
path, label, home, program = sys.argv[1:]
spec = {
    'Label': label,
    'ProgramArguments': [program, 'start'],
    'RunAtLoad': True,
    # Retry a failed start every minute; a successful run is not restarted. colima runs
    # in its own session (see bounded), so ending this job never takes the VM down.
    'KeepAlive': {'SuccessfulExit': False},
    'ThrottleInterval': 60,
    'StandardOutPath': f'{home}/Library/Logs/allrice-cloud-autostart.log',
    'StandardErrorPath': f'{home}/Library/Logs/allrice-cloud-autostart.log',
}
tmp = path + '.tmp'
with open(tmp, 'wb') as f:
    plistlib.dump(spec, f)
os.chmod(tmp, 0o644)
os.replace(tmp, path)
PY
  # Loading the agent runs it at once (RunAtLoad): the VM starts if it is stopped.
  stop_job "$LABEL"
  start_job "$LABEL" "$plist"
  say "agent $LABEL loaded from $plist, running $program at login (and now)"
  ;;
*)
  echo "usage: cloud-autostart [start|status|install-agent [program]]" >&2
  exit 2
  ;;
esac
