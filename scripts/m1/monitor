def check_sandbox_vm(r):
    """The colima VM, its docker daemon and the sandbox watchdog. Images and the Office
    container are judged whenever docker answers, also when only the watchdog is down.
    Not judged under the deploy lock (planned VM maintenance runs under it)."""
    out, colima = [], r.cfg['colima'] or '/opt/homebrew/bin/colima'
    main = r.cfg['colimaProfile']
    r.facts['vmOk'] = False
    if not main:
        out.append(finding('sandbox_vm:config', 'warning', '沙箱 VM 读不到配置', 'Worker 的 launchd 文件里没有 ALLRICE_CLOUD_PROFILE', 'm1-sandbox-vm.md', ''))
    planned = deploying(r)
    if main and planned:
        out.append(unknown('sandbox_vm:' + main))
    for profile in [p for p in [main] + list(r.cfg['extraColimaProfiles']) if p and not (p == main and planned)]:
        rc, _, err = run([colima, 'status', '-p', profile], 30)
        detail = '' if rc == 0 else 'VM 没在运行：colima status -p %s 退出码 %d：%s' % (profile, rc, short(err, 160))
        if rc == 0 and profile == main:
            drc, _, derr = r.docker('info', '--format', '{{.ServerVersion}}', timeout=20)
            if drc:
                detail = 'VM 在运行，但 docker 守护进程无响应：%s' % short(derr, 160)
            else:
                r.facts['vmOk'] = True
                wrc, wout, _ = run([colima, 'ssh', '-p', profile, '--', 'systemctl', 'is-active', r.cfg['vmWatchdog']], 30)
                arc, aout, aerr = run([colima, 'ssh', '-p', profile, '--', 'sudo', r.cfg['vmWatchdogAttest'], '--attest'], 15)
                attest = {}
                for line in aout.splitlines()[::-1]:
                    try:
                        attest = json.loads(line)
                        break
                    except ValueError:
                        continue
                if not isinstance(attest, dict) or arc != 0:
                    attest = {}
                if wout.strip() != 'active':
                    detail = 'VM 和 docker 在运行，但沙箱守护 %s 状态 %s（到点停容器靠它）' % (r.cfg['vmWatchdog'], short(wout, 40) or 'exit %d' % wrc)
                elif attest.get('ready') is not True:
                    # The Worker refuses cloud runs (CLOUD_WATCHDOG_UNAVAILABLE) on exactly this,
                    # also while the service is active (e.g. runsc lost after a VM restart).
                    detail = 'VM 和 docker 在运行，但沙箱守护证明不是 ready（watchdog.py --attest 退出码 %d）：%s' % (
                        arc, short(aout or aerr, 160))
        out.append(finding('sandbox_vm:' + profile, 'critical' if detail else 'ok', '沙箱 VM %s 不可用' % profile, detail,
                           'm1-sandbox-vm.md', '/opt/homebrew/bin/colima status -p %s; /opt/homebrew/bin/colima ssh -p %s -- systemctl status %s docker' % (
                               profile, profile, r.cfg['vmWatchdog'])))
    return out


def pinned_images(r):
    """The images the running release pins (packages/contracts cloud-platform), so a deploy
    that changes them is followed without editing this file."""
    if r.cfg['images'] is not None:
        return dict(r.cfg['images'])
    if not r.cfg.get('release') or not r.cfg.get('node'):
        raise CheckError('cannot tell which release runs (worker plist)')
    js = os.path.join(r.cfg['release'], 'packages/contracts/dist/runtime-v2/cloud-platform.js')
