def check_deadlocks(r):
    """pg_stat_database.deadlocks only grows; it restarts from 0 after a crash or a stats
    reset, which starts a new series instead of counting as negative deadlocks."""
    b, row = r.cfg['business'], biz(r, SQL_DEADLOCKS)
    hour = r.now - 3600
    samples = [s for s in r.state.get('deadlocks', []) if s[0] >= hour]
    if samples and (row['total'] < samples[-1][1] or row['reset'] != samples[-1][2]):
        samples = []
    samples.append([r.now, row['total'], row['reset']])
    r.state['deadlocks'] = samples
    grew = samples[-1][1] - samples[0][1]
    sev = 'critical' if grew >= b['deadlock_critical_per_hour'] or row['job_start'] else 'warning' if grew else 'ok'
    return [finding('business.deadlocks', sev, '数据库死锁', '近 1 小时 %d 次（累计 %d）；作业因死锁启动失败 %d 个；例 %s' % (
        grew, row['total'], row['job_start'], ids(row)), BUSINESS_RUNBOOK, 'grep -c "deadlock detected" /opt/homebrew/var/log/postgresql@17.log')]


def failure_groups(r):
    """Failure groups of the last 24 hours: `new` (a code not seen in the baseline days),
    `increased` (at least failure_increase_min and failure_increase_ratio times its daily
    baseline average) or `steady`."""
    b = r.cfg['business']
    groups = biz(r, SQL_FAILURE_GROUPS)['groups']
    for g in groups:
        g['dailyBefore'] = round(g['before'] / b['failure_baseline_days'], 2)
        g['kind'] = 'new' if not g['before'] else 'increased' if (
            g['today'] >= b['failure_increase_min'] and g['today'] >= b['failure_increase_ratio'] * max(g['dailyBefore'], 1)) else 'steady'
    return {'generatedAt': time.strftime('%Y-%m-%dT%H:%M:%S%z', time.localtime(r.now)), 'windowHours': 24,
            'baselineDays': b['failure_baseline_days'], 'groups': groups}


PG_RESOURCE_ERRORS = ('out of shared memory', 'sorry, too many clients already', 'remaining connection slots are reserved')


def check_pg_resources(r):
    """Postgres running out of a shared resource (the lock table: "out of shared memory";
    connection slots), read from the lines its log gained since the last round and counted
    per hour; one exhausted lock table fails queries of every database on the server."""
    path, b = expand(r.cfg['pgLog']), r.cfg['business']
    try:
        st = os.stat(path)
    except OSError as err:
        raise CheckError('cannot read %s: %s' % (path, err)) from None
    seen = r.state.get('pgLog')
    start = seen['offset'] if seen and seen['inode'] == st.st_ino and seen['offset'] <= st.st_size else (0 if seen else st.st_size)
    end, skipped = st.st_size, max(0, st.st_size - 8 * 2 ** 20 - start)  # a huge burst: the last 8 MiB are enough
    start += skipped
    with open(path, 'rb') as f:
        f.seek(start)
        chunk = f.read(end - start)
    complete = chunk[:chunk.rfind(b'\n') + 1]  # a line still being written is read next round
    found = {}
    for line in complete.decode('utf-8', 'replace').splitlines():
        if any(pattern in line for pattern in PG_RESOURCE_ERRORS):
            m = re.match(r'\S+ \S+ \S+ \[\d+\] (\S+) (?:ERROR|FATAL)', line)
            db = m.group(1) if m else '?'
            found[db] = found.get(db, 0) + 1
    r.state['pgLog'] = {'inode': st.st_ino, 'offset': start + len(complete)}
    if skipped:
        found['（跳过未读 %d MiB）' % (skipped // 2 ** 20)] = 0
    hour = [x for x in r.state.get('pgErrors', []) if r.now - x[0] < 3600]
    if found:
        hour.append([r.now, found])
    r.state['pgErrors'] = hour
    total, per_db = 0, {}
    for _, counts in hour:
        for db, n in counts.items():
            per_db[db] = per_db.get(db, 0) + n
            total += n
    sev = 'critical' if total >= b['pg_errors_critical_per_hour'] else 'warning' if total else 'ok'
    return [finding('business.pg_resources', sev, '数据库资源耗尽（锁表或连接数）',
                    '近 1 小时日志里 %d 次 out of shared memory / 连接数用满，按库：%s' % (
                        total, '、'.join('%s %d' % kv for kv in sorted(per_db.items(), key=lambda kv: -kv[1]))),
                    'm1-database.md#资源耗尽', 'grep -E "out of shared memory|too many clients" %s | tail -20' % path)]


