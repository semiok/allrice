SQL_DAILY = """
select (select count(*) from allrice_runs r join allrice_jobs j on j.run_id = r.id where r.completed_at >= now() - interval '24 hours')::int as finished,
  (select count(*) from allrice_runs r join allrice_jobs j on j.run_id = r.id where r.completed_at >= now() - interval '24 hours' and r.state = 'failed')::int as failed,
  (select count(*) from allrice_runs r join allrice_jobs j on j.run_id = r.id where r.completed_at >= now() - interval '24 hours' and r.state = 'canceled')::int as canceled,
  (select count(*) from allrice_jobs where status = 'dead_letter' and completed_at >= now() - interval '24 hours')::int as dead_letters,
  (select count(*) from allrice_runs where state = 'running')::int as running,
  (select count(*) from allrice_runs where state = 'waiting_approval')::int as waiting,
  (select count(*) from allrice_runtime_operations where snapshot->>'status' = 'unknown')::int as unknown_ops,
  (select count(*) from allrice_automations where clock_owner in ('native_once', 'native_recurring') and status = 'enabled' and deleted_at is null)::int as schedules"""


