class CheckError(Exception):
    pass


class RoundTimeout(BaseException):  # not an Exception: a check must not swallow it
    pass


def expand(path):
    return os.path.expanduser(path) if isinstance(path, str) else path


def run(cmd, timeout=20, env=None, stdin=None):
    """(exit code, stdout, stderr); 124 on timeout, 127 when it cannot start."""
    full = dict(os.environ, PATH=SYS_PATH)
    full.update(env or {})
    try:
        kw = {'input': stdin} if stdin is not None else {'stdin': subprocess.DEVNULL}
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=full, **kw)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, '', 'timed out after %ss' % timeout
    except OSError as err:
        return 127, '', str(err)


def opener(proxy):
    """None: urllib's own choice (macOS system proxy settings); "": direct; else that proxy."""
    if proxy is None:
        return urllib.request.build_opener()
    return urllib.request.build_opener(urllib.request.ProxyHandler({'http': proxy, 'https': proxy} if proxy else {}))


LOCAL = opener('')


def http_get(url, timeout=10, via=LOCAL):
    """(status or None, body bytes or error text)."""
    try:
        with via.open(urllib.request.Request(url, headers={'User-Agent': 'allrice-monitor'}), timeout=timeout) as r:
            return r.status, r.read(4_000_000)
    except urllib.error.HTTPError as err:
        return err.code, (err.read(65536) if err.fp else b'')
    except Exception as err:  # URLError, timeouts, resets: all mean "not reachable"
        return None, str(getattr(err, 'reason', err)).encode()


def short(text, limit=300):
    text = text.decode('utf-8', 'replace') if isinstance(text, bytes) else str(text)
    text = ' '.join(text.split())
    return text if len(text) <= limit else text[: limit - 1] + '…'


def ago(seconds):
    seconds = max(0, int(seconds))
    if seconds < 3600:
        return '%d 分钟' % max(1, seconds // 60)
    if seconds < 172800:
        return '%.1f 小时' % (seconds / 3600)
    return '%d 天' % (seconds // 86400)


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, value):
    tmp = '%s.%d.tmp' % (path, os.getpid())
    with open(tmp, 'w') as f:
        json.dump(value, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def load_config(path, peer):
    cfg = json.loads(json.dumps(PEER if peer else M1))
    if path is None:
        candidate = os.path.join(expand(cfg['stateDir']), 'config.json')
        path = candidate if os.path.exists(candidate) else None
    if path:
        with open(expand(path)) as f:
            for k, v in json.load(f).items():
                cfg[k] = dict(cfg[k], **v) if isinstance(cfg.get(k), dict) and isinstance(v, dict) else v
    cfg['configFile'] = expand(path) if path else None
    cfg['stateDir'] = expand(cfg['stateDir'])
    cfg['telegramEnv'] = expand(cfg['telegramEnv'] or os.path.join(cfg['stateDir'], 'telegram.env'))
    return cfg


def plist_of(path):
    try:
        with open(expand(path), 'rb') as f:
            return plistlib.load(f)
    except (OSError, plistlib.InvalidFileException, ValueError):
        return None


def env_file(path):
    out = {}
    try:
        with open(expand(path)) as f:
            for line in f:
                m = re.match(r'\s*([A-Za-z_][A-Za-z0-9_]*)=(.*)$', line)
                if m:
                    out[m.group(1)] = m.group(2).strip().strip('"\'')
    except OSError:
        pass
    return out


def derive_m1(cfg):
    """Fill what was left empty from the shared-Dev launchd files and .env."""
    web, worker = plist_of(cfg['webPlist']), plist_of(cfg['workerPlist'])
    wenv = (web or {}).get('EnvironmentVariables', {})
    kenv = (worker or {}).get('EnvironmentVariables', {})
    dotenv = env_file(cfg['envFile'])
    fill = {
        'webLabel': (web or {}).get('Label'),
        'workerLabel': (worker or {}).get('Label'),
        'databaseUrl': kenv.get('DATABASE_URL') or dotenv.get('DATABASE_URL'),
        'webUrl': 'http://127.0.0.1:%s' % wenv['ALLRICE_WEB_PORT'] if wenv.get('ALLRICE_WEB_PORT') else None,
        'workerUrl': 'http://127.0.0.1:%s' % kenv['ALLRICE_WORKER_PORT'] if kenv.get('ALLRICE_WORKER_PORT') else None,
        'publicUrl': wenv.get('ALLRICE_PUBLIC_URL') or dotenv.get('ALLRICE_PUBLIC_URL'),
    }
    for k, v in fill.items():
        if cfg.get(k) is None:
            cfg[k] = v
    if cfg.get('incidentDatabaseUrl') is None:
        cfg['incidentDatabaseUrl'] = cfg['databaseUrl']
    return cfg


def finding(key, severity, title, detail='', runbook='', step=''):
    return {'key': key, 'severity': severity, 'title': title, 'detail': detail, 'runbook': runbook, 'step': step}


def unknown(key, title=''):
    """A key the check cannot judge this round (no evidence either way): an open alert
    stays open and nothing new opens."""
    return finding(key, 'unknown', title)


class Round:
    """One round: its config, the persistent state and what the checks learned. Only a
    real round, holding the lock, moves a corrupt state file aside (recover=True); a dry
    run or another command reads it as empty and leaves it for that round to report."""

    def __init__(self, cfg, peer=False, recover=False):
        self.cfg, self.peer, self.now = cfg, peer, time.time()
        os.makedirs(cfg['stateDir'], mode=0o700, exist_ok=True)
        self.state_file = os.path.join(cfg['stateDir'], 'state.json')
        self.state, self.state_lost = {}, None
        if os.path.exists(self.state_file):
            try:
                with open(self.state_file) as f:
                    self.state = json.load(f)
            except (OSError, ValueError):
                if recover:  # keep the unreadable file for a person, and say so
                    self.state_lost = '%s.corrupt-%d' % (self.state_file, self.now)
                    os.replace(self.state_file, self.state_lost)
                    self.state = {'stateLost': self.state_lost}
        self.facts, self.progress = {}, None

    def save(self):
        write_json(self.state_file, self.state)

    def psql(self, sql, url=None, variables=None, timeout=30, readonly=True):
        return psql(self.cfg, sql, url, variables, timeout, readonly)


def psql(cfg, sql, url=None, variables=None, timeout=30, readonly=True):
    """Run SQL (on stdin, so :'var' variables work) and return its output."""
    if not url:
        raise CheckError('no database URL configured')
    parts, env = urllib.parse.urlsplit(url), {}
    if parts.password:  # keep it out of `ps`
        env['PGPASSWORD'] = urllib.parse.unquote(parts.password)
        host = parts.hostname + (':%d' % parts.port if parts.port else '')
        url = urllib.parse.urlunsplit(parts._replace(netloc='%s@%s' % (parts.username, host) if parts.username else host))
    cmd = [cfg['psql'], url, '-X', '-q', '-A', '-t', '-v', 'ON_ERROR_STOP=1']
    for k, v in (variables or {}).items():
        cmd += ['-v', '%s=%s' % (k, v)]
    opts = '-c statement_timeout=15000' + (' -c default_transaction_read_only=on' if readonly else '')
    env.update(PGCONNECT_TIMEOUT='5', PGAPPNAME='allrice-monitor', PGOPTIONS=opts)
    rc, out, err = run(cmd, timeout, env, sql)
    if rc:
        raise CheckError(short(err or 'psql exit %d' % rc))
    return out.strip()


# ---------- alert state machine ----------


def evaluate(r, findings, ran=()):
    """Apply one round of findings to the open alerts. Returns the events to notify.
    `ran` names the checks that completed: an open per-item alert of one of them
    ("disk:<path>") whose item it no longer reports (the item left the config) recovers."""
    now, cfg = r.now, r.cfg
    alerts = r.state.setdefault('alerts', {})
    opens = r.state.setdefault('opens', {})
    history = r.state.setdefault('history', [])
    events = []
    reported = {f['key'] for f in findings}
    findings = list(findings) + [finding(k, 'ok', a['title']) for k, a in alerts.items()
                                 if ':' in k and k.split(':', 1)[0] in ran and k not in reported]
    for f in findings:
        key, sev, cur = f['key'], f['severity'], alerts.get(f['key'])
        if sev == 'unknown':
            continue
        if sev == 'ok':
            if cur:
                del alerts[key]
                muted = cur.get('mutedUntil', 0) > now
                events.append({'event': 'recovered', 'finding': f, 'alert': cur, 'silent': muted})
                history.append({'at': now, 'event': 'recovered', 'key': key, 'title': cur['title']})
                incident(r, 'monitor_recovered', 'info', f, cur, event='recovered')
                if muted:  # told once the mute ends, if it is still good then
                    r.state.setdefault('mutedRecoveries', {})[key] = {'title': cur['title'], 'since': cur['since']}
            continue
        if not cur:
            recent = [t for t in opens.get(key, []) if now - t < cfg['flapMinutes'] * 60] + [now]
            opens[key] = recent
            muted_until = r.state.get('muted', {}).get(key, {}).get('mutedUntil', 0)
            cur = alerts[key] = dict(f, since=now, notifiedAt=now, notifiedSeverity=sev, incidentId=str(uuid.uuid4()))
            r.state.get('mutedRecoveries', {}).pop(key, None)
            event = 'opened'
            if muted_until > now:
                cur.update(mutedUntil=muted_until, silentOpen=True)
            elif len(recent) >= cfg['flapLimit']:
                cur['mutedUntil'] = now + cfg['flapMinutes'] * 60
                r.state.setdefault('muted', {})[key] = {'mutedUntil': cur['mutedUntil']}
                event = 'flapping'
            events.append({'event': event, 'finding': f, 'alert': cur, 'silent': muted_until > now})
            history.append({'at': now, 'event': 'opened', 'key': key, 'severity': sev, 'title': f['title']})
            incident(r, 'monitor_alert', sev, f, cur, cur['incidentId'], event=event)
            continue
        escalated = RANK[sev] > RANK[cur['notifiedSeverity']]  # only above the highest already sent
        since, inc, notified, muted = cur['since'], cur['incidentId'], cur['notifiedAt'], cur.get('mutedUntil', 0)
        cur.update(f, since=since, incidentId=inc)
        if escalated:
            cur.update(notifiedAt=now, notifiedSeverity=sev, silentOpen=False, mutedUntil=0)  # told: no longer muted
            r.state.get('muted', {}).pop(key, None)
            events.append({'event': 'escalated', 'finding': f, 'alert': cur, 'silent': False})
            incident(r, 'monitor_alert', sev, f, cur, event='escalated')
        elif muted > now and cur.get('silentOpen') and now - since >= cfg['flapBreakMinutes'] * 60:
            # Opened during a flapping mute and still bad: no longer a flap, an outage.
            cur.update(notifiedAt=now, notifiedSeverity=max(sev, cur['notifiedSeverity'], key=RANK.get), silentOpen=False, mutedUntil=0)
            r.state.get('muted', {}).pop(key, None)
            events.append({'event': 'reminder', 'finding': f, 'alert': cur, 'silent': False})
            incident(r, 'monitor_alert', sev, f, cur, event='reminder')
        elif muted <= now and (cur.get('silentOpen') or now - notified >= cfg['repeatMinutes'][sev] * 60):
            cur.update(notifiedAt=now, notifiedSeverity=max(sev, cur['notifiedSeverity'], key=RANK.get), silentOpen=False)
            events.append({'event': 'reminder', 'finding': f, 'alert': cur, 'silent': False})
            incident(r, 'monitor_alert', sev, f, cur, event='reminder')
    for key in list(r.state.get('muted', {})):
        if r.state['muted'][key]['mutedUntil'] <= now:
            del r.state['muted'][key]
            gone = r.state.get('mutedRecoveries', {}).pop(key, None)
            if gone and key not in alerts:
                events.append({'event': 'recovered', 'finding': finding(key, 'ok', gone['title']), 'alert': gone, 'silent': False})
    for key in list(opens):
        opens[key] = [t for t in opens[key] if now - t < cfg['flapMinutes'] * 60]
        if not opens[key]:
            del opens[key]
    r.state['history'] = [h for h in history if now - h['at'] < 8 * 86400]
    return events


MESSAGE_LIMIT = 3500  # characters; Telegram allows 4096 UTF-16 units per message


def compose(r, events):
    """The messages for one round: everything that changed, split between alerts, never
    inside one, so a long round cannot cut the later alerts off."""
    cfg, now = r.cfg, r.now
    shown = [e for e in events if not e['silent']]
    if not shown:
        return []
    bad = sorted([e for e in shown if e['event'] != 'recovered'], key=lambda e: -RANK[e['finding']['severity']])
    good = [e for e in shown if e['event'] == 'recovered']
    worst = max([RANK[e['finding']['severity']] for e in bad] or [0])
    icon = ICON['critical'] if worst == 2 else ICON['warning'] if worst == 1 else ICON['ok']
    parts = (['%d 项告警' % len(bad)] if bad else []) + (['%d 项恢复' % len(good)] if good else [])
    head = '%s %s%s：%s' % (icon, '[%s] ' % cfg['label'] if cfg['label'] else '', cfg['name'], '，'.join(parts))
    blocks = []
    for e in bad:
        f, a = e['finding'], e['alert']
        tag = {'opened': '', 'escalated': '（升级）', 'reminder': '（仍未恢复，已 %s）' % ago(now - a['since']),
               'flapping': '（1 小时内反复 %d 次，之后 1 小时不再逐条通知）' % cfg['flapLimit']}[e['event']]
        lines = ['%s [%s] %s%s' % (ICON[f['severity']], WORD[f['severity']], f['title'], tag)]
        if f['detail']:
            lines.append('   ' + short(f['detail'], 800))
        if f['step']:
            lines.append('   第一步：' + f['step'])
        if f['runbook']:
            lines.append('   手册：' + cfg['runbooks'] + f['runbook'])
        blocks.append('\n'.join(lines))
    blocks += ['✅ 已恢复：%s（持续 %s）' % (e['alert']['title'], ago(now - e['alert']['since'])) for e in good]
    foot = time.strftime('%m-%d %H:%M', time.localtime(now)) + ' · ' + socket.gethostname().split('.')[0]
    messages, cur = [], []
    for b in blocks:
        if cur and len('\n\n'.join(cur + [b])) > MESSAGE_LIMIT:
            messages.append(cur)
            cur = []
        cur.append(b)
    messages.append(cur)
    n = len(messages)
    return ['\n\n'.join([head + ('（%d/%d）' % (i + 1, n) if n > 1 else '')] + m + [foot]) for i, m in enumerate(messages)]


def incident(r, kind, severity, f, alert, incident_id=None, event=None):
    if not r.cfg.get('incidents'):
        return
    r.state.setdefault('incidentOutbox', []).append({
        'id': incident_id or str(uuid.uuid4()), 'kind': kind, 'severity': severity,
        'detailCode': 'monitor.' + f['key'], 'createdAt': time.strftime('%Y-%m-%dT%H:%M:%S%z', time.localtime(r.now)),
        'metadata': {'source': 'allrice-monitor', 'monitor': r.cfg['name'], 'label': r.cfg['label'], 'host': socket.gethostname(),
                     'event': event, 'title': alert['title'], 'detail': f['detail'] or alert.get('detail', ''),
                     'runbook': alert.get('runbook', ''), 'alertId': alert['incidentId'], 'since': int(alert['since']),
                     'durationSeconds': int(r.now - alert['since'])},
    })


INSERT_INCIDENTS = """
insert into allrice_operational_incidents (id, kind, severity, detail_code, metadata, created_at)
select (i->>'id')::uuid, i->>'kind', i->>'severity', i->>'detailCode', i->'metadata', (i->>'createdAt')::timestamptz
from jsonb_array_elements(:'rows'::jsonb) i
on conflict (id) do nothing;
"""


def flush_incidents(r):
    """Write queued incidents; on failure keep them (bounded) for the next round."""
    box = r.state.get('incidentOutbox', [])
    if len(box) > 200:
        r.state['incidentDropped'] = r.state.get('incidentDropped', 0) + len(box) - 200
        box = box[-200:]
    r.state['incidentOutbox'] = box
    if not box:
        return
    try:
        r.psql(INSERT_INCIDENTS, r.cfg['incidentDatabaseUrl'], {'rows': json.dumps(box, ensure_ascii=False)}, readonly=False)
        r.state['incidentOutbox'] = []
        r.state['incidentError'] = None
    except CheckError as err:
        r.state['incidentError'] = {'at': r.now, 'error': str(err)}
        r.state.setdefault('incidentFailingSince', r.now)
    else:
        r.state.pop('incidentFailingSince', None)


def flush_incidents_remote(r):
    """The huihuimac side has no database: its incidents go to M1's table through the
    monitor installed there (`monitor ingest-incidents`), as soon as M1 answers again."""
    box = r.state.get('incidentOutbox', [])
    if len(box) > 200:
        r.state['incidentDropped'] = r.state.get('incidentDropped', 0) + len(box) - 200
        box = box[-200:]
    r.state['incidentOutbox'] = box
    if not box:
        return
    cmd = '/usr/bin/python3 %s ingest-incidents' % shlex.quote(r.cfg['m1Monitor'])
    if r.cfg.get('m1MonitorConfig'):
        cmd += ' --config ' + shlex.quote(r.cfg['m1MonitorConfig'])
    rc, _, err = run(['/usr/bin/ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', r.cfg['m1Ssh'], cmd], 60,
                     stdin=json.dumps(box, ensure_ascii=False))
    if rc:
        r.state['incidentError'] = {'at': r.now, 'error': 'ingest on %s failed (exit %d): %s' % (r.cfg['m1Ssh'], rc, short(err, 200))}
        r.state.setdefault('incidentFailingSince', r.now)
    else:
        r.state['incidentOutbox'], r.state['incidentError'] = [], None
        r.state.pop('incidentFailingSince', None)


def ingest_incidents(cfg, stream):
    """`monitor ingest-incidents`: write incidents another monitor sends on stdin."""
    rows = json.load(stream)
    ok = isinstance(rows, list) and all(
        isinstance(i, dict) and i.get('kind') in ('monitor_alert', 'monitor_recovered') and str(i.get('detailCode', '')).startswith('monitor.')
        and isinstance(i.get('metadata'), dict) and re.match(r'^[0-9a-f-]{36}$', str(i.get('id', ''))) for i in rows)
    if not ok:
        sys.exit('ingest-incidents: expected a JSON list of monitor incidents')
    psql(cfg, INSERT_INCIDENTS, cfg['incidentDatabaseUrl'], {'rows': json.dumps(rows, ensure_ascii=False)}, readonly=False)
    print('ingested %d' % len(rows))


# ---------- Telegram ----------


def telegram_secrets(cfg):
    env = env_file(cfg['telegramEnv'])
    return env.get('TELEGRAM_BOT_TOKEN'), env.get('TELEGRAM_CHAT_ID')


def send_telegram(cfg, text):
    """Send one message. With the default (system proxy settings) a failure is retried
    once directly, so a dead local proxy does not silence the alerts."""
    token, chat = telegram_secrets(cfg)
    if not token or not chat:
        raise CheckError('Telegram is not configured (%s)' % cfg['telegramEnv'])
    data = urllib.parse.urlencode({'chat_id': chat, 'text': text[:4090], 'disable_web_page_preview': 'true'}).encode()
    routes = [cfg['telegramProxy']] + ([''] if cfg['telegramProxy'] is None else [])
    for proxy in routes:
        try:
            with opener(proxy).open('https://api.telegram.org/bot%s/sendMessage' % token, data, timeout=20) as resp:
                body = json.load(resp)
        except urllib.error.HTTPError as err:
            body = {'ok': False, 'description': 'HTTP %s %s' % (err.code, short(err.read(2000) if err.fp else b''))}
            break  # Telegram answered: another route will not help
        except Exception as err:
            body = {'ok': False, 'description': short(getattr(err, 'reason', err))}
            continue
        if body.get('ok') or body.get('error_code'):
            break
    if not body.get('ok'):
        raise CheckError(str(body.get('description', 'send failed')).replace(token, '<token>'))


def deliver(r, messages):
    """Queue the messages and send everything queued, oldest first; what fails waits for
    the next round. `failingSince` (in the heartbeat) lets the other machine tell a
    monitor that has stopped being able to deliver."""
    box = r.state.setdefault('outbox', [])
    tg = r.state.setdefault('telegram', {})
    box.extend(m for m in ([messages] if isinstance(messages, str) else messages or []) if m)
    if len(box) > 20:
        tg['dropped'] = tg.get('dropped', 0) + len(box) - 20
        del box[:-20]
    while box:
        note = '（另有 %d 条更早的通知没能发出，已丢弃）\n' % tg['dropped'] if tg.get('dropped') else ''
        try:
            send_telegram(r.cfg, note + box[0])
        except CheckError as err:
            tg['lastError'] = {'at': r.now, 'error': str(err)}
            tg.setdefault('failingSince', r.now)
            return False
        box.pop(0)
        tg['lastOkAt'], tg['dropped'] = time.time(), 0
        tg.pop('failingSince', None)
        r.save()  # sent is sent: a failure later in the round must not send it again
    return True


# ---------- checks (M1) ----------


def job_info(label):
    """(state, runs, last exit code): state is running/loaded/gone."""
    rc, out, err = run(['/bin/launchctl', 'print', 'gui/%d/%s' % (os.getuid(), label)], 10)
    if rc == 113:
        return 'gone', None, None
    if rc:
        raise CheckError('launchctl print %s failed (exit %d): %s' % (label, rc, short(err)))
    pid = re.search(r'^\s*pid = (\d+)', out, re.M)
    runs = re.search(r'^\s*runs = (\d+)', out, re.M)
    last = re.search(r'^\s*last exit code = (.+)$', out, re.M)
    return ('running' if pid else 'loaded'), int(runs.group(1)) if runs else None, last.group(1).strip() if last else None


def ready(url, timeout=8):
    code, body = http_get(url, timeout)
    if code != 200:
        return None, 'HTTP %s %s' % (code, short(body, 120)) if code else short(body, 160)
    try:
        doc = json.loads(body)
    except ValueError:
        return None, 'not JSON'
    if doc.get('status') != 'ready':
        return None, 'status=%s' % doc.get('status')
    return doc, ''


def lock_holders(path):
    """PIDs that have the lock file open. deploy-dev, scripts/m1/install and `deploy-lock
    run` keep it open exactly while they hold the lock (their children inherit it), so an
    open file means held. Asked with lsof, never by probing the lock: even a brief probe
    could make a deploy that starts at that moment fail as busy."""
    rc, out, _ = run(['/usr/sbin/lsof', '-t', '--', path], 10)
    return out.split() if rc == 0 else []  # 1: nobody; anything else: not known to be held, so judged


def in_grace(r, name, held):
    """True while `held` and for at most deployGraceMinutes from when it was first seen:
    planned work that runs longer is judged like an outage again."""
    seen = r.state.setdefault('deploySeen', {})
    if not held:
        seen.pop(name, None)
        return False
    since = seen.setdefault(name, r.now)
    r.facts['deployingUntil'] = int(since + r.cfg['deployGraceMinutes'] * 60)
    return r.now < r.facts['deployingUntil']


def deploying(r):
    """True while a deploy or other planned work holds the deploy lock (AGENTS.md section 5,
    e.g. a manual restart): Web, Worker, the database and the public entry may be down on
    purpose then, so they are not judged. Asked again by every check and every re-check."""
    return in_grace(r, 'm1', lock_holders(expand(r.cfg['deployLock'])))  # asked afresh: a re-check sees a deploy that just started


def check_deploy(r):
    if not os.path.exists(expand(r.cfg['deployInflight'])) or deploying(r):
        return [finding('deploy', 'ok', '部署中断未恢复')]
    return [finding('deploy', 'critical', '部署中断未恢复', '%s 还在，但没有部署在进行：上一次部署被强行中止，Dev 可能停在半途' % r.cfg['deployInflight'],
                    'm1-worker-crash.md', '~/allrice-dev/bin/deploy-dev --status（恢复由发布负责人 deploy-dev --release-manager --recover）')]


def check_service(r, role):
    label, base = r.cfg[role + 'Label'], r.cfg[role + 'Url']
    if deploying(r):
        return None
    path = '/api/health/ready' if role == 'web' else '/health/ready'
    title = 'Web 不可用' if role == 'web' else 'Worker 不可用'
    step = '~/allrice-dev/bin/deploy-dev --status; tail -50 ~/Library/Logs/allrice-dev-%s.err.log' % role
    if not label or not base:
        return [finding(role, 'warning', title + '（读不到配置）', 'launchd 文件 %s 缺失或不完整' % r.cfg[role + 'Plist'], 'm1-worker-crash.md', step)]
    state, _, last = job_info(label)
    doc, why = ready(base + path)
    if doc:
        r.facts[role] = doc
        return [finding(role, 'ok', title)]
    detail = 'launchd %s（%s）；%s%s 返回 %s' % (label, {'gone': '未加载', 'loaded': '已加载但没有进程', 'running': '进程在'}[state],
                                              base, path, why)
    if last and last != '(never exited)':
        detail += '；上次退出码 %s' % last
    return [finding(role, 'critical', title, detail, 'm1-worker-crash.md', step)]


def check_web(r):
    return check_service(r, 'web')


def check_worker(r):
    return check_service(r, 'worker')


def check_postgres(r):
    if deploying(r):
        return None
    try:
        r.psql('select 1;', r.cfg['databaseUrl'])
        return [finding('postgres', 'ok', '数据库不可用')]
    except CheckError as err:
        return [finding('postgres', 'critical', '数据库不可用', str(err), 'm1-database.md',
                        '/opt/homebrew/bin/pg_isready -h 127.0.0.1; /opt/homebrew/bin/brew services list | grep postgres')]


def probe_public(r, url, key='public_entry', where='M1 本机'):
    if not url:
        return [finding(key, 'warning', '公网入口不可达（未配置地址）', '', 'm1-tunnel.md', '')]
    start = time.time()
    code, body = http_get(url, 15, opener(r.cfg.get('publicProxy')))
    took = time.time() - start
    ok = code == 200 and took < 15
    return [finding(key, 'ok' if ok else 'critical', '公网入口不可达', '从%s访问 %s：%s（%.1f 秒）' % (where, url, code or short(body, 120), took),
                    'm1-tunnel.md', 'curl -sS -o /dev/null -w "%%{http_code}\\n" %s' % url)]


def read_remote_heartbeat(target, path, lock=None):
    """(heartbeat dict or None, error text, ssh reachable, lock holders or None)."""
    cmd = 'cat -- %s' % shlex.quote(path)
    if lock:
        cmd = 'printf "%%s\\n" "$(cat -- %s 2>&1)"; echo "@@lock $(/usr/sbin/lsof -t -- %s 2>/dev/null | tr "\\n" " ")"' % (
            shlex.quote(path), shlex.quote(lock))
    rc, out, err = run(['/usr/bin/ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', target, cmd], 30)
    if rc == 255 or rc == 124:
        return None, 'SSH 连不上 %s：%s' % (target, short(err, 160)), False, None
    holders = None
    if lock:
        body, _, tail = out.rpartition('@@lock')
        out, holders = body, tail.split()
    if rc:
        return None, '读不到 %s:%s（退出码 %d）：%s' % (target, path, rc, short(err, 120)), True, holders
    try:
        return json.loads(out), '', True, holders
    except ValueError:
        return None, '读不到 %s:%s：%s' % (target, path, short(out, 120)), True, holders


def judge_heartbeat(r, hb, keys, titles, stale, unfinished, stuck, severity, runbook, step):
    """Findings about the other machine's monitor from its heartbeat, the same in both
    directions: it is being started (`at`), its rounds finish (`unfinishedSince` is kept
    while rounds start and die), and it can deliver (`telegram.failingSince`)."""
    age, since = r.now - hb.get('at', 0), hb.get('unfinishedSince') if hb.get('phase') == 'running' else None
    if age > stale * 60:
        detail = '心跳已 %s 没更新（上限 %d 分钟）：监控没在运行或卡住了' % (ago(age), stale)
    elif since and r.now - since > unfinished * 60:
        detail = '每轮都开始了，但已 %s 没有一轮跑完（上限 %d 分钟）：监控每轮都在出错' % (ago(r.now - since), unfinished)
    else:
        detail = ''
    tg, tg_detail = hb.get('telegram') or {}, ''
    if not tg.get('configured'):
        tg_detail = '没有配置 telegram.env'
    elif tg.get('pending') and tg.get('failingSince') and r.now - tg['failingSince'] > stuck * 60:
        tg_detail = '已 %s 发不出去，积压 %s 条：%s；它那边未恢复的告警：%s' % (
            ago(r.now - tg['failingSince']), tg.get('pending'), (tg.get('lastError') or {}).get('error', ''),
            '、'.join('%s(%s)' % kv for kv in sorted((hb.get('openAlerts') or {}).items())) or '无')
    return [finding(keys[0], severity if detail else 'ok', titles[0], detail, runbook, step),
            finding(keys[1], 'warning' if tg_detail else 'ok', titles[1], tg_detail, runbook, step)]


def check_peer(r):
    """The huihuimac watchdog: without it nobody would notice M1 itself going down."""
    hb, err, _, _ = read_remote_heartbeat(r.cfg['peerSsh'], r.cfg['peerHeartbeat'])
    step = 'ssh %s "launchctl print gui/\\$(id -u)/ai.bplabs.allrice-monitor-peer | head -20"' % r.cfg['peerSsh']
    if not hb:
        return [finding('peer', 'warning', 'huihuimac 看门失效', err + '；M1 整机故障时将没人报警', 'm1-monitor.md', step)]
    r.facts['peer'] = hb
    return judge_heartbeat(r, hb, ('peer', 'peer_telegram'), ('huihuimac 看门失效', 'huihuimac 看门发不出 Telegram'), r.cfg['peerStaleMinutes'],
                           r.cfg['peerUnfinishedMinutes'], r.cfg['peerTelegramStuckMinutes'], 'warning', 'm1-monitor.md', step)


def check_monitor(r):
    """The monitor's own delivery: alerts that cannot reach the incidents table."""
    since, dropped = r.state.get('incidentFailingSince'), r.state.get('incidentDropped', 0)
    if not since or r.now - since < 1800:
        return [finding('monitor', 'ok', '告警写不进事件表')]
    err = (r.state.get('incidentError') or {}).get('error', '')
    return [finding('monitor', 'warning', '告警写不进事件表', '已 %s，积压 %d 条%s：%s' % (
        ago(r.now - since), len(r.state.get('incidentOutbox', [])), '（另有 %d 条超出上限已丢弃）' % dropped if dropped else '', err),
        'm1-monitor.md', 'monitor status')]


# name, function, re-run once before alerting, skip unless this earlier check is ok
M1_CHECKS = [
    ('postgres', check_postgres, True, None),
    ('web', check_web, True, None),
    ('worker', check_worker, True, None),
    ('deploy', check_deploy, False, None),
    ('peer', check_peer, True, None),
    ('monitor', check_monitor, False, None),
]


def run_checks(r, checks):
    """Run the checks; (findings, names of the checks that judged this round). A check
    returns None when it cannot judge (what it needs is down): its alerts stay as they
    are, because unknown is not "recovered". A check that fails itself raises an alert of
    its own ("check:<name>"), which recovers once it runs cleanly again. Progress lives on
    the round, so a round that times out still reports what it found (collect_checks)."""
    wanted = r.cfg['checks']
    checks = [c for c in checks if (wanted is None or c[0] in wanted) and c[0] not in r.cfg['skipChecks']]
    p = r.progress = {'checks': checks, 'results': {}, 'errors': {}, 'current': None}
    results, errors = p['results'], p['errors']

    def one(name, fn):
        p['current'] = name
        try:
            results[name], errors[name] = fn(r), None
        except Exception as err:  # a bug in one check must not stop the others or the round
            results[name] = None
            text = str(err) if isinstance(err, CheckError) else '%s: %s' % (type(err).__name__, short(err, 200))
            errors[name] = finding('check:' + name, 'warning', '检查 %s 本身出错' % name, text, 'm1-monitor.md', 'monitor status')
        p['current'] = None

    def bad(name):
        return errors.get(name) or any(f['severity'] != 'ok' for f in results.get(name) or [])

    for name, fn, _, needs in checks:
        if needs in results and (results[needs] is None or bad(needs)):
            continue  # what it needs is down or unknown
        one(name, fn)
    again = [c for c in checks if c[2] and c[0] in results and bad(c[0])]
    if again:
        time.sleep(r.cfg['confirmSeconds'])
        for name, fn, _, _ in again:
            one(name, fn)
    return collect_checks(r)


def collect_checks(r):
    p = r.progress
    out = []
    for name, _, _, _ in p['checks']:
        if name in p['errors']:
            out.append(p['errors'][name] or finding('check:' + name, 'ok', '检查 %s 本身出错' % name))
            out += p['results'][name] or []
    return out, {name for name, res in p['results'].items() if res is not None}


# ---------- rounds ----------


def hb_tools():
    """The installed commit (TOOLS_VERSION next to this file), 'source' when run from a checkout."""
    try:
        with open(os.path.join(HERE, 'TOOLS_VERSION')) as f:
            return f.read().split()[0]
    except (OSError, IndexError):
        return 'source'


def heartbeat(r, took, error=None, phase='done'):
    """Written when a round starts and when it ends. `at` shows the monitor is being
    started; `unfinishedSince` is carried over from round to round while none of them
    finishes (a monitor that starts and dies every time); `telegram.failingSince` shows
    since when it cannot deliver."""
    path = os.path.join(r.cfg['stateDir'], 'heartbeat.json')
    prev = read_json(path, {})
    unfinished = None
    if phase == 'running':
        unfinished = (prev.get('unfinishedSince') if prev.get('phase') == 'running' else None) or int(time.time())
    tg = r.state.get('telegram', {})
    token, chat = telegram_secrets(r.cfg)
    tools = hb_tools()
    write_json(path, {
        'at': int(time.time()), 'phase': phase, 'unfinishedSince': unfinished, 'lastDoneAt': (r.state.get('lastRound') or {}).get('at'),
        'host': socket.gethostname(), 'name': r.cfg['name'], 'label': r.cfg['label'], 'tools': tools,
        'roundSeconds': round(took, 1), 'roundError': error, 'publicUrl': r.cfg.get('publicUrl'),
        'openAlerts': {k: a['severity'] for k, a in r.state.get('alerts', {}).items()},
        'telegram': {'configured': bool(token and chat), 'lastOkAt': tg.get('lastOkAt'), 'failingSince': tg.get('failingSince'),
                     'pending': len(r.state.get('outbox', [])), 'lastError': tg.get('lastError')},
        'incidents': {'pending': len(r.state.get('incidentOutbox', [])), 'lastError': r.state.get('incidentError')},
    })


def locked(cfg, wait=0):
    """One round at a time per state directory; launchd never overlaps a job with itself,
    this covers a manual run. Exits quietly when busy (after `wait` seconds)."""
    f = open(os.path.join(cfg['stateDir'], 'monitor.lock'), 'a')
    end = time.time() + wait
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            if time.time() >= end:
                print('monitor: a round in %s is still running' % cfg['stateDir'], file=sys.stderr)
                sys.exit(0)
            time.sleep(1)


def on_alarm(signum, frame):
    raise RoundTimeout()


def do_round(cfg, peer):
    lock = locked(cfg)
    r = Round(cfg, peer, recover=True)
    start, error = time.time(), None
    heartbeat(r, 0, phase='running')
    signal.signal(signal.SIGALRM, on_alarm)
    signal.alarm(cfg['roundTimeoutSeconds'])
    try:
        findings, ran = run_checks(r, PEER_CHECKS if peer else M1_CHECKS)
        findings.append(finding('monitor_round', 'ok', '监控本轮超时'))
    except RoundTimeout:
        # Keep what the finished checks found; only the stuck one stays unknown.
        stuck = (r.progress or {}).get('current') or '?'
        error = 'round timed out after %ss in check %s' % (cfg['roundTimeoutSeconds'], stuck)
        findings, ran = collect_checks(r) if r.progress else ([], set())
        findings.append(finding('monitor_round', 'critical', '监控本轮超时', '检查 %s 卡住，%s 秒没跑完；其余检查的结果照常报告' % (
            stuck, cfg['roundTimeoutSeconds']), 'm1-monitor.md', 'monitor status'))
    lost = r.state.pop('stateLost', None)
    findings.append(finding('monitor_state', 'warning' if lost else 'ok', '监控状态文件损坏',
                            '读不出来，已另存为 %s；之前的待发通知和告警状态丢了，已有的故障会重新报一次' % lost,
                            'm1-monitor.md', 'monitor status'))
    signal.alarm(90)  # delivery has its own timeouts; this only bounds a hung write
    try:
        r.now = time.time()
        events = evaluate(r, findings, ran)
        if peer:
            flush_incidents_remote(r)
        else:
            flush_incidents(r)
        deliver(r, compose(r, events))
        r.state['lastRound'] = {'at': r.now, 'seconds': round(time.time() - start, 1), 'error': error}
        r.state['rounds'] = [t for t in r.state.get('rounds', []) if r.now - t < 86400] + [r.now]
        r.save()
        heartbeat(r, time.time() - start, error)
    except RoundTimeout:
        r.save()
        sys.exit('monitor: delivering the round timed out')
    finally:
        signal.alarm(0)
        lock.close()


# ---------- peer (huihuimac) ----------


def check_m1(r):
    """M1 answers over SSH, its monitor runs, finishes its rounds and can deliver. While M1
    cannot be reached only m1_reachable is judged: its heartbeat is unknown, not stale."""
    cfg = r.cfg
    hb, err, reachable, holders = read_remote_heartbeat(cfg['m1Ssh'], cfg['m1Heartbeat'], cfg['m1DeployLock'])
    step = 'ssh %s "~/allrice-dev/bin/monitor status"' % cfg['m1Ssh']
    out = [finding('m1_reachable', 'ok' if reachable else 'critical', 'M1 连不上', err + '（整机宕机、断网或 Tailscale 断开）',
                   'm1-monitor.md', 'tailscale status; ssh -v %s true' % cfg['m1Ssh'])]
    if not reachable:
        return out
    r.facts['m1Deploying'] = in_grace(r, 'm1', bool(holders))
    if not hb:
        return out + [finding('m1_heartbeat', 'critical', 'M1 监控停了', err, 'm1-monitor.md', step)]
    if hb.get('publicUrl'):
        r.state['m1PublicUrl'] = hb['publicUrl']
    return out + judge_heartbeat(r, hb, ('m1_heartbeat', 'm1_telegram'), ('M1 监控停了', 'M1 监控发不出 Telegram'), cfg['m1StaleMinutes'],
                                 cfg['m1UnfinishedMinutes'], cfg['m1TelegramStuckMinutes'], 'critical', 'm1-monitor.md', step)


def check_outside(r):
    """From outside M1. A failure is checked against M1's deploy lock asked right then,
    so a deploy that starts or ends during the round is seen as it is."""
    out = probe_public(r, r.cfg['publicUrl'] or r.state.get('m1PublicUrl'), 'public_entry', ' M1 之外（huihuimac）')
    if out[0]['severity'] != 'ok':
        _, _, reachable, holders = read_remote_heartbeat(r.cfg['m1Ssh'], r.cfg['m1Heartbeat'], r.cfg['m1DeployLock'])
        if reachable and in_grace(r, 'm1', bool(holders)):
            return None  # a deploy on M1 stops Web on purpose
    return out


PEER_CHECKS = [
    ('m1', check_m1, True, None),
    ('public_entry', check_outside, True, None),
    ('monitor', check_monitor, False, None),
]


# ---------- launchd ----------


def launchd(cfg, action, peer):
    label = cfg['launchdLabel'] or ('ai.bplabs.allrice-monitor-peer' if peer else 'ai.bplabs.allrice-dev-monitor')
    path = expand('~/Library/LaunchAgents/%s.plist' % label)
    domain = 'gui/%d' % os.getuid()
    run(['/bin/launchctl', 'bootout', '%s/%s' % (domain, label)], 30)
    for _ in range(90):  # bootout is asynchronous; bootstrap fails while the old job is still there
        if run(['/bin/launchctl', 'print', '%s/%s' % (domain, label)], 10)[0] == 113:
            break
        time.sleep(1)
    if action == 'remove':
        if os.path.exists(path):
            os.remove(path)
        print('removed %s' % label)
        return
    args = ['/usr/bin/python3', os.path.abspath(sys.argv[0]), 'peer' if peer else 'run']
    if cfg['configFile']:
        args += ['--config', cfg['configFile']]
    log = os.path.join(cfg['stateDir'], 'monitor.log')
    with open(path + '.tmp', 'wb') as f:
        plistlib.dump({'Label': label, 'ProgramArguments': args, 'StartInterval': cfg['intervalSeconds'], 'RunAtLoad': True,
                       'StandardOutPath': log, 'StandardErrorPath': log}, f)
    os.replace(path + '.tmp', path)
    for _ in range(5):
        if run(['/bin/launchctl', 'bootstrap', domain, path], 30)[0] == 0:
            print('installed %s: every %ss, %s' % (label, cfg['intervalSeconds'], ' '.join(args)))
            return
        time.sleep(3)
    sys.exit('could not load %s' % label)


def status(cfg):
    state = read_json(os.path.join(cfg['stateDir'], 'state.json'), {})
    hb = read_json(os.path.join(cfg['stateDir'], 'heartbeat.json'), {})
    print(json.dumps({'name': cfg['name'], 'stateDir': cfg['stateDir'], 'lastRound': state.get('lastRound'),
                      'heartbeatAge': int(time.time() - hb['at']) if hb.get('at') else None,
                      'openAlerts': {k: {'severity': a['severity'], 'title': a['title'], 'detail': a['detail'], 'since': time.strftime('%m-%d %H:%M', time.localtime(a['since']))}
                                     for k, a in state.get('alerts', {}).items()},
                      'telegram': hb.get('telegram'), 'incidents': hb.get('incidents'), 'incidentsDropped': state.get('incidentDropped', 0)},
                     ensure_ascii=False, indent=1))


def main(argv):
    p = argparse.ArgumentParser(prog='monitor')
    p.add_argument('command', choices=['run', 'peer', 'status', 'test-alert', 'launchd', 'ingest-incidents'])
    p.add_argument('action', nargs='?', choices=['install', 'remove'])
    p.add_argument('--config')
    p.add_argument('--peer', action='store_true')
    p.add_argument('--dry-run', action='store_true', help='run/peer: print what would be sent; send and store nothing')
    a = p.parse_args(argv)
    peer = a.command == 'peer' or a.peer
    cfg = load_config(a.config, peer)
    os.makedirs(cfg['stateDir'], mode=0o700, exist_ok=True)
    if not peer:
        derive_m1(cfg)
    if a.command in ('run', 'peer') and a.dry_run:
        r = Round(cfg, peer)
        findings, ran = run_checks(r, PEER_CHECKS if peer else M1_CHECKS)
        for f in findings:
            print('%-8s %-28s %s %s' % (f['severity'], f['key'], f['title'] if f['severity'] != 'ok' else '', f['detail'] if f['severity'] != 'ok' else ''))
        print('\n\n'.join(compose(r, evaluate(r, findings, ran))) or '(nothing to send)')
    elif a.command in ('run', 'peer'):
        do_round(cfg, peer)
    elif a.command == 'status':
        status(cfg)
    elif a.command == 'ingest-incidents':
        ingest_incidents(cfg, sys.stdin)
    elif a.command == 'test-alert':
        send_telegram(cfg, '🔔 %s%s：告警通道测试 %s' % ('[%s] ' % cfg['label'] if cfg['label'] else '', cfg['name'], time.strftime('%m-%d %H:%M')))
        print('sent')
    elif a.command == 'launchd':
        if not a.action:
            p.error('launchd needs install or remove')
        launchd(cfg, a.action, peer)


if __name__ == '__main__':
    main(sys.argv[1:])
