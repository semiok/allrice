def check_schedules(r):
    b, row = r.cfg['business'], biz(r, SQL_SCHEDULES)
    if closed(row) or deploying(r):  # a stopped Worker closes its schedule partitions on purpose
        return None
    host_down = row['host_down']
    late = (row['oldest'] or 0) / 60
    sev = 'critical' if host_down or (row['count'] and late >= b['schedule_critical_minutes']) else 'warning' if row['count'] or row['legacy'] else 'ok'
    parts = []
    if row['count']:
        parts.append('%d 个到点未触发（最久晚 %s，%s；例 %s）' % (row['count'], ago(row['oldest'] or 0), '、'.join(row['reasons'] or []), ids(row)))
    if host_down:
        parts.append('定时分区 %s 已关闭或租约过期' % '、'.join(host_down))
    if row['legacy']:
        parts.append('%d 个旧版定时任务仍启用（旧时钟已下线，永远不会触发）' % row['legacy'])
    return [finding('business.overdue_schedules', sev, '定时任务到点未触发', '；'.join(parts), 'm1-schedule-not-fired.md', SQL_STEP % 'SCHEDULES')]


