def flush_incidents(r):
    """Write queued incidents; on failure keep them (bounded) for the next round."""
    box = r.state.get('incidentOutbox', [])
    if len(box) > 200:
        r.state['incidentDropped'] = r.state.get('incidentDropped', 0) + len(box) - 200
        box = box[-200:]
    r.state['incidentOutbox'] = box
    if not box:
        return
    try:
        r.psql(INSERT_INCIDENTS, r.cfg['incidentDatabaseUrl'], {'rows': json.dumps(box, ensure_ascii=False)}, readonly=False)
        r.state['incidentOutbox'] = []
        r.state['incidentError'] = None
    except CheckError as err:
        r.state['incidentError'] = {'at': r.now, 'error': str(err)}
        r.state.setdefault('incidentFailingSince', r.now)
    else:
        r.state.pop('incidentFailingSince', None)


def flush_incidents_remote(r):
    """The huihuimac side has no database: its incidents go to M1's table through the
    monitor installed there (`monitor ingest-incidents`), as soon as M1 answers again."""
    box = r.state.get('incidentOutbox', [])
    if len(box) > 200:
        r.state['incidentDropped'] = r.state.get('incidentDropped', 0) + len(box) - 200
        box = box[-200:]
    r.state['incidentOutbox'] = box
    if not box:
        return
    cmd = '/usr/bin/python3 %s ingest-incidents' % shlex.quote(r.cfg['m1Monitor'])
    if r.cfg.get('m1MonitorConfig'):
        cmd += ' --config ' + shlex.quote(r.cfg['m1MonitorConfig'])
    rc, _, err = run(['/usr/bin/ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', r.cfg['m1Ssh'], cmd], 60,
                     stdin=json.dumps(box, ensure_ascii=False))
    if rc:
        r.state['incidentError'] = {'at': r.now, 'error': 'ingest on %s failed (exit %d): %s' % (r.cfg['m1Ssh'], rc, short(err, 200))}
        r.state.setdefault('incidentFailingSince', r.now)
    else:
        r.state['incidentOutbox'], r.state['incidentError'] = [], None
        r.state.pop('incidentFailingSince', None)


def ingest_incidents(cfg, stream):
    """`monitor ingest-incidents`: write incidents another monitor sends on stdin."""
    rows = json.load(stream)
    ok = isinstance(rows, list) and all(
        isinstance(i, dict) and i.get('kind') in ('monitor_alert', 'monitor_recovered') and str(i.get('detailCode', '')).startswith('monitor.')
        and isinstance(i.get('metadata'), dict) and re.match(r'^[0-9a-f-]{36}$', str(i.get('id', ''))) for i in rows)
    if not ok:
        sys.exit('ingest-incidents: expected a JSON list of monitor incidents')
    psql(cfg, INSERT_INCIDENTS, cfg['incidentDatabaseUrl'], {'rows': json.dumps(rows, ensure_ascii=False)}, readonly=False)
    print('ingested %d' % len(rows))


# ---------- Telegram ----------


def telegram_secrets(cfg):
    env = env_file(cfg['telegramEnv'])
    return env.get('TELEGRAM_BOT_TOKEN'), env.get('TELEGRAM_CHAT_ID')


def send_telegram(cfg, text):
    """Send one message. With the default (system proxy settings) a failure is retried
    once directly, so a dead local proxy does not silence the alerts."""
    token, chat = telegram_secrets(cfg)
    if not token or not chat:
        raise CheckError('Telegram is not configured (%s)' % cfg['telegramEnv'])
    text = (cfg.get('messagePrefix') or '') + text
    data = urllib.parse.urlencode({'chat_id': chat, 'text': text[:4090], 'disable_web_page_preview': 'true'}).encode()
    routes = [cfg['telegramProxy']] + ([''] if cfg['telegramProxy'] is None else [])
    for proxy in routes:
        try:
            with opener(proxy).open('https://api.telegram.org/bot%s/sendMessage' % token, data, timeout=20) as resp:
                body = json.load(resp)
        except urllib.error.HTTPError as err:
            body = {'ok': False, 'description': 'HTTP %s %s' % (err.code, short(err.read(2000) if err.fp else b''))}
            break  # Telegram answered: another route will not help
        except Exception as err:
            body = {'ok': False, 'description': short(getattr(err, 'reason', err))}
            continue
        if body.get('ok') or body.get('error_code'):
            break
    if not body.get('ok'):
        raise CheckError(str(body.get('description', 'send failed')).replace(token, '<token>'))


def deliver(r, messages):
    """Queue the messages and send everything queued, oldest first; what fails waits for
    the next round. `failingSince` (in the heartbeat) lets the other machine tell a
    monitor that has stopped being able to deliver."""
    box = r.state.setdefault('outbox', [])
    tg = r.state.setdefault('telegram', {})
    box.extend(m for m in ([messages] if isinstance(messages, str) else messages or []) if m)
    if len(box) > 20:
        tg['dropped'] = tg.get('dropped', 0) + len(box) - 20
        del box[:-20]
    while box:
        note = '（另有 %d 条更早的通知没能发出，已丢弃）\n' % tg['dropped'] if tg.get('dropped') else ''
        try:
            send_telegram(r.cfg, note + box[0])
        except CheckError as err:
            tg['lastError'] = {'at': r.now, 'error': str(err)}
            tg.setdefault('failingSince', r.now)
            return False
        box.pop(0)
        tg['lastOkAt'], tg['dropped'] = time.time(), 0
        tg.pop('failingSince', None)
        r.save()  # sent is sent: a failure later in the round must not send it again
    return True


# ---------- component checks (M1) ----------


def job_info(label):
    """(state, runs, last exit code): state is running/loaded/gone."""
    rc, out, err = run(['/bin/launchctl', 'print', 'gui/%d/%s' % (os.getuid(), label)], 10)
    if rc == 113:
        return 'gone', None, None
    if rc:
        raise CheckError('launchctl print %s failed (exit %d): %s' % (label, rc, short(err)))
    pid = re.search(r'^\s*pid = (\d+)', out, re.M)
    runs = re.search(r'^\s*runs = (\d+)', out, re.M)
    last = re.search(r'^\s*last exit code = (.+)$', out, re.M)
    return ('running' if pid else 'loaded'), int(runs.group(1)) if runs else None, last.group(1).strip() if last else None


def ready(url, timeout=8):
    """(document when ready, why not, the document anyway when it answered with one)."""
    code, body = http_get(url, timeout)
    try:
        doc = json.loads(body) if code else None
    except ValueError:
        doc = None
    if not isinstance(doc, dict):
        doc = None
    if code != 200 or not doc or doc.get('status') != 'ready':
        why = 'HTTP %s' % code if code else short(body, 160)
        if doc and doc.get('detail'):
            why += ' detail=%s' % doc['detail']
        elif code and not doc:
            why += ' ' + short(body, 120)
        return None, why, doc
    return doc, '', doc


def lock_holders(path):
    """PIDs that have the lock file open. deploy-dev, scripts/m1/install and `deploy-lock
    run` keep it open exactly while they hold the lock (their children inherit it), so an
    open file means held. Asked with lsof, never by probing the lock: even a brief probe
    could make a deploy that starts at that moment fail as busy."""
    rc, out, _ = run(['/usr/sbin/lsof', '-t', '--', path], 10)
    return out.split() if rc == 0 else []  # 1: nobody; anything else: not known to be held, so judged


def in_grace(r, name, held):
    """True while `held` and for at most deployGraceMinutes from when it was first seen:
    planned work that runs longer is judged like an outage again."""
    seen = r.state.setdefault('deploySeen', {})
    if not held:
        seen.pop(name, None)
        return False
    since = seen.setdefault(name, r.now)
    r.facts['deployingUntil'] = int(since + r.cfg['deployGraceMinutes'] * 60)
    return r.now < r.facts['deployingUntil']


def deploying(r):
    """True while a deploy or other planned work holds the deploy lock (AGENTS.md section 5,
    e.g. a manual restart): Web, Worker, the database and the public entry may be down on
    purpose then, so they are not judged. Asked again by every check and every re-check."""
    return in_grace(r, 'm1', lock_holders(expand(r.cfg['deployLock'])))  # asked afresh: a re-check sees a deploy that just started


def check_deploy(r):
    if not os.path.exists(expand(r.cfg['deployInflight'])) or deploying(r):
        return [finding('deploy', 'ok', '部署中断未恢复')]
    return [finding('deploy', 'critical', '部署中断未恢复', '%s 还在，但没有部署在进行：上一次部署被强行中止，Dev 可能停在半途' % r.cfg['deployInflight'],
                    'm1-worker-crash.md', '~/allrice-dev/bin/deploy-dev --status（恢复由发布负责人 deploy-dev --release-manager --recover）')]


def check_service(r, role):
    label, base = r.cfg[role + 'Label'], r.cfg[role + 'Url']
    if deploying(r):
        return None
    path = '/api/health/ready' if role == 'web' else '/health/ready'
    title = 'Web 不可用' if role == 'web' else 'Worker 不可用'
    step = '~/allrice-dev/bin/deploy-dev --status; tail -50 ~/Library/Logs/allrice-dev-%s.err.log' % role
    if not label or not base:
        return [finding(role, 'warning', title + '（读不到配置）', 'launchd 文件 %s 缺失或不完整' % r.cfg[role + 'Plist'], 'm1-worker-crash.md', step)]
    state, _, last = job_info(label)
    doc, why, answer = ready(base + path)
    if doc:
        r.facts[role] = doc
        return [finding(role, 'ok', title)] + ([finding('worker_stuck', 'ok', 'Worker 定时控制器卡住，要重启 Worker')] if role == 'worker' else [])
    detail = 'launchd %s（%s）；%s%s 返回 %s' % (label, {'gone': '未加载', 'loaded': '已加载但没有进程', 'running': '进程在'}[state],
                                              base, path, why)
    if last and last != '(never exited)':
        detail += '；上次退出码 %s' % last
    out = [finding(role, 'critical', title, detail, 'm1-worker-crash.md', step)]
    if role == 'worker':
        stuck = (answer or {}).get('detail') or ''
        if re.match(r'native_(once|recurring)_(blocked|restart_required)$', stuck):
            # A schedule controller that hit an error (e.g. shutdown_failed while the database
            # was briefly away) stays blocked until the Worker restarts (automatic recovery:
            # MET-210 #3). Its own key, so it is told even if "Worker 不可用" was already open.
            ctl = (answer or {}).get('nativeOnceControl' if 'once' in stuck else 'nativeRecurringControl') or {}
            out.append(finding('worker_stuck', 'critical', 'Worker 定时控制器卡住，要重启 Worker', '%s；控制器 %s，lastFault %s' % (
                stuck, ctl.get('state'), short(json.dumps(ctl.get('lastFault'), ensure_ascii=False), 160)), 'm1-worker-crash.md#定时控制器卡住',
                '发布负责人：~/allrice-dev/bin/deploy-lock run worker-restart -- /bin/launchctl kickstart -k gui/$(id -u)/%s' % label))
        elif answer is not None:
            out.append(finding('worker_stuck', 'ok', 'Worker 定时控制器卡住，要重启 Worker'))
    return out


