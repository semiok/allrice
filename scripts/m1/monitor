DSH_RUNTIME = 'allrice-jsonrpc-runtime.mjs'


def check_memory(r):
    """System memory, and the DSH processes left behind by finished conversations: the
    Worker has no idle reaping yet, so they stay until it restarts. Counts every DSH
    process on the machine (QA instances too), since they share the same memory."""
    cfg, out = r.cfg, []
    code, text, err = run(['/usr/bin/memory_pressure', '-Q'])
    m = re.search(r'free percentage:\s*(\d+)%', text)
    if code != 0 or not m:
        out.append(unknown('memory', '内存余量查不到'))
    else:
        free = r.facts['memoryFreePct'] = int(m.group(1))
        sev = 'critical' if free < cfg['memoryCriticalFreePct'] else 'warning' if free < cfg['memoryWarnFreePct'] else 'ok'
        out.append(finding('memory', sev, '内存余量不足',
                           '系统可用内存 %d%%（警告线 %d%%，严重线 %d%%）' % (free, cfg['memoryWarnFreePct'], cfg['memoryCriticalFreePct']),
                           'm1-worker-crash.md', 'memory_pressure -Q; ps -axo rss,etime,command | sort -nr | head -15'))
    code, text, err = run(['/bin/ps', '-axo', 'rss=,command='])
    if code != 0:
        out.append(unknown('dsh_processes', 'DSH 进程数查不到'))
    else:
        # Only node processes running the runtime: not a `grep` or `ps` that names it.
        rss = [int(p[0]) for p in (line.split(None, 2) for line in text.splitlines())
               if len(p) == 3 and os.path.basename(p[1]) == 'node' and DSH_RUNTIME in p[2]]
        r.facts['dshProcesses'] = {'count': len(rss), 'mb': sum(rss) // 1024}
        out.append(finding('dsh_processes', 'warning' if len(rss) >= cfg['dshWarnProcesses'] else 'ok', 'DSH 进程越积越多',
                           '%d 个 DSH 进程常驻，共 %d MB（警告线 %d 个）。对话结束后进程不退出，要等 Worker 重启才释放'
                           % (len(rss), sum(rss) // 1024, cfg['dshWarnProcesses']),
                           'm1-worker-crash.md', 'ps -axo rss,etime,command | grep %s | grep -v grep | sort -nr | head' % DSH_RUNTIME))
    return out


def check_backup(r):
    """The last successful run (backup.log) and how the last run ended (launchd's exit
    code), so a failed 04:00 run alerts with the next round, not a day later."""
    path, last = expand(r.cfg['backupLog']), None
    step = 'tail -20 ~/allrice-backups/logs/backup.err.log; ls -la ~/allrice-backups/db | tail -3'
    try:
        with open(path, errors='replace') as f:
            for line in f.readlines()[-100:]:
                m = re.match(r'(\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) ok\b(.*)', line)
                if m:
                    last = m
    except OSError as err:
        return [finding('backup', 'warning', '每日备份异常', '读不到 %s：%s' % (path, err), 'm1-database.md', step)]
    age = r.now - time.mktime(time.strptime(last.group(1), '%Y-%m-%d %H:%M:%S')) if last else None
    r.facts['backup'] = {'last': last.group(1) if last else None, 'detail': last.group(2).strip() if last else ''}
    hours = age / 3600 if age is not None else None
    sev = 'critical' if hours is None or hours > r.cfg['backupCriticalHours'] else 'warning' if hours > r.cfg['backupWarnHours'] else 'ok'
    detail = '最近一次成功：%s（%s前）' % (last.group(1), ago(age)) if last else '日志里没有成功记录'
    if r.cfg.get('backupLabel'):
        state, _, exit_code = job_info(r.cfg['backupLabel'])
        if state == 'gone':
            sev, detail = max(sev, 'warning', key=RANK.get), detail + '；定时任务 %s 没有加载' % r.cfg['backupLabel']
        elif exit_code not in (None, '0', '(never exited)'):
            sev, detail = 'critical', detail + '；上一次运行失败（退出码 %s）' % exit_code
    return [finding('backup', sev, '每日备份异常', detail, 'm1-database.md', step)]


def read_remote_heartbeat(target, path, lock=None):
    """(heartbeat dict or None, error text, ssh reachable, lock holders or None)."""
    cmd = 'cat -- %s' % shlex.quote(path)
    if lock:
        cmd = 'printf "%%s\\n" "$(cat -- %s 2>&1)"; echo "@@lock $(/usr/sbin/lsof -t -- %s 2>/dev/null | tr "\\n" " ")"' % (
            shlex.quote(path), shlex.quote(lock))
    rc, out, err = run(['/usr/bin/ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=10', target, cmd], 30)
    if rc == 255 or rc == 124:
        return None, 'SSH 连不上 %s：%s' % (target, short(err, 160)), False, None
    holders = None
    if lock:
        body, _, tail = out.rpartition('@@lock')
        out, holders = body, tail.split()
    if rc:
        return None, '读不到 %s:%s（退出码 %d）：%s' % (target, path, rc, short(err, 120)), True, holders
    try:
        return json.loads(out), '', True, holders
    except ValueError:
        return None, '读不到 %s:%s：%s' % (target, path, short(out, 120)), True, holders


def judge_heartbeat(r, hb, keys, titles, stale, unfinished, stuck, severity, runbook, step):
    """Findings about the other machine's monitor from its heartbeat, the same in both
    directions: it is being started (`at`), its rounds finish (`unfinishedSince` is kept
    while rounds start and die), and it can deliver (`telegram.failingSince`)."""
    age, since = r.now - hb.get('at', 0), hb.get('unfinishedSince') if hb.get('phase') == 'running' else None
    if age > stale * 60:
        detail = '心跳已 %s 没更新（上限 %d 分钟）：监控没在运行或卡住了' % (ago(age), stale)
    elif since and r.now - since > unfinished * 60:
        detail = '每轮都开始了，但已 %s 没有一轮跑完（上限 %d 分钟）：监控每轮都在出错' % (ago(r.now - since), unfinished)
    else:
        detail = ''
    tg, tg_detail = hb.get('telegram') or {}, ''
    if not tg.get('configured'):
        tg_detail = '没有配置 telegram.env'
    elif tg.get('pending') and tg.get('failingSince') and r.now - tg['failingSince'] > stuck * 60:
        tg_detail = '已 %s 发不出去，积压 %s 条：%s；它那边未恢复的告警：%s' % (
            ago(r.now - tg['failingSince']), tg.get('pending'), (tg.get('lastError') or {}).get('error', ''),
            '、'.join('%s(%s)' % kv for kv in sorted((hb.get('openAlerts') or {}).items())) or '无')
    return [finding(keys[0], severity if detail else 'ok', titles[0], detail, runbook, step),
            finding(keys[1], 'warning' if tg_detail else 'ok', titles[1], tg_detail, runbook, step)]


def check_peer(r):
    """The huihuimac watchdog: without it nobody would notice M1 itself going down."""
    hb, err, _, _ = read_remote_heartbeat(r.cfg['peerSsh'], r.cfg['peerHeartbeat'])
    step = 'ssh %s "launchctl print gui/\\$(id -u)/ai.bplabs.allrice-monitor-peer | head -20"' % r.cfg['peerSsh']
    if not hb:
        return [finding('peer', 'warning', 'huihuimac 看门失效', err + '；M1 整机故障时将没人报警', 'm1-monitor.md', step)]
    r.facts['peer'] = hb
    return judge_heartbeat(r, hb, ('peer', 'peer_telegram'), ('huihuimac 看门失效', 'huihuimac 看门发不出 Telegram'), r.cfg['peerStaleMinutes'],
                           r.cfg['peerUnfinishedMinutes'], r.cfg['peerTelegramStuckMinutes'], 'warning', 'm1-monitor.md', step)


def check_monitor(r):
    """The monitor's own delivery: alerts that cannot reach the incidents table."""
    since, dropped = r.state.get('incidentFailingSince'), r.state.get('incidentDropped', 0)
    if not since or r.now - since < 1800:
        return [finding('monitor', 'ok', '告警写不进事件表')]
    err = (r.state.get('incidentError') or {}).get('error', '')
    return [finding('monitor', 'warning', '告警写不进事件表', '已 %s，积压 %d 条%s：%s' % (
        ago(r.now - since), len(r.state.get('incidentOutbox', [])), '（另有 %d 条超出上限已丢弃）' % dropped if dropped else '', err),
        'm1-monitor.md', 'monitor status')]


# ---------- business checks (SQL, read-only) ----------
# Each query is one SELECT on allrice_dev; thresholds come from the config key "business"
# as psql variables. The state semantics behind every query (which column is the
# heartbeat, how a schedule proves it fired, where "unknown outcome" lives) are written
# up with code references in docs/runbooks/m1-monitor.md#业务巡检. Queue, stuck and
# schedule checks are not judged while Dev admission is closed for maintenance: the
# Worker deliberately claims nothing then.

ADMISSION = "(select state from allrice_dev_maintenance where environment_id = :'maintenance_env')"
WINDOW = "now() - make_interval(mins => :'window_minutes'::int)"

# Root runs of real users: every root run has its job (assistant child runs have none and
# never set completed_at); platform runs, smoke/test accounts, previews, method tests,
# experience checks and the consolidation job are left out. Shared by both failure queries.
USER_RUNS = """
  from allrice_runs r
  join allrice_jobs j on j.run_id = r.id
  join allrice_organizations o on o.id = r.organization_id
  join allrice_users u on u.id = r.owner_id
  where o.slug <> 'allrice-platform'
    and not (coalesce(u.username, '') = any (string_to_array(:'test_usernames', ',')))
    and coalesce(r.execution_spec->>'handler', '') <> 'platform_employee_preview'
    and coalesce(j.payload->>'type', '') <> 'allrice.experience.consolidate'
    and not exists (select 1 from allrice_employee_method_tests t where t.run_id = r.id)
    and not exists (select 1 from allrice_platform_employee_test_runs v where v.experience_run_id = r.id)"""

SQL_FAILED_RUNS = """
with w as (
  select r.id, r.state, r.error_code, r.completed_at, r.completed_at >= """ + WINDOW + """ as recent,
         r.state = 'failed' and coalesce(r.error_code, '') <> 'APPROVAL_REJECTED' as bad""" + USER_RUNS + """
    and r.state in ('succeeded', 'failed', 'canceled')
    and r.completed_at >= now() - make_interval(mins => :'baseline_minutes'::int))
select count(*) filter (where recent and bad)::int as count,
  (array_agg(id order by completed_at desc) filter (where recent and bad))[1:3] as samples,
  count(*) filter (where recent and state <> 'canceled')::int as total,
  round(100.0 * count(*) filter (where recent and bad) / nullif(count(*) filter (where recent and state <> 'canceled'), 0), 1) as pct,
  round(100.0 * count(*) filter (where bad and not recent) / nullif(count(*) filter (where state <> 'canceled' and not recent), 0), 1) as baseline_pct,
  array_agg(distinct error_code) filter (where recent and bad) as codes
from w"""

SQL_STUCK_RUNS = """
with stuck as (
  select j.run_id, 'lease_expired' as reason, j.lease_expires_at as since from allrice_jobs j
  where j.status in ('claimed', 'running') and j.lease_expires_at < now() - make_interval(mins => :'stuck_minutes'::int)
  union all
  select r.id, 'run_running_job_' || j.status, r.updated_at from allrice_runs r join allrice_jobs j on j.run_id = r.id
  where r.state = 'running' and j.status not in ('claimed', 'running')
    and r.updated_at < now() - make_interval(mins => :'stuck_minutes'::int))
select count(distinct run_id)::int as count, (array_agg(run_id order by since))[1:3] as samples,
  array_agg(distinct reason) as reasons, """ + ADMISSION + """ as admission
from stuck"""

# A heartbeat alone does not prove progress: the lease timer runs apart from the handler.
SQL_SILENT_RUNS = """
select count(*)::int as count, (array_agg(r.id order by le.last_at))[1:3] as samples,
  extract(epoch from max(now() - le.last_at))::int as oldest, """ + ADMISSION + """ as admission
from allrice_jobs j
join allrice_runs r on r.id = j.run_id
left join allrice_task_clocks c on c.run_id = r.id
cross join lateral (select coalesce((select e.occurred_at from allrice_run_events e where e.run_id = r.id
                                     order by e.sequence desc limit 1), j.claimed_at) as last_at) le
where j.status = 'running' and r.state = 'running' and j.lease_expires_at > now()
  and coalesce(c.phase, 'active') = 'active'
  and le.last_at < now() - make_interval(mins => :'silent_minutes'::int)
  and not exists (select 1 from allrice_runtime_operations o where o.root_run_id = r.id
                  and o.snapshot->>'status' in ('dispatched', 'running', 'cancel_requested') and o.lease_expires_at > now())"""

SQL_DEAD_LETTERS = """
select count(*)::int as count, (array_agg(j.run_id order by j.completed_at desc))[1:3] as samples,
  array_agg(distinct j.last_error_code) as codes, array_agg(distinct j.payload->>'type') as types
from allrice_jobs j
where j.status = 'dead_letter' and j.completed_at >= """ + WINDOW

SQL_QUEUE = """
select count(*)::int as count, (array_agg(j.run_id order by j.available_at))[1:3] as samples,
  extract(epoch from max(now() - j.available_at))::int as oldest,
  (select count(*)::int from allrice_jobs a where a.status in ('claimed', 'running')) as active,
  """ + ADMISSION + """ as admission
from allrice_jobs j
where j.status in ('queued', 'retry_wait')
  and j.available_at < now() - make_interval(mins => :'queue_warn_minutes'::int)
  and coalesce(j.payload->>'type', '') not like 'allrice.platform.dev.%'
  and coalesce(j.payload->>'type', '') <> 'allrice.experience.consolidate'
  and not exists (select 1 from allrice_conversation_followups f where f.run_id = j.run_id and f.mode = 'steer_only')"""

# native_once proves it fired with an occurrence row for the current revision; native
# recurring advances next_run_at in the same transaction as its occurrence; both hand the
# run over through an outbox. Legacy schedule rows can no longer fire at all (retired).
SQL_SCHEDULES = """
with late as (
  select a.id, 'native_once_not_fired' as reason, a.next_run_at as due_at from allrice_automations a
  where a.clock_owner = 'native_once' and a.status = 'enabled' and a.deleted_at is null and a.native_once_cancelled_at is null
    and a.next_run_at < now() - make_interval(mins => :'schedule_late_minutes'::int)
    and not exists (select 1 from allrice_native_once_occurrences o where o.automation_id = a.id and o.revision = a.revision)
    and not exists (select 1 from allrice_native_once_controls c where c.automation_id = a.id and c.revision = a.revision
                    and c.snapshot->'control'->'command'->>'status' = 'blocked')
  union all
  -- the Worker reached the create only after its time (target_not_future, the one reason
  -- a command is blocked): the reminder was never executed; it stays until someone
  -- reschedules, pauses, cancels or deletes it
  select a.id, 'native_once_missed', a.next_run_at from allrice_automations a
  where a.clock_owner = 'native_once' and a.status = 'enabled' and a.deleted_at is null and a.native_once_cancelled_at is null
    and exists (select 1 from allrice_native_once_controls c where c.automation_id = a.id and c.revision = a.revision
                and c.snapshot->'control'->'command'->>'status' = 'blocked')
  union all
  select a.id, 'native_recurring_not_advanced', a.next_run_at from allrice_automations a
  where a.clock_owner = 'native_recurring' and a.status = 'enabled' and a.deleted_at is null
    and a.next_run_at < now() - make_interval(mins => :'schedule_late_minutes'::int)
    and a.next_run_at > coalesce(a.native_recurring_resume_after, '-infinity'::timestamptz)
  union all
  select o.automation_id, 'native_once_handover_pending', o.created_at from allrice_native_once_occurrences o
  where o.outbox_state = 'pending' and o.created_at < now() - make_interval(mins => :'schedule_late_minutes'::int)
  union all
  select o.automation_id, 'native_recurring_handover_pending', o.created_at from allrice_native_recurring_occurrences o
  where o.outbox_state = 'pending' and o.created_at < now() - make_interval(mins => :'schedule_late_minutes'::int)
  union all
  select a.id, 'legacy_schedule_retired', a.next_run_at from allrice_automations a
  where a.clock_owner = 'legacy' and a.trigger_type = 'schedule' and a.status = 'enabled' and a.deleted_at is null
    and a.next_run_at < now() - make_interval(mins => :'schedule_late_minutes'::int))
select count(distinct id) filter (where reason <> 'legacy_schedule_retired')::int as count,
  (array_agg(id order by due_at) filter (where reason <> 'legacy_schedule_retired'))[1:3] as samples,
  extract(epoch from max(now() - due_at) filter (where reason not in ('legacy_schedule_retired', 'native_once_missed')))::int as oldest,
  array_agg(distinct reason) as reasons,
  count(distinct id) filter (where reason = 'legacy_schedule_retired')::int as legacy,
  (select array_agg(p.partition_id) from allrice_native_once_partitions p
   where (p.closed or p.expires_at is null or p.expires_at < now() - make_interval(mins => :'schedule_late_minutes'::int))
     and exists (select 1 from allrice_automations a
                 where a.status = 'enabled' and a.deleted_at is null
                   and (exists (select 1 from allrice_native_once_controls c where c.automation_id = a.id and c.partition_id = p.partition_id)
                        or exists (select 1 from allrice_native_recurring_controls c where c.automation_id = a.id and c.partition_id = p.partition_id)))) as host_down,
  """ + ADMISSION + """ as admission
from late"""

# Only two paths park a run in waiting_approval (a native question, a workflow approval)
# and neither has a timeout; a wait with neither behind it can never resume.
SQL_WAITS = """
with w as (
  select r.id, coalesce(q.created_at, ap.requested_at, j.updated_at) as since,
    case when q.run_id is not null then 'question' when ap.run_id is not null then 'approval' else 'orphan' end as kind
  from allrice_runs r
  join allrice_jobs j on j.run_id = r.id
  left join lateral (select x.run_id, min(x.created_at) as created_at from allrice_native_question_waits x
                     where x.run_id = r.id and x.state = 'parked' group by x.run_id) q on true
  left join lateral (select a.run_id, min(a.requested_at) as requested_at from allrice_approval_requests a
                     where a.run_id = r.id and a.status = 'pending' group by a.run_id) ap on true
  where r.state = 'waiting_approval' or j.status = 'waiting_approval')
select count(*) filter (where kind <> 'orphan' and since < now() - make_interval(mins => :'wait_minutes'::int))::int as count,
  (array_agg(id order by since) filter (where kind <> 'orphan' and since < now() - make_interval(mins => :'wait_minutes'::int)))[1:3] as samples,
  count(*) filter (where kind = 'orphan' and since < now() - make_interval(mins => :'stuck_minutes'::int))::int as orphans,
  (array_agg(id order by since) filter (where kind = 'orphan' and since < now() - make_interval(mins => :'stuck_minutes'::int)))[1:3] as orphan_samples
from w"""

# "Unknown" is entered through an operation.uncertain event and left only by a late
# receipt; it cannot be re-run elsewhere, so new ones alert and the backlog is shown.
SQL_UNKNOWN_OPS = """
with ops as (
  select o.id, 'unknown' as kind,
    (select e.created_at from allrice_runtime_operation_events e where e.operation_id = o.id
     and e.payload->'signal'->>'type' = 'operation.uncertain' order by e.sequence desc limit 1) as since
  from allrice_runtime_operations o where o.snapshot->>'status' = 'unknown'
  union all
  -- a cancel is only an intent and a finished root proves nothing about the operation:
  -- these stay until a receipt or a person settles them
  select o.id, 'inflight_lease_expired', o.lease_expires_at from allrice_runtime_operations o
  where o.snapshot->>'status' in ('dispatched', 'running', 'cancel_requested')
    and o.lease_expires_at < now() - make_interval(mins => :'stuck_minutes'::int))
select count(*) filter (where kind = 'unknown' and since >= """ + WINDOW + """)::int as count,
  (array_agg(id order by since desc) filter (where kind = 'unknown'))[1:3] as samples,
  count(*) filter (where kind = 'unknown')::int as backlog,
  count(*) filter (where kind = 'inflight_lease_expired')::int as expired,
  (array_agg(id order by since) filter (where kind = 'inflight_lease_expired'))[1:3] as expired_samples,
  (select count(*)::int from allrice_bridge_commands b where b.status = 'unknown' and b.updated_at >= """ + WINDOW + """) as bridge_unknown,
  (select count(*)::int from allrice_bridge_commands b where b.status = 'unknown') as bridge_backlog
from ops"""

# Online in the product means last_seen_at within 90 s; the WSS lease is renewed every 5 s.
SQL_BRIDGE = """
with d as (
  select d.id, d.last_seen_at, coalesce(c.expires_at > now(), false) as wss_live,
    d.last_seen_at > now() - interval '90 seconds' as present,
    exists (select 1 from allrice_runtime_operations op where op.device_id = d.id
            and op.snapshot->>'status' in ('waiting_device', 'ready', 'dispatched', 'running', 'cancel_requested')
            and op.updated_at < now() - make_interval(mins => :'bridge_work_wait_minutes'::int)
            and exists (select 1 from allrice_jobs j where j.run_id = op.root_run_id and j.status in ('claimed', 'running'))) as has_work
  from allrice_bridge_devices d
  join allrice_organizations o on o.id = d.organization_id and o.archived_at is null
  join allrice_users u on u.id = d.owner_id and u.status = 'active'
  left join allrice_bridge_connections c on c.device_id = d.id
  where d.revoked_at is null and d.last_seen_at > now() - make_interval(hours => :'bridge_active_hours'::int))
select count(*) filter (where not wss_live and last_seen_at < now() - make_interval(mins => :'bridge_offline_minutes'::int))::int as count,
  (array_agg(id order by last_seen_at desc) filter (where not wss_live and last_seen_at < now() - make_interval(mins => :'bridge_offline_minutes'::int)))[1:3] as samples,
  count(*) filter (where not wss_live and not present and has_work)::int as offline_with_work,
  count(*) filter (where present and not wss_live)::int as heartbeat_only,
  count(*)::int as expected
from d"""

SQL_DEADLOCKS = """
select (select deadlocks from pg_stat_database where datname = current_database())::bigint as total,
  (select stats_reset from pg_stat_database where datname = current_database())::text as reset,
  count(*)::int as job_start, (array_agg(j.run_id order by j.completed_at desc))[1:3] as samples
from allrice_jobs j
where j.last_error_code = 'JOB_START_DEADLOCK' and j.completed_at >= """ + WINDOW

# Failed runs of the last 24 hours grouped by error code, with the days before as the
# baseline: what the daily report summarizes and `monitor failures --json` exports.
SQL_FAILURE_GROUPS = """
with f as (
  select coalesce(nullif(r.error_code, ''), '(none)') as code, r.id, r.completed_at,
         left(coalesce(r.error_message, ''), 200) as message, r.completed_at >= now() - interval '24 hours' as today""" + USER_RUNS + """
    and r.state = 'failed' and coalesce(r.error_code, '') <> 'APPROVAL_REJECTED'
    and r.completed_at >= now() - make_interval(days => :'failure_baseline_days'::int + 1))
select coalesce(json_agg(g order by g.today desc, g.code), '[]') as groups from (
  select code, count(*) filter (where today)::int as today, count(*) filter (where not today)::int as before,
    (array_agg(id order by completed_at desc) filter (where today))[1:5] as samples,
    (array_agg(message order by completed_at desc) filter (where today))[1:3] as messages
  from f group by code having count(*) filter (where today) > 0) g"""

BUSINESS_RUNBOOK = 'm1-monitor.md#业务巡检'
SQL_STEP = 'psql 查 allrice_dev（SQL 见 scripts/m1/monitor 的 SQL_%s）'


def biz(r, sql):
    variables = dict(r.cfg['business'])
    return json.loads(r.psql('select row_to_json(t) from (%s) t;' % sql, r.cfg['databaseUrl'], variables))


def ids(row, key='samples'):
    return '，'.join(str(x) for x in (row.get(key) or []))


def closed(row):
    return row.get('admission') not in (None, 'open')


def check_failed_runs(r):
    """Spike: many failures, a high share and well above the 24 hours before the window.
    Sustained: a high share whatever the baseline (a long outage raises its own
    baseline). Low traffic: several failures and at least half of what finished."""
    b, row = r.cfg['business'], biz(r, SQL_FAILED_RUNS)
    n, total, pct, base = row['count'], row['total'], row['pct'] or 0, row['baseline_pct'] or 0
    sev = 'ok'
    if total >= b['failed_min_total']:
        if n >= b['failed_critical_count'] and pct >= b['failed_critical_pct']:
            sev = 'critical'
        elif n >= b['failed_warn_count'] and pct >= b['failed_warn_pct'] and (pct >= 2 * base or pct >= b['failed_sustained_pct']):
            sev = 'warning'
    elif n >= b['failed_warn_count'] and pct >= 50:
        sev = 'warning'
    return [finding('business.failed_runs', sev, 'run 失败比例突增',
                    '近 %s 分钟 %d/%d 失败（%s%%，此前 24 小时 %s%%），错误码 %s；例 %s' % (
                        b['window_minutes'], n, total, pct, base, '、'.join(c or '?' for c in row['codes'] or []), ids(row)),
                    BUSINESS_RUNBOOK, SQL_STEP % 'FAILED_RUNS')]


def check_stuck_runs(r):
    row = biz(r, SQL_STUCK_RUNS)
    if closed(row) or deploying(r):
        return None
    return [finding('business.stuck_runs', 'critical' if row['count'] else 'ok', 'run 卡住（租约过期没人收回）',
                    '%d 个：%s；例 %s' % (row['count'], '、'.join(row['reasons'] or []), ids(row)), 'm1-worker-crash.md', SQL_STEP % 'STUCK_RUNS')]


def check_silent_runs(r):
    row = biz(r, SQL_SILENT_RUNS)
    if closed(row) or deploying(r):
        return None
    return [finding('business.silent_runs', 'warning' if row['count'] else 'ok', 'run 长时间没有进展',
                    '%d 个在跑但 %s 没有新事件；例 %s' % (row['count'], ago(row['oldest'] or 0), ids(row)), BUSINESS_RUNBOOK, SQL_STEP % 'SILENT_RUNS')]


def check_dead_letters(r):
