def run_checks(r, checks):
    """Run the checks; (findings, names of the checks that judged this round). A check
    returns None when it cannot judge (what it needs is down): its alerts stay as they
    are, because unknown is not "recovered". A check that fails itself raises an alert of
    its own ("check:<name>"), which recovers once it runs cleanly again. Progress lives on
    the round, so a round that times out still reports what it found (collect_checks)."""
    wanted = r.cfg['checks']
    checks = [c for c in checks if (wanted is None or c[0] in wanted) and c[0] not in r.cfg['skipChecks']]
    p = r.progress = {'checks': checks, 'results': {}, 'errors': {}, 'current': None}
    results, errors = p['results'], p['errors']

    def one(name, fn):
        p['current'] = name
        try:
            results[name], errors[name] = fn(r), None
        except Exception as err:  # a bug in one check must not stop the others or the round
            results[name] = None
            text = str(err) if isinstance(err, CheckError) else '%s: %s' % (type(err).__name__, short(err, 200))
            errors[name] = finding('check:' + name, 'warning', '检查 %s 本身出错' % name, text, 'm1-monitor.md', 'monitor status')
        p['current'] = None

    def bad(name):
        return errors.get(name) or any(f['severity'] != 'ok' for f in results.get(name) or [])

    for name, fn, _, needs in checks:
        if needs in results and (results[needs] is None or bad(needs)):
            continue  # what it needs is down or unknown
        one(name, fn)
    again = [c for c in checks if c[2] and c[0] in results and bad(c[0])]
    if again:
        time.sleep(r.cfg['confirmSeconds'])
        for name, fn, _, _ in again:
            one(name, fn)
    return collect_checks(r)


def collect_checks(r):
    p = r.progress
    out = []
    for name, _, _, _ in p['checks']:
        if name in p['errors']:
            out.append(p['errors'][name] or finding('check:' + name, 'ok', '检查 %s 本身出错' % name))
            out += p['results'][name] or []
    return out, {name for name, res in p['results'].items() if res is not None}


# ---------- rounds ----------


def hb_tools():
    """The installed commit (TOOLS_VERSION next to this file), 'source' when run from a checkout."""
    try:
        with open(os.path.join(HERE, 'TOOLS_VERSION')) as f:
            return f.read().split()[0]
    except (OSError, IndexError):
        return 'source'


def heartbeat(r, took, error=None, phase='done'):
    """Written when a round starts and when it ends. `at` shows the monitor is being
    started; `unfinishedSince` is carried over from round to round while none of them
    finishes (a monitor that starts and dies every time); `telegram.failingSince` shows
    since when it cannot deliver."""
    path = os.path.join(r.cfg['stateDir'], 'heartbeat.json')
    prev = read_json(path, {})
    unfinished = None
    if phase == 'running':
        unfinished = (prev.get('unfinishedSince') if prev.get('phase') == 'running' else None) or int(time.time())
    tg = r.state.get('telegram', {})
    token, chat = telegram_secrets(r.cfg)
    tools = hb_tools()
    write_json(path, {
        'at': int(time.time()), 'phase': phase, 'unfinishedSince': unfinished, 'lastDoneAt': (r.state.get('lastRound') or {}).get('at'),
        'host': socket.gethostname(), 'name': r.cfg['name'], 'label': r.cfg['label'], 'tools': tools,
        'roundSeconds': round(took, 1), 'roundError': error, 'publicUrl': r.cfg.get('publicUrl'),
        'openAlerts': {k: a['severity'] for k, a in r.state.get('alerts', {}).items()},
        'telegram': {'configured': bool(token and chat), 'lastOkAt': tg.get('lastOkAt'), 'failingSince': tg.get('failingSince'),
                     'pending': len(r.state.get('outbox', [])), 'lastError': tg.get('lastError')},
        'incidents': {'pending': len(r.state.get('incidentOutbox', [])), 'lastError': r.state.get('incidentError')},
    })


def locked(cfg, wait=0):
    """One round at a time per state directory; launchd never overlaps a job with itself,
    this covers a manual run. Exits quietly when busy (after `wait` seconds)."""
    f = open(os.path.join(cfg['stateDir'], 'monitor.lock'), 'a')
    end = time.time() + wait
    while True:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return f
        except BlockingIOError:
            if time.time() >= end:
                print('monitor: a round in %s is still running' % cfg['stateDir'], file=sys.stderr)
                sys.exit(0)
            time.sleep(1)


def on_alarm(signum, frame):
    raise RoundTimeout()


def do_round(cfg, peer):
    lock = locked(cfg)
    r = Round(cfg, peer, recover=True)
    start, error = time.time(), None
    heartbeat(r, 0, phase='running')
    signal.signal(signal.SIGALRM, on_alarm)
    signal.alarm(cfg['roundTimeoutSeconds'])
    try:
        findings, ran = run_checks(r, PEER_CHECKS if peer else M1_CHECKS)
        findings.append(finding('monitor_round', 'ok', '监控本轮超时'))
    except RoundTimeout:
        # Keep what the finished checks found; only the stuck one stays unknown.
        stuck = (r.progress or {}).get('current') or '?'
        error = 'round timed out after %ss in check %s' % (cfg['roundTimeoutSeconds'], stuck)
        findings, ran = collect_checks(r) if r.progress else ([], set())
        findings.append(finding('monitor_round', 'critical', '监控本轮超时', '检查 %s 卡住，%s 秒没跑完；其余检查的结果照常报告' % (
            stuck, cfg['roundTimeoutSeconds']), 'm1-monitor.md', 'monitor status'))
    lost = r.state.pop('stateLost', None)
    findings.append(finding('monitor_state', 'warning' if lost else 'ok', '监控状态文件损坏',
                            '读不出来，已另存为 %s；之前的待发通知和告警状态丢了，已有的故障会重新报一次' % lost,
                            'm1-monitor.md', 'monitor status'))
    signal.alarm(90)  # delivery has its own timeouts; this only bounds a hung write
    try:
        r.now = time.time()
        events = evaluate(r, findings, ran)
        if peer:
            flush_incidents_remote(r)
        else:
            flush_incidents(r)
        deliver(r, compose(r, events))
        if not peer and daily_due(r):
            send_daily(r)
        r.state['lastRound'] = {'at': r.now, 'seconds': round(time.time() - start, 1), 'error': error}
        r.state['rounds'] = [t for t in r.state.get('rounds', []) if r.now - t < 86400] + [r.now]
        r.save()
        heartbeat(r, time.time() - start, error)
    except RoundTimeout:
        r.save()
        sys.exit('monitor: delivering the round timed out')
    finally:
        signal.alarm(0)
        lock.close()


# ---------- daily report (M1) ----------


def daily_due(r):
    local = time.localtime(r.now)
    return local.tm_hour >= r.cfg['dailyHour'] and r.state.get('dailySent') != time.strftime('%Y-%m-%d', local)


def daily_text(r):
    now, cfg = r.now, r.cfg
    lines = ['📋 %s%s 日报 %s' % ('[%s] ' % cfg['label'] if cfg['label'] else '', cfg['name'], time.strftime('%m-%d %H:%M', time.localtime(now))), '']
    lines += daily_business(r)
    rows = r.facts.get('subscription')
    if rows is None:
        try:
            rows = json.loads(r.psql(SUBSCRIPTION_SQL, cfg['databaseUrl']) or '[]')
        except CheckError as err:
            rows, err_text = [], str(err)
            lines.append('订阅：查询失败（%s）' % err_text)
    for row in rows or []:
        used = [w['usedPercent'] for b in (row.get('quota') or {}).get('buckets', []) for w in b.get('windows', []) if w.get('usedPercent') is not None]
        lines.append('订阅：槽位 %s %s，%s，额度已用 %s' % (row['slot'], row['label'], row['status'], '%d%%' % max(used) if used else '未知'))
    for d in cfg['disks']:
        try:
            st = os.statvfs(expand(d['path']))
            free = st.f_bavail * st.f_frsize / 2 ** 30
            lines.append('磁盘：%s 剩 %s GiB' % (d['path'], '%.0f' % free if free >= 10 else '%.2f' % free))
        except OSError as err:
            lines.append('磁盘：%s 查不到（%s）' % (d['path'], err))
    if 'memoryFreePct' not in r.facts:
        check_memory(r)
    dsh = r.facts.get('dshProcesses')
    lines.append('内存：可用 %s，DSH 进程 %s' % (
        '%d%%' % r.facts['memoryFreePct'] if 'memoryFreePct' in r.facts else '查不到',
        '%d 个（共 %d MB）' % (dsh['count'], dsh['mb']) if dsh else '查不到'))
    backup = check_backup(r)[0]
    lines.append('备份：%s' % (backup['detail'] + ('，' + r.facts['backup']['detail'] if r.facts.get('backup', {}).get('detail') else '')))
    day = [h for h in r.state.get('history', []) if now - h['at'] < 86400]
    opened = [h for h in day if h['event'] == 'opened']
    lines.append('告警：过去 24 小时新开 %d 项、恢复 %d 项' % (len(opened), len([h for h in day if h['event'] == 'recovered'])))
    still = r.state.get('alerts', {})
    if still:
        lines.append('当前未恢复：' + '；'.join('%s（%s）' % (a['title'], ago(now - a['since'])) for a in still.values()))
    peer, peer_tools = still.get('peer'), (r.facts.get('peer') or {}).get('tools')
    lines.append('看门：huihuimac %s%s' % ('异常：' + peer['detail'] if peer else '正常',
                                         '（版本 %s，本机 %s）' % (peer_tools[:8], hb_tools()[:8]) if peer_tools and peer_tools != hb_tools() else ''))
    rounds = [t for t in r.state.get('rounds', []) if now - t < 86400]
    tg = r.state.get('telegram', {})
    lines.append('监控：24 小时跑了 %d 轮；TG 待发 %d 条；事件表待写 %d 条%s' % (
        len(rounds), len(r.state.get('outbox', [])), len(r.state.get('incidentOutbox', [])),
        '；事件表积压超上限累计丢弃 %d 条' % r.state['incidentDropped'] if r.state.get('incidentDropped') else ''))
    if tg.get('failingSince'):
        lines.append('　TG 从 %s 起发不出去：%s' % (time.strftime('%m-%d %H:%M', time.localtime(tg['failingSince'])), (tg.get('lastError') or {}).get('error', '')))
    return '\n'.join(lines)


def send_daily(r):
    r.state['dailySent'] = time.strftime('%Y-%m-%d', time.localtime(r.now))
    try:
        text = daily_text(r)
    except Exception as err:  # the report must not break the round that carries it
        text = '📋 %s 日报生成失败：%s: %s' % (r.cfg['name'], type(err).__name__, short(err, 200))
    deliver(r, text)


# ---------- peer (huihuimac) ----------


def check_m1(r):
    """M1 answers over SSH, its monitor runs, finishes its rounds and can deliver. While M1
    cannot be reached only m1_reachable is judged: its heartbeat is unknown, not stale."""
    cfg = r.cfg
    hb, err, reachable, holders = read_remote_heartbeat(cfg['m1Ssh'], cfg['m1Heartbeat'], cfg['m1DeployLock'])
    step = 'ssh %s "~/allrice-dev/bin/monitor status"' % cfg['m1Ssh']
    out = [finding('m1_reachable', 'ok' if reachable else 'critical', 'M1 连不上', err + '（整机宕机、断网或 Tailscale 断开）',
                   'm1-monitor.md', 'tailscale status; ssh -v %s true' % cfg['m1Ssh'])]
    if not reachable:
        return out
    r.facts['m1Deploying'] = in_grace(r, 'm1', bool(holders))
    if not hb:
        return out + [finding('m1_heartbeat', 'critical', 'M1 监控停了', err, 'm1-monitor.md', step)]
    if hb.get('publicUrl'):
        r.state['m1PublicUrl'] = hb['publicUrl']
    return out + judge_heartbeat(r, hb, ('m1_heartbeat', 'm1_telegram'), ('M1 监控停了', 'M1 监控发不出 Telegram'), cfg['m1StaleMinutes'],
                                 cfg['m1UnfinishedMinutes'], cfg['m1TelegramStuckMinutes'], 'critical', 'm1-monitor.md', step)


def check_outside(r):
    """From outside M1. A failure is checked against M1's deploy lock asked right then,
    so a deploy that starts or ends during the round is seen as it is."""
    out = probe_public(r, r.cfg['publicUrl'] or r.state.get('m1PublicUrl'), 'public_entry', ' M1 之外（huihuimac）')
    if out[0]['severity'] != 'ok':
        _, _, reachable, holders = read_remote_heartbeat(r.cfg['m1Ssh'], r.cfg['m1Heartbeat'], r.cfg['m1DeployLock'])
        if reachable and in_grace(r, 'm1', bool(holders)):
            return None  # a deploy on M1 stops Web on purpose
    return out


PEER_CHECKS = [
    ('m1', check_m1, True, None),
    ('public_entry', check_outside, True, None),
    ('monitor', check_monitor, False, None),
]


# ---------- launchd ----------


def launchd(cfg, action, peer):
    label = cfg['launchdLabel'] or ('ai.bplabs.allrice-monitor-peer' if peer else 'ai.bplabs.allrice-dev-monitor')
    path = expand('~/Library/LaunchAgents/%s.plist' % label)
    domain = 'gui/%d' % os.getuid()
    run(['/bin/launchctl', 'bootout', '%s/%s' % (domain, label)], 30)
    for _ in range(90):  # bootout is asynchronous; bootstrap fails while the old job is still there
        if run(['/bin/launchctl', 'print', '%s/%s' % (domain, label)], 10)[0] == 113:
            break
        time.sleep(1)
    if action == 'remove':
        if os.path.exists(path):
            os.remove(path)
        print('removed %s' % label)
        return
    args = ['/usr/bin/python3', os.path.abspath(sys.argv[0]), 'peer' if peer else 'run']
    if cfg['configFile']:
        args += ['--config', cfg['configFile']]
    log = os.path.join(cfg['stateDir'], 'monitor.log')
    with open(path + '.tmp', 'wb') as f:
        plistlib.dump({'Label': label, 'ProgramArguments': args, 'StartInterval': cfg['intervalSeconds'], 'RunAtLoad': True,
                       'StandardOutPath': log, 'StandardErrorPath': log}, f)
    os.replace(path + '.tmp', path)
    for _ in range(5):
        if run(['/bin/launchctl', 'bootstrap', domain, path], 30)[0] == 0:
            print('installed %s: every %ss, %s' % (label, cfg['intervalSeconds'], ' '.join(args)))
            return
        time.sleep(3)
    sys.exit('could not load %s' % label)


def status(cfg):
    state = read_json(os.path.join(cfg['stateDir'], 'state.json'), {})
    hb = read_json(os.path.join(cfg['stateDir'], 'heartbeat.json'), {})
    print(json.dumps({'name': cfg['name'], 'stateDir': cfg['stateDir'], 'lastRound': state.get('lastRound'),
                      'heartbeatAge': int(time.time() - hb['at']) if hb.get('at') else None,
                      'openAlerts': {k: {'severity': a['severity'], 'title': a['title'], 'detail': a['detail'], 'since': time.strftime('%m-%d %H:%M', time.localtime(a['since']))}
                                     for k, a in state.get('alerts', {}).items()},
                      'telegram': hb.get('telegram'), 'incidents': hb.get('incidents'), 'incidentsDropped': state.get('incidentDropped', 0),
                      'dailySent': state.get('dailySent')},
                     ensure_ascii=False, indent=1))


def main(argv):
    p = argparse.ArgumentParser(prog='monitor')
    p.add_argument('command', choices=['run', 'peer', 'daily', 'failures', 'status', 'test-alert', 'launchd', 'ingest-incidents'])
    p.add_argument('action', nargs='?', choices=['install', 'remove'])
    p.add_argument('--config')
    p.add_argument('--peer', action='store_true')
    p.add_argument('--dry-run', action='store_true', help='run/peer/daily: print what would be sent; send and store nothing')
    p.add_argument('--json', action='store_true', help='failures: the groups as JSON')
    a = p.parse_args(argv)
    peer = a.command == 'peer' or a.peer
    cfg = load_config(a.config, peer)
    os.makedirs(cfg['stateDir'], mode=0o700, exist_ok=True)
    if not peer:
        derive_m1(cfg)
    if a.command in ('run', 'peer') and a.dry_run:
        r = Round(cfg, peer)
        findings, ran = run_checks(r, PEER_CHECKS if peer else M1_CHECKS)
        for f in findings:
            print('%-8s %-28s %s %s' % (f['severity'], f['key'], f['title'] if f['severity'] != 'ok' else '', f['detail'] if f['severity'] != 'ok' else ''))
        print('\n\n'.join(compose(r, evaluate(r, findings, ran))) or '(nothing to send)')
    elif a.command in ('run', 'peer'):
        do_round(cfg, peer)
    elif a.command == 'failures':
        out = failure_groups(Round(cfg))
        if a.json:
            print(json.dumps(out, ensure_ascii=False, indent=1, default=str))
        else:
            for g in out['groups']:
                print('%-9s %-40s 24h %3d  before %3d (%.2f/day)  e.g. %s' % (g['kind'], g['code'], g['today'], g['before'], g['dailyBefore'], (g['samples'] or [''])[0]))
    elif a.command == 'daily' and a.dry_run:
        print(daily_text(Round(cfg)))
    elif a.command == 'daily':
        lock = locked(cfg, wait=300)
        r = Round(cfg, recover=True)
        send_daily(r)
        r.save()
        lock.close()
    elif a.command == 'status':
        status(cfg)
    elif a.command == 'ingest-incidents':
        ingest_incidents(cfg, sys.stdin)
    elif a.command == 'test-alert':
        send_telegram(cfg, '🔔 %s%s：告警通道测试 %s' % ('[%s] ' % cfg['label'] if cfg['label'] else '', cfg['name'], time.strftime('%m-%d %H:%M')))
        print('sent')
    elif a.command == 'launchd':
        if not a.action:
            p.error('launchd needs install or remove')
        launchd(cfg, a.action, peer)


if __name__ == '__main__':
    main(sys.argv[1:])
