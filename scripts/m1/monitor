SUBSCRIPTION_SQL = """
select coalesce(json_agg(json_build_object(
  'slot', s.slot, 'label', s.label, 'status', p.status, 'detail', p.detail_code,
  'ageSeconds', extract(epoch from now() - p.checked_at)::int, 'quota', p.subscription_quota)), '[]')
from allrice_codex_subscriptions s
left join allrice_provider_status p on p.provider = 'codex' and p.subscription_slot = s.slot
where s.enabled;
"""


def check_subscription(r):
    """Two alerts: `subscription` (a slot is enabled, authorized, its status refreshed) and
    `quota` (usage of the enabled slot). Only windows the provider reports as measured
    count; an unreadable quota is unknown, which keeps an open quota alert as it is, and
    alerts by itself only once it has lasted subscriptionStaleMinutes."""
    rows = json.loads(r.psql(SUBSCRIPTION_SQL, r.cfg['databaseUrl']) or '[]')
    step = '后台「模型与订阅」查看授权与额度；psql 查 allrice_provider_status'
    if not rows:
        return [finding('subscription', 'critical', '模型订阅不可用', '没有启用的 Codex 订阅槽位', 'm1-model-subscription.md', step)]
    auth, auth_sev, quota, quota_sev, judged, auth_unsure, quota_unsure = [], 'ok', [], 'ok', False, False, False
    unreadable = r.state.setdefault('quotaUnreadable', {})
    high = r.state.setdefault('quotaHigh', {})  # slot -> windows that were at or above the warning line
    for row in rows:
        name, slot = '槽位 %s（%s）' % (row['slot'], row['label']), str(row['slot'])
        bad_since = r.state.setdefault('authBad', {})
        if row['status'] == 'connected':
            bad_since.pop(slot, None)
        if row['status'] == 'disconnected' or (row['status'] != 'connected' and r.now - bad_since.setdefault(slot, r.now) >= r.cfg['authConfirmMinutes'] * 60):
            auth.append('%s 授权状态 %s（%s）' % (name, row['status'], row['detail']))
            auth_sev = 'critical'
        elif row['status'] != 'connected':
            auth_unsure = True  # a probe error: judged when the next round sees it again
        elif row['ageSeconds'] is None or row['ageSeconds'] > r.cfg['subscriptionStaleMinutes'] * 60:
            auth.append('%s 状态 %s 没有更新' % (name, ago(row['ageSeconds'] or 0)))
            auth_sev = max(auth_sev, 'warning', key=RANK.get)
        buckets = (row.get('quota') or {}).get('buckets') or []
        measured = {'%s/%s' % (b.get('limitId'), w.get('slot')): w['usedPercent'] for b in buckets for w in b.get('windows', [])
                    if w.get('status') == 'available' and w.get('usedPercent') is not None}
        used = list(measured.values())
        limits = {'limit:%s' % b.get('limitId'): b.get('limitReached') for b in buckets}
        seen = dict(measured, **{k: v for k, v in limits.items() if v is not None})  # what this round has evidence for
        if 'quota' in r.state.get('alerts', {}) and set(high.get(slot, [])) - set(seen):
            quota_unsure = True  # what alerted (a window, a limit flag) is not reported now: not a recovery
        high[slot] = sorted(set(k for k, v in measured.items() if v >= r.cfg['quotaWarnPercent']) |
                            set(k for k, v in limits.items() if v) | (set(high.get(slot, [])) - set(seen)))
        if any(b.get('limitReached') for b in buckets):
            quota.append('%s 额度已用完' % name)
            quota_sev, judged = 'critical', True
        elif used:
            judged = True
            if max(used) >= r.cfg['quotaCriticalPercent']:
                quota_sev = 'critical'
            elif max(used) >= r.cfg['quotaWarnPercent']:
                quota_sev = max(quota_sev, 'warning', key=RANK.get)
            quota.append('%s 额度已用 %d%%' % (name, max(used)))
        if any(b.get('limitReached') for b in buckets) or used:
            unreadable.pop(slot, None)
            continue
        since = unreadable.setdefault(slot, r.now)
        if r.now - since >= r.cfg['subscriptionStaleMinutes'] * 60:
            quota.append('%s 额度已 %s 读不到（%s）' % (name, ago(r.now - since), (row.get('quota') or {}).get('detailCode')))
            quota_sev, judged = max(quota_sev, 'warning', key=RANK.get), True
    r.facts['subscription'] = rows
    out = [finding('subscription', auth_sev, '模型订阅异常', '；'.join(auth), 'm1-model-subscription.md', step)
           if auth_sev != 'ok' or not auth_unsure else unknown('subscription')]
    if judged and not (quota_unsure and quota_sev == 'ok'):
        out.append(finding('quota', quota_sev, '模型订阅额度', '；'.join(quota), 'm1-model-subscription.md', step))
    else:
        out.append(unknown('quota'))
    return out


def check_tunnel(r):
    label = r.cfg['tunnelLabel']
    state, _, last = job_info(label)
    log = (plist_of('~/Library/LaunchAgents/%s.plist' % label) or {}).get('StandardErrorPath', '<plist 里的日志>')
    step = 'launchctl print gui/$(id -u)/%s | head -30; tail -50 %s' % (label, log)
    if state != 'running':
        return [finding('tunnel', 'critical', 'Cloudflare 隧道断开', 'launchd %s %s（上次退出码 %s）' % (label, state, last), 'm1-tunnel.md', step)]
    for url in r.cfg['tunnelMetrics']:
        code, body = http_get(url, 3)
        if code is None:
            continue
        try:
            conns = json.loads(body).get('readyConnections', 0)
        except ValueError:
            conns = 0
        if code == 200 and conns >= 1:
            return [finding('tunnel', 'ok', 'Cloudflare 隧道断开')]
        return [finding('tunnel', 'critical', 'Cloudflare 隧道断开', '%s 返回 %s，就绪连接 %s' % (url, code, conns), 'm1-tunnel.md', step)]
    return [finding('tunnel', 'critical', 'Cloudflare 隧道断开', '进程在，但指标端口都连不上（%s）' % r.cfg['tunnelMetrics'][0], 'm1-tunnel.md', step)]


