def expand(path):
    return os.path.expanduser(path) if isinstance(path, str) else path


def run(cmd, timeout=20, env=None, stdin=None):
    """(exit code, stdout, stderr); 124 on timeout, 127 when it cannot start."""
    full = dict(os.environ, PATH=SYS_PATH)
    full.update(env or {})
    try:
        kw = {'input': stdin} if stdin is not None else {'stdin': subprocess.DEVNULL}
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=full, **kw)
        return p.returncode, p.stdout, p.stderr
    except subprocess.TimeoutExpired:
        return 124, '', 'timed out after %ss' % timeout
    except OSError as err:
        return 127, '', str(err)


def opener(proxy):
    """None: urllib's own choice (macOS system proxy settings); "": direct; else that proxy."""
    if proxy is None:
        return urllib.request.build_opener()
    return urllib.request.build_opener(urllib.request.ProxyHandler({'http': proxy, 'https': proxy} if proxy else {}))


LOCAL = opener('')


def http_get(url, timeout=10, via=LOCAL):
    """(status or None, body bytes or error text)."""
    try:
        with via.open(urllib.request.Request(url, headers={'User-Agent': 'allrice-monitor'}), timeout=timeout) as r:
            return r.status, r.read(4_000_000)
    except urllib.error.HTTPError as err:
        return err.code, (err.read(4_000_000) if err.fp else b'')  # a 503 carries the same diagnostics as a 200
    except Exception as err:  # URLError, timeouts, resets: all mean "not reachable"
        return None, str(getattr(err, 'reason', err)).encode()


def short(text, limit=300):
    text = text.decode('utf-8', 'replace') if isinstance(text, bytes) else str(text)
    text = ' '.join(text.split())
    return text if len(text) <= limit else text[: limit - 1] + '…'


def ago(seconds):
    seconds = max(0, int(seconds))
    if seconds < 3600:
        return '%d 分钟' % max(1, seconds // 60)
    if seconds < 172800:
        return '%.1f 小时' % (seconds / 3600)
    return '%d 天' % (seconds // 86400)


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, value):
    tmp = '%s.%d.tmp' % (path, os.getpid())
    with open(tmp, 'w') as f:
        json.dump(value, f, ensure_ascii=False, indent=1)
    os.replace(tmp, path)


def load_config(path, peer):
    cfg = json.loads(json.dumps(PEER if peer else M1))
    if path is None:
        candidate = os.path.join(expand(cfg['stateDir']), 'config.json')
        path = candidate if os.path.exists(candidate) else None
    if path:
        with open(expand(path)) as f:
            for k, v in json.load(f).items():
                cfg[k] = dict(cfg[k], **v) if isinstance(cfg.get(k), dict) and isinstance(v, dict) else v
    cfg['configFile'] = expand(path) if path else None
    cfg['stateDir'] = expand(cfg['stateDir'])
    cfg['telegramEnv'] = expand(cfg['telegramEnv'] or os.path.join(cfg['stateDir'], 'telegram.env'))
    return cfg


def plist_of(path):
    try:
        with open(expand(path), 'rb') as f:
            return plistlib.load(f)
    except (OSError, plistlib.InvalidFileException, ValueError):
        return None


def env_file(path):
    out = {}
    try:
        with open(expand(path)) as f:
            for line in f:
                m = re.match(r'\s*([A-Za-z_][A-Za-z0-9_]*)=(.*)$', line)
                if m:
                    out[m.group(1)] = m.group(2).strip().strip('"\'')
    except OSError:
        pass
    return out


def derive_m1(cfg):
    """Fill what was left empty from the shared-Dev launchd files and .env."""
    web, worker = plist_of(cfg['webPlist']), plist_of(cfg['workerPlist'])
    wenv = (web or {}).get('EnvironmentVariables', {})
    kenv = (worker or {}).get('EnvironmentVariables', {})
    dotenv = env_file(cfg['envFile'])
    fill = {
        'webLabel': (web or {}).get('Label'),
        'workerLabel': (worker or {}).get('Label'),
        'databaseUrl': kenv.get('DATABASE_URL') or dotenv.get('DATABASE_URL'),
        'webUrl': 'http://127.0.0.1:%s' % wenv['ALLRICE_WEB_PORT'] if wenv.get('ALLRICE_WEB_PORT') else None,
        'workerUrl': 'http://127.0.0.1:%s' % kenv['ALLRICE_WORKER_PORT'] if kenv.get('ALLRICE_WORKER_PORT') else None,
        'publicUrl': wenv.get('ALLRICE_PUBLIC_URL') or dotenv.get('ALLRICE_PUBLIC_URL'),
        # component checks
        'colima': kenv.get('ALLRICE_CLOUD_COLIMA'),
        'colimaProfile': kenv.get('ALLRICE_CLOUD_PROFILE'),
        'officeUrl': kenv.get('ALLRICE_OFFICE_RENDERER_URL'),
        'release': (worker or {}).get('WorkingDirectory'),
        'node': ((worker or {}).get('ProgramArguments') or [None])[0],
        'cloudArchitecture': kenv.get('ALLRICE_CLOUD_ARCHITECTURE', ''),
    }
    for k, v in fill.items():
        if cfg.get(k) is None:
            cfg[k] = v
    if cfg.get('incidentDatabaseUrl') is None:
        cfg['incidentDatabaseUrl'] = cfg['databaseUrl']
    return cfg


def finding(key, severity, title, detail='', runbook='', step=''):
    return {'key': key, 'severity': severity, 'title': title, 'detail': detail, 'runbook': runbook, 'step': step}


def unknown(key, title=''):
    """A key the check cannot judge this round (no evidence either way): an open alert
    stays open and nothing new opens."""
    return finding(key, 'unknown', title)


class Round:
    """One round: its config, the persistent state and what the checks learned. Only a
    real round, holding the lock, moves a corrupt state file aside (recover=True); a dry
    run or another command reads it as empty and leaves it for that round to report."""

    def __init__(self, cfg, peer=False, recover=False):
        self.cfg, self.peer, self.now = cfg, peer, time.time()
        os.makedirs(cfg['stateDir'], mode=0o700, exist_ok=True)
        self.state_file = os.path.join(cfg['stateDir'], 'state.json')
        self.state, self.state_lost = {}, None
        if os.path.exists(self.state_file):
            try:
                with open(self.state_file) as f:
                    self.state = json.load(f)
            except (OSError, ValueError):
                if recover:  # keep the unreadable file for a person, and say so
                    self.state_lost = '%s.corrupt-%d' % (self.state_file, self.now)
                    os.replace(self.state_file, self.state_lost)
                    self.state = {'stateLost': self.state_lost}
        self.facts, self.progress = {}, None

    def save(self):
        write_json(self.state_file, self.state)

    def psql(self, sql, url=None, variables=None, timeout=30, readonly=True):
        return psql(self.cfg, sql, url, variables, timeout, readonly)

    def docker(self, *args, timeout=20):
        sock = os.path.join(expand('~/.colima'), self.cfg['colimaProfile'] or '', 'docker.sock')
        return run([self.cfg['docker']] + list(args), timeout, {'DOCKER_HOST': 'unix://' + sock})


def psql(cfg, sql, url=None, variables=None, timeout=30, readonly=True):
    """Run SQL (on stdin, so :'var' variables work) and return its output."""
    if not url:
        raise CheckError('no database URL configured')
    parts, env = urllib.parse.urlsplit(url), {}
    if parts.password:  # keep it out of `ps`
        env['PGPASSWORD'] = urllib.parse.unquote(parts.password)
        host = parts.hostname + (':%d' % parts.port if parts.port else '')
        url = urllib.parse.urlunsplit(parts._replace(netloc='%s@%s' % (parts.username, host) if parts.username else host))
    cmd = [cfg['psql'], url, '-X', '-q', '-A', '-t', '-v', 'ON_ERROR_STOP=1']
    for k, v in (variables or {}).items():
        cmd += ['-v', '%s=%s' % (k, v)]
    opts = '-c statement_timeout=15000' + (' -c default_transaction_read_only=on' if readonly else '')
    env.update(PGCONNECT_TIMEOUT='5', PGAPPNAME='allrice-monitor', PGOPTIONS=opts)
    rc, out, err = run(cmd, timeout, env, sql)
    if rc:
        raise CheckError(short(err or 'psql exit %d' % rc))
    return out.strip()


# ---------- alert state machine ----------


def evaluate(r, findings, ran=()):
    """Apply one round of findings to the open alerts. Returns the events to notify.
    `ran` names the checks that completed: an open per-item alert of one of them
    ("disk:<path>") whose item it no longer reports (the item left the config) recovers."""
    now, cfg = r.now, r.cfg
    alerts = r.state.setdefault('alerts', {})
    opens = r.state.setdefault('opens', {})
    history = r.state.setdefault('history', [])
    events = []
    reported = {f['key'] for f in findings}
    findings = list(findings) + [finding(k, 'ok', a['title']) for k, a in alerts.items()
                                 if ':' in k and k.split(':', 1)[0] in ran and k not in reported]
    for f in findings:
        key, sev, cur = f['key'], f['severity'], alerts.get(f['key'])
        if sev == 'unknown':
            continue
        if sev == 'ok':
            if cur:
                del alerts[key]
                muted = cur.get('mutedUntil', 0) > now
                events.append({'event': 'recovered', 'finding': f, 'alert': cur, 'silent': muted})
                history.append({'at': now, 'event': 'recovered', 'key': key, 'title': cur['title']})
                incident(r, 'monitor_recovered', 'info', f, cur, event='recovered')
                if muted:  # told once the mute ends, if it is still good then
                    r.state.setdefault('mutedRecoveries', {})[key] = {'title': cur['title'], 'since': cur['since']}
            continue
        if not cur:
            recent = [t for t in opens.get(key, []) if now - t < cfg['flapMinutes'] * 60] + [now]
            opens[key] = recent
            muted_until = r.state.get('muted', {}).get(key, {}).get('mutedUntil', 0)
            cur = alerts[key] = dict(f, since=now, notifiedAt=now, notifiedSeverity=sev, incidentId=str(uuid.uuid4()))
            r.state.get('mutedRecoveries', {}).pop(key, None)
            event = 'opened'
            if muted_until > now:
                cur.update(mutedUntil=muted_until, silentOpen=True)
            elif len(recent) >= cfg['flapLimit']:
                cur['mutedUntil'] = now + cfg['flapMinutes'] * 60
                r.state.setdefault('muted', {})[key] = {'mutedUntil': cur['mutedUntil']}
                event = 'flapping'
            events.append({'event': event, 'finding': f, 'alert': cur, 'silent': muted_until > now})
            history.append({'at': now, 'event': 'opened', 'key': key, 'severity': sev, 'title': f['title']})
            incident(r, 'monitor_alert', sev, f, cur, cur['incidentId'], event=event)
            continue
        escalated = RANK[sev] > RANK[cur['notifiedSeverity']]  # only above the highest already sent
        since, inc, notified, muted = cur['since'], cur['incidentId'], cur['notifiedAt'], cur.get('mutedUntil', 0)
        cur.update(f, since=since, incidentId=inc)
        if escalated:
            cur.update(notifiedAt=now, notifiedSeverity=sev, silentOpen=False, mutedUntil=0)  # told: no longer muted
            r.state.get('muted', {}).pop(key, None)
            events.append({'event': 'escalated', 'finding': f, 'alert': cur, 'silent': False})
            incident(r, 'monitor_alert', sev, f, cur, event='escalated')
        elif muted > now and cur.get('silentOpen') and now - since >= cfg['flapBreakMinutes'] * 60:
            # Opened during a flapping mute and still bad: no longer a flap, an outage.
            cur.update(notifiedAt=now, notifiedSeverity=max(sev, cur['notifiedSeverity'], key=RANK.get), silentOpen=False, mutedUntil=0)
            r.state.get('muted', {}).pop(key, None)
            events.append({'event': 'reminder', 'finding': f, 'alert': cur, 'silent': False})
            incident(r, 'monitor_alert', sev, f, cur, event='reminder')
        elif muted <= now and (cur.get('silentOpen') or now - notified >= cfg['repeatMinutes'][sev] * 60):
            cur.update(notifiedAt=now, notifiedSeverity=max(sev, cur['notifiedSeverity'], key=RANK.get), silentOpen=False)
            events.append({'event': 'reminder', 'finding': f, 'alert': cur, 'silent': False})
            incident(r, 'monitor_alert', sev, f, cur, event='reminder')
    for key in list(r.state.get('muted', {})):
        if r.state['muted'][key]['mutedUntil'] <= now:
            del r.state['muted'][key]
            gone = r.state.get('mutedRecoveries', {}).pop(key, None)
            if gone and key not in alerts:
                events.append({'event': 'recovered', 'finding': finding(key, 'ok', gone['title']), 'alert': gone, 'silent': False})
    for key in list(opens):
        opens[key] = [t for t in opens[key] if now - t < cfg['flapMinutes'] * 60]
        if not opens[key]:
            del opens[key]
    r.state['history'] = [h for h in history if now - h['at'] < 8 * 86400]
    return events


MESSAGE_LIMIT = 3500  # characters; Telegram allows 4096 UTF-16 units per message


def compose(r, events):
    """The messages for one round: everything that changed, split between alerts, never
    inside one, so a long round cannot cut the later alerts off."""
    cfg, now = r.cfg, r.now
    shown = [e for e in events if not e['silent']]
    if not shown:
        return []
    bad = sorted([e for e in shown if e['event'] != 'recovered'], key=lambda e: -RANK[e['finding']['severity']])
    good = [e for e in shown if e['event'] == 'recovered']
    worst = max([RANK[e['finding']['severity']] for e in bad] or [0])
    icon = ICON['critical'] if worst == 2 else ICON['warning'] if worst == 1 else ICON['ok']
    parts = (['%d 项告警' % len(bad)] if bad else []) + (['%d 项恢复' % len(good)] if good else [])
    head = '%s %s%s：%s' % (icon, '[%s] ' % cfg['label'] if cfg['label'] else '', cfg['name'], '，'.join(parts))
    blocks = []
    for e in bad:
        f, a = e['finding'], e['alert']
        tag = {'opened': '', 'escalated': '（升级）', 'reminder': '（仍未恢复，已 %s）' % ago(now - a['since']),
               'flapping': '（1 小时内反复 %d 次，之后 1 小时不再逐条通知）' % cfg['flapLimit']}[e['event']]
        lines = ['%s [%s] %s%s' % (ICON[f['severity']], WORD[f['severity']], f['title'], tag)]
        if f['detail']:
            lines.append('   ' + short(f['detail'], 800))
        if f['step']:
            lines.append('   第一步：' + f['step'])
        if f['runbook']:
            lines.append('   手册：' + cfg['runbooks'] + f['runbook'])
        blocks.append('\n'.join(lines))
    blocks += ['✅ 已恢复：%s（持续 %s）' % (e['alert']['title'], ago(now - e['alert']['since'])) for e in good]
    foot = time.strftime('%m-%d %H:%M', time.localtime(now)) + ' · ' + socket.gethostname().split('.')[0]
    messages, cur = [], []
    for b in blocks:
        if cur and len('\n\n'.join(cur + [b])) > MESSAGE_LIMIT:
            messages.append(cur)
            cur = []
        cur.append(b)
    messages.append(cur)
    n = len(messages)
    return ['\n\n'.join([head + ('（%d/%d）' % (i + 1, n) if n > 1 else '')] + m + [foot]) for i, m in enumerate(messages)]


def incident(r, kind, severity, f, alert, incident_id=None, event=None):
    if not r.cfg.get('incidents'):
        return
    r.state.setdefault('incidentOutbox', []).append({
        'id': incident_id or str(uuid.uuid4()), 'kind': kind, 'severity': severity,
        'detailCode': 'monitor.' + f['key'], 'createdAt': time.strftime('%Y-%m-%dT%H:%M:%S%z', time.localtime(r.now)),
        'metadata': {'source': 'allrice-monitor', 'monitor': r.cfg['name'], 'label': r.cfg['label'], 'host': socket.gethostname(),
                     'event': event, 'title': alert['title'], 'detail': f['detail'] or alert.get('detail', ''),
                     'runbook': alert.get('runbook', ''), 'alertId': alert['incidentId'], 'since': int(alert['since']),
                     'durationSeconds': int(r.now - alert['since'])},
    })


