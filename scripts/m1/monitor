    if closed(row) or deploying(r):
        return None
    oldest = (row['oldest'] or 0) / 60
    sev = 'ok' if not row['count'] else 'critical' if oldest >= b['queue_critical_minutes'] or not row['active'] else 'warning'
    return [finding('business.queue', sev, '队列积压', '%d 个作业到点没人领，最久 %s，正在执行 %d 个；例 %s' % (
