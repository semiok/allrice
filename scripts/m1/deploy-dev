#!/bin/bash
# Release train: deploy a version of AllRice to the shared Dev on M1 (rules: AGENTS.md
# §5 and §9 at the repository root). Only the release manager deploys or rolls back.
#
#   deploy-dev --release-manager [--ref <ref>] [--force] [--skip-smoke]   build, check, switch, restart, smoke
#   deploy-dev --release-manager --rollback [<release-dir>]               back to the release before the current one
#   deploy-dev --release-manager --recover                                finish recovery after an interrupted deploy
#   deploy-dev --status                                                   configured vs running version, lock, recent deploys
#
# deploy-dev takes the deploy lock itself; do not wrap it in `deploy-lock run`.
#
# 1. Build in a new release directory (no lock; the running Dev is untouched).
# 2. Pre-stop check with the candidate: scripts/dev-release/verify-native-retention.mjs.
#    Anything not covered aborts before anything stops.
# 3. Under the deploy lock: stop Web and Worker and wait until both processes are gone,
#    `pnpm db:prepare` (migrate, sync platform content, verify), point launchd at the new
#    release, start Worker then Web, confirm both report the new source SHA.
#    Progress is kept in qa/deploy-inflight/: if a step fails or the script is interrupted
#    (INT/TERM/HUP) it restores the saved launchd files and checks both services are
#    healthy again; if it is killed outright, `--recover` does the same. Database
#    migrations are never reverted, so a restored old version can still fail to start;
#    the script then says so and leaves the state for a person.
# 4. Lock released, then the five-item smoke test. A failed smoke does not roll back by
#    itself (a model hiccup can fail it); it prints the rollback command.
set -euo pipefail
REPO="$HOME/allrice-repo"; RELEASES="$HOME/allrice-dev-releases"; BIN="$HOME/allrice-dev/bin"
STATE="$HOME/allrice-dev/qa"; LOG="$STATE/deploys.jsonl"; INFLIGHT="$STATE/deploy-inflight"
export PATH="$HOME/.local/opt/node-22.23.2/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
UID_=$(id -u); KEEP_RELEASES=3; TASK=release-train; LOCK_TOKEN=""
WEB_LABEL=ai.bplabs.allrice-dev-web; WORKER_LABEL=ai.bplabs.allrice-dev-worker
WEB_PLIST="$HOME/Library/LaunchAgents/$WEB_LABEL.plist"
WORKER_PLIST="$HOME/Library/LaunchAgents/$WORKER_LABEL.plist"

say() { echo "[deploy-dev $(date +%H:%M:%S)] $*"; }
die() { echo "[deploy-dev] FAILED: $1" >&2; exit "${2:-1}"; }
penv() { /usr/bin/python3 -c 'import plistlib,sys;print(plistlib.load(open(sys.argv[1],"rb"))["EnvironmentVariables"].get(sys.argv[2],""))' "$1" "$2"; }
release_of() { /usr/bin/python3 -c 'import plistlib,sys;print(plistlib.load(open(sys.argv[1],"rb"))["WorkingDirectory"])' "$WORKER_PLIST"; }
web_url() { echo "http://127.0.0.1:$(penv "$WEB_PLIST" ALLRICE_WEB_PORT)/api/health/ready"; }
worker_url() { echo "http://127.0.0.1:$(penv "$WORKER_PLIST" ALLRICE_WORKER_PORT)/health/ready"; }
ready_sha() { # prints the sourceSha a service reports as ready, or nothing
  curl -fsS -m 5 "$1" 2>/dev/null | /usr/bin/python3 -c 'import json,sys
try:
  j=json.load(sys.stdin); print(j["identity"]["sourceSha"] if j.get("status")=="ready" else "")
except Exception: print("")' ; }
wait_ready() { # url sha seconds
  local i; for i in $(seq 1 "$3"); do [ "$(ready_sha "$1")" = "$2" ] && return 0; sleep 1; done; return 1; }
log_deploy() { /usr/bin/python3 - "$LOG" "$@" <<'PY'
import json,sys,time
p,*kv=sys.argv[1:]; d=dict(zip(kv[::2],kv[1::2])); d['at']=time.strftime('%Y-%m-%dT%H:%M:%S%z')
open(p,'a').write(json.dumps(d,ensure_ascii=False)+'\n')
PY
}

# A branch may exist locally (worktrees live in ~/allrice-repo) and on origin: use the
# newer one, refuse diverged ones. Anything else (origin/main, a SHA): rev-parse.
resolve_ref() {
  local ref=$1 l r
  l=$(git -C "$REPO" rev-parse --verify -q "refs/heads/$ref^{commit}" 2>/dev/null || true)
  r=$(git -C "$REPO" rev-parse --verify -q "refs/remotes/origin/$ref^{commit}" 2>/dev/null || true)
  if [ -n "$l" ] && [ -n "$r" ]; then
    if git -C "$REPO" merge-base --is-ancestor "$r" "$l"; then echo "$l"
    elif git -C "$REPO" merge-base --is-ancestor "$l" "$r"; then echo "$r"
    else die "local $ref and origin/$ref have diverged; pass a commit with --ref" 2; fi
  elif [ -n "$l$r" ]; then echo "$l$r"
  else git -C "$REPO" rev-parse --verify -q "$ref^{commit}" || die "unknown ref $ref" 2; fi
}

# launchd: bootout returns while the job is still exiting (ExitTimeOut up to 60s), and
# bootstrapping before it is gone fails with "5: Input/output error".
stop_job() { # label -> 0 once the job is unloaded and its port no longer listens
  local i port=$2
  launchctl bootout "gui/$UID_/$1" 2>/dev/null || true
  for i in $(seq 1 90); do
    if ! launchctl print "gui/$UID_/$1" >/dev/null 2>&1 && ! lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then return 0; fi
    sleep 1
  done
  say "$1 did not stop within 90s"; return 1
}
start_job() { # label plist
  local i
  for i in 1 2 3 4 5; do
    if launchctl bootstrap "gui/$UID_" "$2" 2>/dev/null; then launchctl kickstart "gui/$UID_/$1"; return 0; fi
    sleep 3
  done
  say "could not load $1"; return 1
}
stop_both() {
  stop_job "$WEB_LABEL" "$(penv "$WEB_PLIST" ALLRICE_WEB_PORT)" && stop_job "$WORKER_LABEL" "$(penv "$WORKER_PLIST" ALLRICE_WORKER_PORT)"
}

# Point both plists at a release: script paths, working dirs, cordis config, SHA, and
# (only when given) the approved native artifact.
point_plists() { # release sha artifact|""
  /usr/bin/python3 - "$WEB_PLIST" "$WORKER_PLIST" "$1" "$2" "$3" <<'PY'
import json,os,plistlib,sys
web,worker,rel,sha,art=sys.argv[1:]
for p,role in ((web,'web'),(worker,'worker')):
    d=plistlib.load(open(p,'rb')); e=d['EnvironmentVariables']
    args=d['ProgramArguments']
    args[2]=f'{rel}/apps/web/server.mjs' if role=='web' else f'{rel}/apps/worker/dist/index.js'
    d['WorkingDirectory']=f'{rel}/apps/web' if role=='web' else rel
    e['ALLRICE_DSH_CORDIS_CONFIG']=f'{rel}/apps/worker/dsh/allrice-restricted.cordis.yml'
    e['ALLRICE_RELEASE_SHA']=sha
    if art:
        e['ALLRICE_DSH_NATIVE_ARTIFACT_ID']=art; e['ALLRICE_DSH_NEW_ROOT_ARTIFACT_ID']=art
        ids=json.loads(e.get('ALLRICE_CHECKED_DELIVERY_ARTIFACT_IDS','[]'))
        if art not in ids: ids.append(art)
        e['ALLRICE_CHECKED_DELIVERY_ARTIFACT_IDS']=json.dumps(ids)
    tmp=p+'.tmp'; plistlib.dump(d,open(tmp,'wb')); os.chmod(tmp,0o600); os.replace(tmp,p)
PY
}
start_both_on() { # sha -> start Worker then Web, both must report sha
  start_job "$WORKER_LABEL" "$WORKER_PLIST" || return 1
  wait_ready "$(worker_url)" "$1" 180 || { say "worker did not become ready on ${1:0:8}"; return 1; }
  start_job "$WEB_LABEL" "$WEB_PLIST" || return 1
  wait_ready "$(web_url)" "$1" 120 || { say "web did not become ready on ${1:0:8}"; return 1; }
}

# --- in-flight state: what to restore if this run cannot finish ---
inflight_begin() { # phase prev_sha
  mkdir -p "$INFLIGHT"; cp -p "$WEB_PLIST" "$INFLIGHT/web.plist"; cp -p "$WORKER_PLIST" "$INFLIGHT/worker.plist"
  printf '%s\n%s\n' "$1" "$2" > "$INFLIGHT/state"
}
inflight_phase() { [ -f "$INFLIGHT/state" ] && { printf '%s\n' "$1" > "$INFLIGHT/state.tmp"; sed -n 2p "$INFLIGHT/state" >> "$INFLIGHT/state.tmp"; mv "$INFLIGHT/state.tmp" "$INFLIGHT/state"; }; return 0; }
inflight_end() { rm -rf -- "$INFLIGHT"; }
# Restore the saved launchd files, restart both, and check they come back on prev_sha.
restore() { # -> 0 healthy, 1 not
  local prev; prev=$(sed -n 2p "$INFLIGHT/state")
  say "restoring the previous version ${prev:0:8}"
  stop_both || true
  cp -p "$INFLIGHT/web.plist" "$WEB_PLIST"; cp -p "$INFLIGHT/worker.plist" "$WORKER_PLIST"
  if start_both_on "$prev"; then say "previous version ${prev:0:8} is healthy again"; return 0; fi
  say "previous version ${prev:0:8} did NOT come back healthy (migrations applied by the new version stay)."
  say "Needs a person: see ~/Library/Logs/allrice-dev-*.err.log; the saved launchd files are in $INFLIGHT"
  return 1
}
release_lock() { [ -n "$LOCK_TOKEN" ] && "$BIN/deploy-lock" release "$TASK" --token "$LOCK_TOKEN" >/dev/null 2>&1; LOCK_TOKEN=""; return 0; }
on_interrupt() {
  trap - INT TERM HUP
  local phase; phase=$(sed -n 1p "$INFLIGHT/state" 2>/dev/null || echo none)
  say "interrupted during '$phase'"
  if [ "$phase" != none ]; then
    if restore; then inflight_end; log_deploy kind failed phase "$phase" reason interrupted restored yes
    else log_deploy kind failed phase "$phase" reason interrupted restored no; fi
  fi
  release_lock; exit 130
}
fail_and_restore() { # phase message
  if restore; then inflight_end; log_deploy kind failed phase "$1" reason "$2" restored yes; release_lock; die "$2; previous version restored and healthy. See ${BLOG:-the deploy log}"
  else log_deploy kind failed phase "$1" reason "$2" restored no; release_lock; die "$2; previous version did NOT come back. Needs a person (deploy-dev --release-manager --recover after fixing)"; fi
}
take_lock() { # minutes
  LOCK_TOKEN=$("$BIN/deploy-lock" acquire "$TASK" "$1" --pid $$) || { LOCK_TOKEN=""; return 3; }
  trap 'release_lock' EXIT
  trap 'on_interrupt' INT TERM HUP
}

# Pre-stop check: does the candidate cover every chat, origin and schedule control that
# exists now? Runs the candidate's own verifier against the live database.
precheck() { # rel sha art log
  if ( cd "$1" && "$BIN/with-env" worker env ALLRICE_DSH_NATIVE_ARTIFACT_ID="$3" ALLRICE_DSH_NEW_ROOT_ARTIFACT_ID="$3" \
         ALLRICE_DSH_CORDIS_CONFIG="$1/apps/worker/dsh/allrice-restricted.cordis.yml" \
         node scripts/dev-release/verify-native-retention.mjs --root="$1" --release-sha="$2" ) >> "$4" 2>&1; then return 0; fi
  local reason; reason=$(grep -oE "(DSH_NATIVE_[A-Z_]+|NATIVE_RETENTION_[A-Z_]+)( \[.{0,250})?" "$4" | tail -1 || true)
  if grep -qE 'relation "[^"]+" does not exist' "$4"; then
    echo "the candidate's checker needs tables from migrations not yet applied; this release needs the official two-step procedure (docs/dev-test-execution-retirement.md), not deploy-dev"
  elif [[ "$reason" == *UNCOVERED* ]]; then
    echo "existing chats or schedules use a native artifact this version does not cover: ${reason:0:300}. Needs the MET-195 transition or retiring those contexts first"
  else echo "pre-stop native check failed: ${reason:-see $4}"; fi
  return 1
}

discard() { git -C "$REPO" worktree remove --force "$1" 2>/dev/null || rm -rf -- "$1"; git -C "$REPO" worktree prune; }

status() {
  local rel; rel=$(release_of)
  echo "configured release: $rel"
  echo "configured sha:     $(penv "$WORKER_PLIST" ALLRICE_RELEASE_SHA)"
  echo "running sha:        web $(ready_sha "$(web_url)" | cut -c1-8 || true)  worker $(ready_sha "$(worker_url)" | cut -c1-8 || true)  (empty = not ready)"
  echo "native artifact:    $(penv "$WORKER_PLIST" ALLRICE_DSH_NATIVE_ARTIFACT_ID)"
  echo "tools version:      $(cat "$BIN/TOOLS_VERSION" 2>/dev/null || echo unknown)"
  [ -f "$INFLIGHT/state" ] && echo "INTERRUPTED DEPLOY in phase '$(sed -n 1p "$INFLIGHT/state")': run deploy-dev --release-manager --recover"
  "$BIN/deploy-lock" status || true
  [ -f "$LOG" ] && { echo "recent deploys:"; tail -5 "$LOG"; }
  return 0
}

recover() {
  [ -f "$INFLIGHT/state" ] || die "nothing to recover (no interrupted deploy recorded)"
  take_lock 15 || die "deploy lock is held; $("$BIN/deploy-lock" status)" 3
  local phase; phase=$(sed -n 1p "$INFLIGHT/state")
  if restore; then inflight_end; log_deploy kind recover phase "$phase" restored yes; say "recovered"
  else die "recovery did not bring the previous version back; see above"; fi
}

prune_releases() { # keep the current, the previous and the newest KEEP_RELEASES deploy-created ones
  local current previous; current=$(release_of)
  previous=$(sed -n 1p "$STATE/.previous-release" 2>/dev/null || true)
  ls -1dt "$RELEASES"/20[0-9][0-9][0-9][0-9][0-9][0-9]-* 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | while read -r old; do
    [ "$old" = "$current" ] || [ "$old" = "$previous" ] && continue
    git -C "$REPO" worktree remove --force "$old" 2>/dev/null || rm -rf -- "$old"
    say "pruned old release $(basename "$old")"
  done
  git -C "$REPO" worktree prune
}

# Facts about a release recorded by an earlier deploy: "sha artifact".
release_facts() {
  /usr/bin/python3 - "$LOG" "$1" <<'PY'
import json,sys
log,rel=sys.argv[1:]
for line in reversed(open(log).read().splitlines()):
    try: d=json.loads(line)
    except Exception: continue
    for side in ('to','from'):
        if d.get(side+'Release')==rel and d.get(side+'Sha'):
            print(d[side+'Sha'], d.get(side+'Artifact','')); sys.exit(0)
sys.exit(1)
PY
}

rollback() { # [release-dir]
  local cur_rel cur_sha cur_art target="${1:-}"
  cur_rel=$(release_of); cur_sha=$(penv "$WORKER_PLIST" ALLRICE_RELEASE_SHA); cur_art=$(penv "$WORKER_PLIST" ALLRICE_DSH_NATIVE_ARTIFACT_ID)
  if [ -z "$target" ]; then
    target=$(sed -n 1p "$STATE/.previous-release" 2>/dev/null || true)
    [ -n "$target" ] && [ "$(sed -n 2p "$STATE/.previous-release")" = "$cur_rel" ] \
      || die "no recorded previous release for the current one ($cur_rel); pass the target: --rollback <release-dir>"
  fi
  [ -d "$target" ] || die "release directory is gone: $target"
  [ "$target" != "$cur_rel" ] || die "Dev already runs $target"
  local facts sha art; facts=$(release_facts "$target") || die "no recorded SHA/artifact for $target"
  read -r sha art <<<"$facts"
  # An older binary refuses a database that has migrations it does not know (db:verify).
  local newer; newer=$(comm -13 <(ls "$target/packages/database/migrations" | sort) <(ls "$cur_rel/packages/database/migrations" | sort) || true)
  [ -z "$newer" ] || die "cannot roll back to ${sha:0:8}: the database already has migrations it does not know: $(echo $newer | cut -c1-200)"
  mkdir -p "$STATE/deploy-logs"; BLOG="$STATE/deploy-logs/rollback-$(date +%Y%m%d-%H%M%S).log"
  say "checking that ${sha:0:8} covers the current native references"
  local why; why=$(precheck "$target" "$sha" "$art" "$BLOG") || die "$why. Dev untouched."
  take_lock 15 || die "deploy lock is held; $("$BIN/deploy-lock" status)" 3
  [ "$(release_of)" = "$cur_rel" ] || die "the current release changed while checking; start again"
  say "rolling back to $(basename "$target") (${sha:0:8}); database migrations are not reverted"
  inflight_begin stopping "$cur_sha"
  stop_both || fail_and_restore stopping "services did not stop"
  inflight_phase switching
  point_plists "$target" "$sha" "$([ "$art" != "$cur_art" ] && echo "$art")"
  start_both_on "$sha" || fail_and_restore switching "rollback target did not become healthy"
  inflight_end; release_lock
  # A second --rollback must name its target: rolling back is not a stack.
  rm -f "$STATE/.previous-release"
  log_deploy kind rollback fromRelease "$cur_rel" fromSha "$cur_sha" fromArtifact "$cur_art" toRelease "$target" toSha "$sha" toArtifact "$art"
  say "rolled back; Dev runs ${sha:0:8}"
}

deploy() {
  local ref=origin/main force=0 smoke=1
  while [ $# -gt 0 ]; do case "$1" in
    --ref) ref=${2:?}; shift 2 ;; --force) force=1; shift ;; --skip-smoke) smoke=0; shift ;;
    *) die "unknown option $1" 2 ;; esac; done
  local t0; t0=$(date +%s)
  [ ! -f "$INFLIGHT/state" ] || die "an earlier deploy was interrupted; run deploy-dev --release-manager --recover first"
  local avail; avail=$(df -g "$HOME" | awk 'NR==2{print $4}')
  [ "$avail" -ge 20 ] || die "only ${avail}G free; clean up before building"
  "$BIN/deploy-lock" status >/dev/null || die "deploy lock is held ($("$BIN/deploy-lock" status)); stop and retry later" 3

  git -C "$REPO" fetch -q origin
  local sha; sha=$(resolve_ref "$ref")
  local cur_rel cur_sha cur_art; cur_rel=$(release_of); cur_sha=$(penv "$WORKER_PLIST" ALLRICE_RELEASE_SHA); cur_art=$(penv "$WORKER_PLIST" ALLRICE_DSH_NATIVE_ARTIFACT_ID)
  if [ "$sha" = "$cur_sha" ] && [ $force = 0 ]; then say "Dev already runs ${sha:0:8}; nothing to deploy (use --force to rebuild)"; return 0; fi

  local rel; rel="$RELEASES/$(date +%Y%m%d-%H%M)-${sha:0:8}"
  [ -e "$rel" ] && die "release directory exists: $rel"
  mkdir -p "$STATE/deploy-logs"; BLOG="$STATE/deploy-logs/$(basename "$rel").log"
  say "building ${sha:0:8} ($ref) in $(basename "$rel"); log: $BLOG"
  git -C "$REPO" worktree add -q --detach "$rel" "$sha"
  trap 'discard "$rel"; say "interrupted while building; build removed, Dev untouched"; exit 130' INT TERM HUP
  ( cd "$rel" && pnpm install --frozen-lockfile && \
    pnpm -r --workspace-concurrency=1 --filter '@allrice/worker...' --filter '@allrice/web...' --if-present run build ) > "$BLOG" 2>&1 \
    || { discard "$rel"; log_deploy kind failed phase build sha "$sha" log "$BLOG"; die "build failed; see $BLOG (Dev untouched)"; }
  local art
  art=$(cd "$rel" && node apps/worker/scripts/prepare-native-artifact.mjs --root="$PWD" 2>>"$BLOG" | tail -1 | /usr/bin/python3 -c 'import json,sys;print(json.load(sys.stdin)["artifactId"])') \
    || { discard "$rel"; log_deploy kind failed phase artifact sha "$sha" log "$BLOG"; die "native artifact preparation failed; see $BLOG (Dev untouched)"; }
  ( cd "$rel" && node scripts/dev-release/prepare-identity.mjs --root="$rel" --release-sha="$sha" ) >> "$BLOG" 2>&1 \
    || { discard "$rel"; log_deploy kind failed phase identity sha "$sha" log "$BLOG"; die "build identity failed; see $BLOG (Dev untouched). Versions before PR #533 cannot seal identity on M1."; }
  say "built in $(( $(date +%s) - t0 ))s; native artifact ${art:7:12}… ($([ "$art" = "$cur_art" ] && echo unchanged || echo CHANGED))"

  say "pre-stop check: does ${sha:0:8} cover the current chats and schedule controls?"
  local why; if ! why=$(precheck "$rel" "$sha" "$art" "$BLOG"); then
    discard "$rel"; log_deploy kind failed phase precheck sha "$sha" reason "$why" log "$BLOG"; die "$why. Dev untouched." 4
  fi

  take_lock 20 || die "deploy lock was taken meanwhile; build kept at $rel (rerun deploy-dev later)" 3
  [ "$(release_of)" = "$cur_rel" ] || die "Dev changed while this version was building; build kept at $rel, start again"
  local down_at; down_at=$(date +%s)
  inflight_begin stopping "$cur_sha"
  say "stopping web and worker"
  stop_both || fail_and_restore stopping "services did not stop"
  inflight_phase migrating
  say "db:prepare (migrate, sync platform content, verify)"
  ( cd "$rel" && "$BIN/with-env" worker pnpm db:prepare ) >> "$BLOG" 2>&1 || fail_and_restore migrating "db:prepare failed; see $BLOG"
  inflight_phase switching
  point_plists "$rel" "$sha" "$([ "$art" != "$cur_art" ] && echo "$art")"
  start_both_on "$sha" || fail_and_restore switching "${sha:0:8} did not become healthy"
  local downtime=$(( $(date +%s) - down_at ))
  inflight_end; release_lock
  printf '%s\n%s\n' "$cur_rel" "$rel" > "$STATE/.previous-release"
  say "Dev now runs ${sha:0:8} (downtime ${downtime}s); lock released"
  log_deploy kind deploy fromRelease "$cur_rel" fromSha "$cur_sha" fromArtifact "$cur_art" toRelease "$rel" toSha "$sha" toArtifact "$art" ref "$ref" downtimeSeconds "$downtime"
  prune_releases

  if [ $smoke = 1 ]; then
    say "running five-item smoke test"
    local ok=0; "$BIN/smoke-test" --dev && ok=1
    local res; res=$(ls -1dt "$STATE/smoke/"*/ 2>/dev/null | head -1)
    local ran; ran=$(/usr/bin/python3 -c 'import json,sys;d=json.load(open(sys.argv[1]));print(d.get("sourceShaStart",""),d.get("sourceShaEnd",""))' "${res}result.json" 2>/dev/null || echo "? ?")
    log_deploy kind smoke sha "$sha" ranOn "$ran" result "$([ $ok = 1 ] && echo passed || echo failed)" out "$res"
    [ $ok = 1 ] || die "smoke test failed on ${sha:0:8}. Inspect ${res:-the newest ~/allrice-dev/qa/smoke/ result}; to switch back run: deploy-dev --release-manager --rollback" 5
    say "smoke passed"
  fi
  say "done in $(( $(date +%s) - t0 ))s"
}

# --release-manager is a deliberate speed bump: a session the user did not appoint as
# release manager stops here and writes its deploy request on its MET card instead.
RM=0; ARGS=()
for a in "$@"; do if [ "$a" = --release-manager ]; then RM=1; else ARGS+=("$a"); fi; done
set -- ${ARGS[@]+"${ARGS[@]}"}
need_rm() {
  [ "$RM" = 1 ] || die "only the release manager deploys or rolls back the shared Dev (AGENTS.md §9 at the repository root). If the user appointed you, add --release-manager; otherwise write the deploy request on your MET card and stop." 6
}

case "${1:-}" in
  --status) status ;;
  --rollback) need_rm; shift; rollback "${1:-}" ;;
  --recover) need_rm; recover ;;
  -h|--help) sed -n 2,26p "$0" ;;
  *) need_rm; deploy "$@" ;;
esac
