#!/bin/bash
# Release train: deploy a version of AllRice to the shared Dev on M1 (rules: AGENTS.md
# §5 and §9 at the repository root). Only the release manager deploys or rolls back.
#
#   deploy-dev --release-manager [--ref <ref>] [--force] [--skip-smoke] [--force-snapshot]
#                                                        build, check, switch, restart, smoke
#   deploy-dev --release-manager --rollback [<release-dir>]   back to the release before the current one
#   deploy-dev --release-manager --recover                    restore after a deploy that could not finish
#   deploy-dev --status        configured vs running version, journal contract, rollback check, lock, recent deploys
#
# deploy-dev takes the deploy lock itself; do not wrap it in `deploy-lock run`.
#
# 1. Build in a new release directory (no lock; the running Dev is untouched).
# 2. Pre-stop check with the candidate: scripts/dev-release/verify-native-retention.mjs.
#    Anything not covered aborts before anything stops.
# 3. Under the deploy lock: refuse a database with migrations the candidate does not know
#    (or with none at all), or with journals above contract 1 for a candidate that
#    predates the journal contract (a rollback checks both before anything stops);
#    stop Web and Worker and wait until launchd has dropped both jobs, their processes
#    have exited and their ports are closed; when the candidate has migrations not yet
#    applied (or with --force-snapshot), snapshot the database, the state directories,
#    .env and both launchd files into qa/pre-migrate/<release>/ (newest two kept; restore:
#    docs/runbooks/m1-database.md); `pnpm db:prepare` (migrate, sync platform content,
#    verify); point launchd at the new release; start Worker then Web and confirm both
#    report the new source SHA.
#    The previous launchd files are saved in qa/deploy-inflight/ first. However this run
#    ends before success (a failed step, set -e, INT/TERM/HUP) it puts them back,
#    restarts both services and checks they are healthy on the previous version. If it is
#    killed outright, `--recover` does the same. Database migrations are never reverted,
#    so the previous version can still fail to start: then it says so, keeps the saved
#    files and leaves the rest to a person.
# 4. Records written, lock released, then the smoke test against the expected
#    version. A failed smoke does not roll back by itself; it prints the rollback command.
set -euo pipefail
BIN=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P); . "$BIN/lib.sh"
REPO="$HOME/allrice-repo"; RELEASES="$HOME/allrice-dev-releases"
STATE="$HOME/allrice-dev/qa"; LOG="$STATE/deploys.jsonl"; INFLIGHT="$STATE/deploy-inflight"
LOCK="$HOME/allrice-dev/.local/deploy.lock"; SNAPSHOTS="$STATE/pre-migrate"; KEEP_SNAPSHOTS=2
export PATH="$HOME/.local/opt/node-22.23.2/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
KEEP_RELEASES=3; BLOG=""; FAIL_REASON=""; INFLIGHT_MINE=""; LOCKED=""; BUILD_DIR=""; BUILT=""
WEB_LABEL=ai.bplabs.allrice-dev-web; WORKER_LABEL=ai.bplabs.allrice-dev-worker
WEB_PLIST="$HOME/Library/LaunchAgents/$WEB_LABEL.plist"
WORKER_PLIST="$HOME/Library/LaunchAgents/$WORKER_LABEL.plist"

say() { echo "[deploy-dev $(date +%H:%M:%S)] $*"; }
die() { FAIL_REASON=$1; echo "[deploy-dev] FAILED: $1" >&2; exit "${2:-1}"; }
penv() { "$M1_PY" -c 'import plistlib,sys;print(plistlib.load(open(sys.argv[1],"rb"))["EnvironmentVariables"].get(sys.argv[2],""))' "$1" "$2"; }
release_of() { "$M1_PY" -c 'import plistlib,sys;print(plistlib.load(open(sys.argv[1],"rb"))["WorkingDirectory"])' "$WORKER_PLIST"; }
web_port() { penv "$WEB_PLIST" ALLRICE_WEB_PORT; }
worker_port() { penv "$WORKER_PLIST" ALLRICE_WORKER_PORT; }
ready_sha() { # prints the sourceSha a service reports as ready, or nothing
  curl -fsS -m 5 "$1" 2>/dev/null | "$M1_PY" -c 'import json,sys
try:
  j=json.load(sys.stdin); print(j["identity"]["sourceSha"] if j.get("status")=="ready" else "")
except Exception: print("")' ; }
worker_boot() { # prints the bootId the ready Worker reports, or nothing; never fails
  { curl -fsS -m 5 "http://127.0.0.1:$(worker_port)/health/ready" 2>/dev/null || true; } | "$M1_PY" -c 'import json,re,sys
try: b=str(json.load(sys.stdin)["identity"]["bootId"])
except Exception: b=""
print(b if re.fullmatch("[0-9a-f-]{36}",b) else "")' ; }
wait_ready() { # url sha seconds
  local i; for i in $(seq 1 "$3"); do [ "$(ready_sha "$1")" = "$2" ] && return 0; sleep 1; done; return 1; }
dev_sql() { "$BIN/with-env" worker sh -c 'psql "$DATABASE_URL" -X -v ON_ERROR_STOP=1 -At -F " " -c "$1"' sh "$1"; }
log_deploy() { "$M1_PY" - "$LOG" "$@" <<'PY'
import json,sys,time
p,*kv=sys.argv[1:]; d=dict(zip(kv[::2],kv[1::2])); d['at']=time.strftime('%Y-%m-%dT%H:%M:%S%z')
open(p,'a').write(json.dumps(d,ensure_ascii=False)+'\n')
PY
}

# A branch may exist locally (worktrees live in ~/allrice-repo) and on origin: use the
# newer one, refuse diverged ones. Anything else (origin/main, a SHA): rev-parse.
resolve_ref() {
  local ref=$1 l r
  l=$(git -C "$REPO" rev-parse --verify -q "refs/heads/$ref^{commit}" 2>/dev/null || true)
  r=$(git -C "$REPO" rev-parse --verify -q "refs/remotes/origin/$ref^{commit}" 2>/dev/null || true)
  if [ -n "$l" ] && [ -n "$r" ]; then
    if git -C "$REPO" merge-base --is-ancestor "$r" "$l"; then echo "$l"
    elif git -C "$REPO" merge-base --is-ancestor "$l" "$r"; then echo "$r"
    else die "local $ref and origin/$ref have diverged; pass a commit with --ref" 2; fi
  elif [ -n "$l$r" ]; then echo "$l$r"
  else git -C "$REPO" rev-parse --verify -q "$ref^{commit}" || die "unknown ref $ref" 2; fi
}

stop_both() { stop_job "$WEB_LABEL" "$(web_port)" && stop_job "$WORKER_LABEL" "$(worker_port)"; }
# Diagnostic only, never a gate (MET-221 D13): what the stopped Worker boot left behind.
report_after_stop() { # boot of the stopped Worker, or ""
  local open="" live
  if [ -n "$1" ]; then
    open=$(dev_sql "select count(*) from allrice_dsh_runtime_close_observations o where o.worker_boot_id='$1'
      and o.observation_kind='owned' and not exists (select 1 from allrice_dsh_runtime_close_observations c
      where c.runtime_id=o.runtime_id and c.worker_boot_id=o.worker_boot_id and c.observation_kind='process_closed')" 2>&1) || open="? (${open:0:120})"
  fi
  live=$(dev_sql "select count(*) from allrice_dsh_runtime_instances where status='live'" 2>&1) || live="? (${live:0:120})"
  say "after stop (diagnostic, not a gate): stopped boot ${1:-unknown}: ${open:-?} runtimes owned without process_closed; $live live rows in allrice_dsh_runtime_instances"
}

# Pre-migration snapshot. Both services are stopped, so the database and the state
# directories are one point in time: the dump format and directories of backup-daily
# (restore: docs/runbooks/m1-database.md) as APFS clones, plus .env and both launchd files.
SNAPSHOT_DIRS="storage executions dsh-runtime-m1 native-once-control-m1 native-recurring-control-m1 dsh-platform"
snapshot() ( # name -> 0 when $SNAPSHOTS/<name> is complete
  umask 077
  dir="$SNAPSHOTS/$1" L="$HOME/allrice-dev/.local"
  [ ! -e "$dir" ] || { echo "$dir already exists" >&2; exit 1; }
  trap 'rm -rf -- "$dir.tmp"' EXIT # a partial snapshot is never left behind
  # Under the deploy lock no other snapshot runs: any *.tmp is left over from a killed run.
  mkdir -p "$SNAPSHOTS" && rm -rf -- "$SNAPSHOTS"/*.tmp && mkdir "$dir.tmp" || exit 1
  "$BIN/with-env" worker sh -c 'pg_dump -Fp --no-owner --no-privileges "$DATABASE_URL"' | gzip -6 > "$dir.tmp/allrice_dev.sql.gz" || exit 1
  for d in $SNAPSHOT_DIRS; do [ ! -e "$L/$d" ] || cp -c -pR "$L/$d" "$dir.tmp/$d" || exit 1; done
  cp -p "$HOME/allrice-dev/.env" "$dir.tmp/env" && cp -p "$WEB_PLIST" "$dir.tmp/web.plist" && cp -p "$WORKER_PLIST" "$dir.tmp/worker.plist" || exit 1
  mv "$dir.tmp" "$dir" || exit 1
  # Pruning is best effort: the new snapshot is complete either way.
  ls -1d "$SNAPSHOTS"/2*/ | grep -v '\.tmp/$' | sort -r | tail -n +$((KEEP_SNAPSHOTS + 1)) \
    | while read -r old; do rm -rf -- "$old" || echo "could not prune $old" >&2; done
  exit 0
)
start_both_on() { # sha -> start Worker then Web, both must report sha
  start_job "$WORKER_LABEL" "$WORKER_PLIST" || return 1
  wait_ready "http://127.0.0.1:$(worker_port)/health/ready" "$1" 180 || { say "worker did not become ready on ${1:0:8}"; return 1; }
  start_job "$WEB_LABEL" "$WEB_PLIST" || return 1
  wait_ready "http://127.0.0.1:$(web_port)/api/health/ready" "$1" 120 || { say "web did not become ready on ${1:0:8}"; return 1; }
}

# Point both plists at a release: script paths, working dirs, cordis config, SHA, and
# (only when given) the approved native artifact.
point_plists() { # release sha artifact|""
  "$M1_PY" - "$WEB_PLIST" "$WORKER_PLIST" "$1" "$2" "$3" <<'PY'
import json,os,plistlib,sys
web,worker,rel,sha,art=sys.argv[1:]
for p,role in ((web,'web'),(worker,'worker')):
    d=plistlib.load(open(p,'rb')); e=d['EnvironmentVariables']
    args=d['ProgramArguments']
    args[2]=f'{rel}/apps/web/server.mjs' if role=='web' else f'{rel}/apps/worker/dist/index.js'
    d['WorkingDirectory']=f'{rel}/apps/web' if role=='web' else rel
    e['ALLRICE_DSH_CORDIS_CONFIG']=f'{rel}/apps/worker/dsh/allrice-restricted.cordis.yml'
    e['ALLRICE_RELEASE_SHA']=sha
    if art:
        e['ALLRICE_DSH_NATIVE_ARTIFACT_ID']=art; e['ALLRICE_DSH_NEW_ROOT_ARTIFACT_ID']=art
        ids=json.loads(e.get('ALLRICE_CHECKED_DELIVERY_ARTIFACT_IDS','[]'))
        if art not in ids: ids.append(art)
        e['ALLRICE_CHECKED_DELIVERY_ARTIFACT_IDS']=json.dumps(ids)
    tmp=p+'.tmp'; plistlib.dump(d,open(tmp,'wb')); os.chmod(tmp,0o600); os.replace(tmp,p)
PY
}

# --- lock and in-flight state ---
take_lock() { # -> 0 held, 3 busy
  mkdir -p "$(dirname "$LOCK")"
  exec 9>>"$LOCK"
  if ! flock_fd 9 0; then exec 9>&-; return 3; fi
  LOCKED=1
  "$M1_PY" -c 'import json,os,sys,time
json.dump({"task":"release-train","pid":int(sys.argv[2]),"startedAt":int(time.time()),"command":"deploy-dev "+sys.argv[3]},open(sys.argv[1]+".tmp","w"))
os.replace(sys.argv[1]+".tmp",sys.argv[1])' "$LOCK.owner" $$ "${MODE:-}"
}
release_lock() { if [ -n "$LOCKED" ]; then exec 9>&-; LOCKED=""; fi; return 0; }
inflight_begin() { # prev_sha
  [ ! -e "$INFLIGHT" ] || die "an earlier deploy did not finish (qa/deploy-inflight exists); run deploy-dev --release-manager --recover"
  mkdir -p "$INFLIGHT.tmp"
  cp -p "$WEB_PLIST" "$INFLIGHT.tmp/web.plist" && cp -p "$WORKER_PLIST" "$INFLIGHT.tmp/worker.plist" || die "could not save the launchd files"
  printf 'stopping\n%s\n' "$1" > "$INFLIGHT.tmp/state"
  mv "$INFLIGHT.tmp" "$INFLIGHT"; INFLIGHT_MINE=1
}
inflight_phase() { printf '%s\n%s\n' "$1" "$(sed -n 2p "$INFLIGHT/state")" > "$INFLIGHT/state.tmp" && mv "$INFLIGHT/state.tmp" "$INFLIGHT/state"; }
inflight_end() { rm -rf -- "$INFLIGHT"; INFLIGHT_MINE=""; }
# Put the saved launchd files back, restart both and check they are healthy on the
# previous SHA. Every step is checked: on any failure the saved files stay for a person.
restore() {
  local prev; prev=$(sed -n 2p "$INFLIGHT/state" 2>/dev/null) && [ -n "$prev" ] || { say "no saved previous version to restore"; return 1; }
  say "restoring the previous version ${prev:0:8}"
  stop_both || { say "could not stop the services to restore them"; return 1; }
  cp -p "$INFLIGHT/web.plist" "$WEB_PLIST" && cp -p "$INFLIGHT/worker.plist" "$WORKER_PLIST" \
    && cmp -s "$INFLIGHT/web.plist" "$WEB_PLIST" && cmp -s "$INFLIGHT/worker.plist" "$WORKER_PLIST" \
    || { say "could not put back the saved launchd files from $INFLIGHT"; return 1; }
  # The new Worker may have raised the journal contract: never start a version that cannot read it.
  local why rc=0; why=$(check_contract_known "$(release_of)") || rc=$?
  [ "$rc" != 2 ] || { say "not starting ${prev:0:8}: $why. Deploy a version that knows the contract (move $INFLIGHT aside first)"; return 1; }
  start_both_on "$prev" || { say "previous version ${prev:0:8} did NOT come back healthy (migrations applied by the new version stay)"; return 1; }
  say "previous version ${prev:0:8} is healthy again"
}
# One exit path for every way this run can end before success.
on_exit() { # rc
  local rc=$1
  trap - EXIT INT TERM HUP
  # A build that did not get past the pre-stop check is removed; a checked one is kept.
  if [ -n "$BUILD_DIR" ] && [ -z "$BUILT" ]; then discard "$BUILD_DIR" || true; fi
  if [ -n "$INFLIGHT_MINE" ] && [ -f "$INFLIGHT/state" ]; then
    local phase; phase=$(sed -n 1p "$INFLIGHT/state")
    say "did not finish (phase '$phase', exit $rc)"
    if restore; then
      log_deploy kind failed phase "$phase" reason "${FAIL_REASON:-exit $rc}" restored yes log "$BLOG" || true
      inflight_end
    else
      log_deploy kind failed phase "$phase" reason "${FAIL_REASON:-exit $rc}" restored no log "$BLOG" || true
      echo "[deploy-dev] Dev may be down. Saved launchd files: $INFLIGHT. After fixing the cause: deploy-dev --release-manager --recover" >&2
    fi
  fi
  release_lock
  exit "$rc"
}
trap 'on_exit $?' EXIT
trap 'exit 130' INT TERM HUP

# Pre-stop check: does the candidate cover every chat, origin and schedule control that
# exists now? Runs the candidate's own verifier against the live database.
precheck() { # rel sha art log -> prints the reason on failure
  local from; from=$(( $([ -f "$4" ] && wc -l < "$4" || echo 0) + 1 )) # read only this check's output
  if ( cd "$1" && "$BIN/with-env" worker env ALLRICE_DSH_NATIVE_ARTIFACT_ID="$3" ALLRICE_DSH_NEW_ROOT_ARTIFACT_ID="$3" \
         ALLRICE_DSH_CORDIS_CONFIG="$1/apps/worker/dsh/allrice-restricted.cordis.yml" \
         node scripts/dev-release/verify-native-retention.mjs --root="$1" --release-sha="$2" ) >> "$4" 2>&1; then return 0; fi
  local out reason code; out=$(tail -n "+$from" "$4")
  reason=$(grep -oE "(DSH_NATIVE_[A-Z_]+|NATIVE_RETENTION_[A-Z_]+)( \[.{0,250})?" <<<"$out" | tail -1 || true); code=${reason%% *}
  # The UNCOVERED and two-step hints stay while a rollback can still reach a MET-195-era release.
  if grep -qE 'relation "[^"]+" does not exist' <<<"$out"; then
    echo "the candidate's checker needs tables from migrations not yet applied: a defect, the checker must run on the schema before its migrations (MET-195-era releases instead needed the official two-step procedure, docs/dev-test-execution-retirement.md)"
  elif [[ "$code" == *INCOMPATIBLE* ]]; then
    echo "existing contexts are incompatible with this version: ${reason:0:300}. Archive them or confirm first"
  elif [[ "$code" == *JOURNAL_CONTRACT* ]]; then
    echo "this version's journal contract range does not cover the journals in the database: ${reason:0:300}"
  elif [[ "$code" == *UNCOVERED* ]]; then
    echo "existing chats or schedules use a native artifact this version does not cover: ${reason:0:300}. Needs the MET-195 transition or retiring those contexts first"
  else echo "pre-stop native check failed: ${reason:-see $4}"; fi
  return 1
}

discard() { git -C "$REPO" worktree remove --force "$1" 2>/dev/null || rm -rf -- "$1"; git -C "$REPO" worktree prune; }

status() {
  echo "configured release: $(release_of)"
  echo "configured sha:     $(penv "$WORKER_PLIST" ALLRICE_RELEASE_SHA)"
  echo "running sha:        web $(ready_sha "http://127.0.0.1:$(web_port)/api/health/ready" | cut -c1-8)  worker $(ready_sha "http://127.0.0.1:$(worker_port)/health/ready" | cut -c1-8)  (empty = not ready)"
  echo "native artifact:    $(penv "$WORKER_PLIST" ALLRICE_DSH_NATIVE_ARTIFACT_ID) (configured)"
  echo "tools version:      $(cat "$BIN/TOOLS_VERSION" 2>/dev/null || echo "unknown ($BIN)")"
  local row hw prev why
  if ! row=$(contract_row 2>/dev/null); then hw="unknown (database not readable)"
  elif [ -z "$row" ]; then hw="not written yet"; else hw=${row#row:}; fi
  echo "journal contract:   high water $hw"
  if ! prev=$(previous_release); then echo "rollback check:     no recorded previous release (roll back with --rollback <release-dir>)"
  elif ! why=$(check_migrations_known "$prev") || ! why=$(check_contract_known "$prev"); then
    echo "rollback check:     $(basename "$prev") would be REFUSED: $why"
  elif [ -f "$prev/packages/database/dist/native-journal-contract-store.js" ]; then
    echo "rollback check:     $(basename "$prev") knows every applied migration and the journal contract (pre-stop check not run)"
  else echo "rollback check:     $(basename "$prev") knows every applied migration; it predates the journal contract, fine while the journals are at contract 1 (pre-stop check not run)"; fi
  if [ -e "$INFLIGHT" ]; then
    if lock_held "$LOCK"; then echo "DEPLOY IN PROGRESS (phase '$(sed -n 1p "$INFLIGHT/state" 2>/dev/null)')"
    else echo "UNFINISHED DEPLOY (phase '$(sed -n 1p "$INFLIGHT/state" 2>/dev/null)'): run deploy-dev --release-manager --recover"; fi
  fi
  "$BIN/deploy-lock" status || true
  [ -f "$LOG" ] && { echo "recent deploys:"; tail -5 "$LOG"; }
  return 0
}

recover() {
  take_lock || die "deploy lock is held; $("$BIN/deploy-lock" status)" 3
  [ -f "$INFLIGHT/state" ] || die "nothing to recover (no unfinished deploy recorded)"
  local phase; phase=$(sed -n 1p "$INFLIGHT/state")
  restore || die "recovery did not bring the previous version back; see above"
  log_deploy kind recover phase "$phase" restored yes
  inflight_end
  say "recovered"
}

prune_releases() { # keep the current, the previous and the newest KEEP_RELEASES deploy-created ones
  local current previous; current=$(release_of)
  previous=$(sed -n 1p "$STATE/.previous-release" 2>/dev/null || true)
  ls -1dt "$RELEASES"/20[0-9][0-9][0-9][0-9][0-9][0-9]-* 2>/dev/null | tail -n +$((KEEP_RELEASES + 1)) | while read -r old; do
    [ "$old" = "$current" ] || [ "$old" = "$previous" ] && continue
    git -C "$REPO" worktree remove --force "$old" 2>/dev/null || rm -rf -- "$old"
    say "pruned old release $(basename "$old")"
  done
  git -C "$REPO" worktree prune
}

# Recorded facts about a release: "sha artifact", from the newest log entry that has both.
release_facts() {
  [ -f "$LOG" ] || return 1
  "$M1_PY" - "$LOG" "$1" <<'PY'
import json,sys
log,rel=sys.argv[1:]
for line in reversed(open(log).read().splitlines()):
    try: d=json.loads(line)
    except Exception: continue
    for side in ('to','from'):
        if d.get(side+'Release')==rel and d.get(side+'Sha') and d.get(side+'Artifact'):
            print(d[side+'Sha'], d[side+'Artifact']); sys.exit(0)
sys.exit(1)
PY
}

# What the database has applied against what a release knows: migration_diff (lib.sh).
migrations_vs() { # release -> "unknown|pending <name>" lines; on failure prints the reason, exit 1
  local applied
  applied=$(dev_sql "select name from allrice_schema_migrations order by name") || { echo "cannot read allrice_schema_migrations"; return 1; }
  [ -n "$applied" ] || { echo "allrice_schema_migrations is empty"; return 1; }
  printf '%s\n' "$applied" | migration_diff "$1"
}
# An older binary refuses a database with migrations it does not know (db:verify): the
# rollback gate. A deploy uses the same diff to learn what db:prepare is going to run.
check_migrations_known() { # release -> prints the pending names; prints unknown names or the reason and exits 1
  local diff unknown
  diff=$(migrations_vs "$1") || { echo "$diff"; return 1; }
  unknown=$(printf '%s\n' "$diff" | sed -n 's/^unknown //p')
  [ -z "$unknown" ] || { echo "$unknown" | head -5 | tr '\n' ' '; return 1; }
  printf '%s\n' "$diff" | sed -n 's/^pending //p'
}
# Journals written under a contract above 1 need a release that knows the high water
# (MET-221 PR2b-1). An older one has no contract check of its own, so its pre-stop check
# would pass while its Worker cannot read them. The marker is the built
# packages/database/dist/native-journal-contract-store.js: renaming that module needs
# this check changed in the same PR.
contract_row() { # "row:<highWater>", "row:invalid <value>" when it is not a JSON number, nothing when there is no row
  dev_sql "select 'row:' || $CONTRACT_HW from allrice_runtime_metadata where key='dsh-journal-contract'"
}
CONTRACT_HW="case when jsonb_typeof(value->'highWater') = 'number' then value->>'highWater' else 'invalid ' || value::text end"
check_contract_known() { # release -> 0; prints why and exits 2 when it predates the contract reached, 1 when unreadable
  local row hw
  row=$(contract_row) || { echo "cannot read the journal contract high water"; return 1; }
  hw=${row#row:}; [ -n "$row" ] || hw=1 # no row yet: every journal is contract 1
  [[ "$hw" =~ ^[1-9][0-9]{0,8}$ ]] || { echo "unreadable journal contract row: ${hw:0:120}"; return 1; }
  [ "$hw" -le 1 ] || [ -f "$1/packages/database/dist/native-journal-contract-store.js" ] \
    || { echo "the journals reach contract $hw and $(basename "$1") predates the journal contract (no native-journal-contract-store.js)"; return 2; }
}
# With both services stopped and before db:prepare: snapshot when migrations are pending
# (they may be one-way) or when forced.
pre_migrate_snapshot() { # name pending forced
  if [ -z "$2" ] && [ "$3" != 1 ]; then say "no migrations to apply; no snapshot"; return 0; fi
  inflight_phase snapshot
  say "snapshot before migrating ($([ -n "$2" ] && echo "to apply:" $2 || echo "forced; no migrations to apply")) into $SNAPSHOTS/$1"
  local t; t=$(date +%s)
  snapshot "$1" || die "pre-migration snapshot failed"
  say "snapshot taken in $(( $(date +%s) - t ))s ($(du -sh "$SNAPSHOTS/$1" | cut -f1))"
}
previous_release() { # the release deployed before the current one, when recorded
  local prev; prev=$(sed -n 1p "$STATE/.previous-release" 2>/dev/null || true)
  [ -n "$prev" ] && [ "$(sed -n 2p "$STATE/.previous-release")" = "$(release_of)" ] && echo "$prev"
}

rollback_gate() { # target sha -> dies, before anything stops, when the target cannot run on this database
  local why
  why=$(check_migrations_known "$1") \
    || die "cannot roll back to ${2:0:8}: the database has migrations it does not know or could not be checked: $why"
  why=$(check_contract_known "$1") || die "cannot roll back to ${2:0:8}: $why"
}

rollback() { # [release-dir]
  local cur_rel cur_sha cur_art target="${1:-}"
  cur_rel=$(release_of); cur_sha=$(penv "$WORKER_PLIST" ALLRICE_RELEASE_SHA); cur_art=$(penv "$WORKER_PLIST" ALLRICE_DSH_NATIVE_ARTIFACT_ID)
  if [ -z "$target" ]; then
    target=$(previous_release) \
      || die "no recorded previous release for the current one ($cur_rel); pass the target: --rollback <release-dir>"
  fi
  [ -d "$target" ] || die "release directory is gone: $target"
  [ "$target" != "$cur_rel" ] || die "Dev already runs $target"
  local facts sha art; facts=$(release_facts "$target") || die "no recorded SHA and artifact for $target"
  read -r sha art <<<"$facts"
  rollback_gate "$target" "$sha"
  mkdir -p "$STATE/deploy-logs"; BLOG="$STATE/deploy-logs/rollback-$(date +%Y%m%d-%H%M%S).log"
  say "checking that ${sha:0:8} covers the current native references"
  local why; why=$(precheck "$target" "$sha" "$art" "$BLOG") || die "$why. Dev untouched."
  take_lock || die "deploy lock is held; $("$BIN/deploy-lock" status)" 3
  [ "$(release_of)" = "$cur_rel" ] || die "the current release changed while checking; start again"
  rollback_gate "$target" "$sha" # a deploy that ended meanwhile may have raised either
  say "rolling back to $(basename "$target") (${sha:0:8}); database migrations are not reverted"
  inflight_begin "$cur_sha"
  stop_both || die "services did not stop"
  inflight_phase switching
  point_plists "$target" "$sha" "$([ "$art" != "$cur_art" ] && echo "$art")"
  start_both_on "$sha" || die "rollback target did not become healthy"
  # Records first, then clear the in-flight state, then release the lock.
  log_deploy kind rollback fromRelease "$cur_rel" fromSha "$cur_sha" fromArtifact "$cur_art" toRelease "$target" toSha "$sha" toArtifact "$art"
  rm -f "$STATE/.previous-release" # a second --rollback must name its target: rolling back is not a stack
  inflight_end; release_lock
  say "rolled back; Dev runs ${sha:0:8}"
}

deploy() {
  local ref=origin/main force=0 smoke=1 snap=0
  while [ $# -gt 0 ]; do case "$1" in
    --ref) ref=${2:?}; shift 2 ;; --force) force=1; shift ;; --skip-smoke) smoke=0; shift ;;
    --force-snapshot) snap=1; shift ;;
    *) die "unknown option $1" 2 ;; esac; done
  local t0; t0=$(date +%s)
  ! lock_held "$LOCK" || die "a deploy is in progress ($("$BIN/deploy-lock" status)); stop and retry later" 3
  [ ! -e "$INFLIGHT" ] || die "an earlier deploy did not finish; run deploy-dev --release-manager --recover first"
  local avail; avail=$(df -g "$HOME" | awk 'NR==2{print $4}')
  [ "$avail" -ge 20 ] || die "only ${avail}G free; clean up before building"

  git -C "$REPO" fetch -q origin
  local sha; sha=$(resolve_ref "$ref")
  local cur_rel cur_sha cur_art; cur_rel=$(release_of); cur_sha=$(penv "$WORKER_PLIST" ALLRICE_RELEASE_SHA); cur_art=$(penv "$WORKER_PLIST" ALLRICE_DSH_NATIVE_ARTIFACT_ID)
  if [ "$sha" = "$cur_sha" ] && [ $force = 0 ]; then say "Dev already runs ${sha:0:8}; nothing to deploy (use --force to rebuild)"; return 0; fi

  local rel; rel="$RELEASES/$(date +%Y%m%d-%H%M)-${sha:0:8}"
  [ -e "$rel" ] && die "release directory exists: $rel"
  mkdir -p "$STATE/deploy-logs"; BLOG="$STATE/deploy-logs/$(basename "$rel").log"
  say "building ${sha:0:8} ($ref) in $(basename "$rel"); log: $BLOG"
  git -C "$REPO" worktree add -q --detach "$rel" "$sha"
  BUILD_DIR=$rel
  ( cd "$rel" && pnpm install --frozen-lockfile && \
    pnpm -r --workspace-concurrency=1 --filter '@allrice/worker...' --filter '@allrice/web...' --if-present run build ) > "$BLOG" 2>&1 \
    || { log_deploy kind failed phase build sha "$sha" log "$BLOG"; die "build failed; see $BLOG (Dev untouched)"; }
  local art
  art=$(cd "$rel" && node apps/worker/scripts/prepare-native-artifact.mjs --root="$PWD" 2>>"$BLOG" | tail -1 | "$M1_PY" -c 'import json,sys;print(json.load(sys.stdin)["artifactId"])') \
    || { log_deploy kind failed phase artifact sha "$sha" log "$BLOG"; die "native artifact preparation failed; see $BLOG (Dev untouched)"; }
  ( cd "$rel" && node scripts/dev-release/prepare-identity.mjs --root="$rel" --release-sha="$sha" ) >> "$BLOG" 2>&1 \
    || { log_deploy kind failed phase identity sha "$sha" log "$BLOG"; die "build identity failed; see $BLOG (Dev untouched). Versions before PR #533 cannot seal identity on M1."; }
  say "built in $(( $(date +%s) - t0 ))s; native artifact ${art:7:12}… ($([ "$art" = "$cur_art" ] && echo unchanged || echo CHANGED))"

  say "pre-stop check: does ${sha:0:8} cover the current chats and schedule controls?"
  local why; if ! why=$(precheck "$rel" "$sha" "$art" "$BLOG"); then
    log_deploy kind failed phase precheck sha "$sha" reason "$why" log "$BLOG"; die "$why. Dev untouched." 4
  fi
  BUILT=1 # from here the build is kept, also when the lock is busy

  take_lock || die "another deploy started meanwhile; build kept at $rel (rerun deploy-dev later)" 3
  [ ! -e "$INFLIGHT" ] || die "an earlier deploy did not finish; build kept at $rel. Run deploy-dev --release-manager --recover first"
  [ "$(release_of)" = "$cur_rel" ] || die "Dev changed while this version was building; build kept at $rel, start again"
  local pending; pending=$(check_migrations_known "$rel") || {
    log_deploy kind failed phase migrations sha "$sha" reason "$pending" log "$BLOG"
    die "the database has migrations ${sha:0:8} does not know or could not be checked: $pending; build kept at $rel (Dev untouched)"; }
  why=$(check_contract_known "$rel") || {
    log_deploy kind failed phase contract sha "$sha" reason "$why" log "$BLOG"; die "$why; build kept at $rel (Dev untouched)"; }
  local down_at boot; down_at=$(date +%s); boot=$(worker_boot)
  inflight_begin "$cur_sha"
  say "stopping web and worker"
  stop_both || die "services did not stop"
  report_after_stop "$boot"
  pre_migrate_snapshot "$(basename "$rel")" "$pending" "$snap"
  inflight_phase migrating
  say "db:prepare (migrate, sync platform content, verify)"
  ( cd "$rel" && "$BIN/with-env" worker pnpm db:prepare ) >> "$BLOG" 2>&1 || die "db:prepare failed; see $BLOG"
  inflight_phase switching
  point_plists "$rel" "$sha" "$([ "$art" != "$cur_art" ] && echo "$art")"
  start_both_on "$sha" || die "${sha:0:8} did not become healthy"
  local downtime=$(( $(date +%s) - down_at ))
  # Records first, then clear the in-flight state, then release the lock.
  log_deploy kind deploy fromRelease "$cur_rel" fromSha "$cur_sha" fromArtifact "$cur_art" toRelease "$rel" toSha "$sha" toArtifact "$art" ref "$ref" downtimeSeconds "$downtime"
  printf '%s\n%s\n' "$cur_rel" "$rel" > "$STATE/.previous-release"
  inflight_end; release_lock
  say "Dev now runs ${sha:0:8} (downtime ${downtime}s); lock released"
  prune_releases

  if [ $smoke = 1 ]; then
    local out; out="$STATE/smoke/$(date +%Y%m%d-%H%M%S)-${sha:0:8}"
    say "running the smoke test against ${sha:0:8}"
    local ok=0; "$BIN/smoke-test" --dev --expect-sha "$sha" --out "$out" && ok=1
    log_deploy kind smoke sha "$sha" result "$([ $ok = 1 ] && echo passed || echo failed)" out "$out"
    [ $ok = 1 ] || die "smoke test failed on ${sha:0:8}. Inspect $out/result.json; to switch back run: deploy-dev --release-manager --rollback" 5
    say "smoke passed"
  fi
  say "done in $(( $(date +%s) - t0 ))s"
}

[ "${BASH_SOURCE[0]}" = "$0" ] || return 0 # sourced for its functions (test_deploy_dev.py)

# --release-manager is a deliberate speed bump: a session the user did not appoint as
# release manager stops here and writes its deploy request on its MET card instead.
RM=0; ARGS=()
for a in "$@"; do if [ "$a" = --release-manager ]; then RM=1; else ARGS+=("$a"); fi; done
set -- ${ARGS[@]+"${ARGS[@]}"}
need_rm() {
  [ "$RM" = 1 ] || die "only the release manager deploys or rolls back the shared Dev (AGENTS.md §9 at the repository root). If the user appointed you, add --release-manager; otherwise write the deploy request on your MET card and stop." 6
}
MODE="${1:-deploy}"

case "${1:-}" in
  --status) status ;;
  --rollback) need_rm; shift; rollback "${1:-}" ;;
  --recover) need_rm; recover ;;
  -h|--help) sed -n 2,33p "$0" ;;
  *) need_rm; deploy "$@" ;;
esac
