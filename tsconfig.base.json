{
  "compilerOptions": {
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@allrice/browser-control": ["packages/browser-control/src/index.ts"],
      "@allrice/contracts": ["packages/contracts/src/index.ts"],
      "@allrice/database": ["packages/database/src/index.ts"],
      "@allrice/storage": ["packages/storage/src/index.ts"],
      "@allrice/office-runtime": ["packages/office-runtime/src/index.ts"]
    },
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023"
  }
}
