FROM node:22-alpine
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/dsh-admin/package.json apps/dsh-admin/package.json
COPY packages/dsh-runtime-diff/package.json packages/dsh-runtime-diff/package.json
COPY packages/dsh-web-search-codex/package.json packages/dsh-web-search-codex/package.json
COPY patches patches
RUN pnpm install --frozen-lockfile
COPY apps/dsh-admin apps/dsh-admin
COPY packages/dsh-runtime-diff packages/dsh-runtime-diff
COPY packages/dsh-web-search-codex packages/dsh-web-search-codex
ENV NODE_ENV=production
EXPOSE 3081
CMD ["pnpm", "--filter", "@allrice/dsh-admin", "start"]
