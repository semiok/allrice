FROM node@sha256:83f487e0a63425e5b4d146fb5e5be574bcbe1b7b843d3ebafdd95eaf7767a7e5 AS office-fonts
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-cjk=1:20220127+repack1-1 fonts-dejavu-core=2.37-6 \
    && rm -rf /var/lib/apt/lists/*

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.33.3 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY packages/browser-control/package.json packages/browser-control/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/office-runtime/package.json packages/office-runtime/package.json
COPY packages/database/package.json packages/database/package.json
COPY packages/storage/package.json packages/storage/package.json
COPY packages/ui/package.json packages/ui/package.json
COPY patches patches
RUN pnpm install --frozen-lockfile
COPY . .
RUN pnpm --filter @allrice/web... build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=office-fonts /usr/share/fonts/ /usr/share/fonts/
COPY --from=office-fonts /usr/share/doc/fonts-noto-cjk/copyright /usr/share/licenses/allrice-fonts/noto-cjk
COPY --from=office-fonts /usr/share/doc/fonts-dejavu-core/copyright /usr/share/licenses/allrice-fonts/dejavu
RUN corepack enable && corepack prepare pnpm@11.2.2 --activate
COPY --from=build /app /app
EXPOSE 3000
CMD ["pnpm", "--filter", "@allrice/web", "start"]
