FROM node:22.23.2-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-uno libreoffice-writer libreoffice-calc libreoffice-impress \
    poppler-utils fonts-noto-cjk fonts-crosextra-carlito fonts-crosextra-caladea \
    libseccomp2 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY apps/office-renderer/ /app/
ENV HOME=/tmp SAL_USE_VCLPLUGIN=svp PYTHONDONTWRITEBYTECODE=1
USER 65534:65534
EXPOSE 3112
HEALTHCHECK --interval=10s --timeout=3s CMD ["python3", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:3112/health', timeout=2)"]
CMD ["python3", "server.py"]
