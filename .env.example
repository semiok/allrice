ALLRICE_ENV=development
ALLRICE_WEB_PORT=3000
ALLRICE_WORKER_PORT=3101
ALLRICE_WORKER_POLL_INTERVAL_MS=5000
ALLRICE_STORAGE_ROOT=.local/storage

# Leave blank to let `pnpm dev` provision an isolated pgvector database.
# Set this to use an existing PostgreSQL 17 database instead.
DATABASE_URL=
ALLRICE_DEV_DB_PORT=54329

# Used by both the development database and the full Compose deployment.
POSTGRES_DB=allrice
POSTGRES_USER=allrice
POSTGRES_PASSWORD=allrice
ALLRICE_STORAGE_ROOT=.local/storage
# Required in production; use at least 32 random bytes.
ALLRICE_STORAGE_SIGNING_SECRET=change-this-to-at-least-32-random-bytes

# Required only when running `pnpm identity:bootstrap` for the first admin.
# ALLRICE_BOOTSTRAP_ORG_SLUG=tnlabs
# ALLRICE_BOOTSTRAP_ORG_NAME=TNlabs
# ALLRICE_BOOTSTRAP_WORKSPACE_SLUG=default
# ALLRICE_BOOTSTRAP_WORKSPACE_NAME=Default
# ALLRICE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
