ALLRICE_ENV=development
ALLRICE_WEB_PORT=3000
# P11 transport only; requires the separately governed operation ledger rollout.
# Old HTTP Bridge endpoints remain available when this is 0.
ALLRICE_BRIDGE_WSS_ENABLED=1
# Private project preview uses one HTTPS origin per service. Configure the owned
# wildcard DNS/TLS and ingress first; leave empty when no preview gateway exists.
ALLRICE_PROJECT_PREVIEW_SUFFIX=
# Exact application origins allowed to embed an authenticated project preview.
ALLRICE_PUBLIC_URL=https://allrice.bplabs.xyz
ALLRICE_ADMIN_PUBLIC_URL=https://allrice-admin.bplabs.xyz
ALLRICE_WORKER_PORT=3101
# Web-to-Worker authenticated, read-only Run diagnostics; blank uses loopback.
ALLRICE_WORKER_INTERNAL_URL=
# Fixed loopback health collector for the platform technical console.
# Configure the actual Worker port in each environment; never point Dev at Prod.
ALLRICE_TECHNICAL_WORKER_HEALTH_URL=http://127.0.0.1:3101/health/ready
ALLRICE_TECHNICAL_WEB_HEALTH_URL=http://127.0.0.1:3000/api/health/ready
ALLRICE_WORKER_POLL_INTERVAL_MS=1000
ALLRICE_WORKER_LEASE_MS=30000
ALLRICE_WORKER_HEARTBEAT_MS=10000
ALLRICE_WORKER_CONCURRENCY=auto
# Claim gate (MET-219). macOS: kernel pressure level and reclaimable pages;
# Linux: MemAvailable or cgroup headroom. 0 disables the floor.
ALLRICE_WORKER_MIN_AVAILABLE_MEMORY_MB=256
ALLRICE_WORKER_MEMORY_PAUSE_PRESSURE=critical
ALLRICE_EXECUTION_ROOT=.local/executions
ALLRICE_STORAGE_ROOT=.local/storage
# Codex is a DSH Provider authenticated through the administrator device-code
# flow. DSH owns its private credential store; no Codex CLI files are mounted.
ALLRICE_DSH_CODEX_MODEL=gpt-6-luna
ALLRICE_DSH_CODEX_REASONING_EFFORT=xhigh
# Private writable directory owned by the Worker. Never mount a user's Codex
# home here; DSH stores platform Provider grants in this directory.
ALLRICE_DSH_PLATFORM_HOME=.local/dsh-platform
# Reviewed content ID printed by prepare-identity / the Worker image build.
# Preparation is not approval. Worker startup rejects missing/mismatched IDs.
ALLRICE_DSH_NATIVE_ARTIFACT_ID=
# Set the same seal on Web and Worker. Contexts bind to the DSH generation; any
# release of that generation continues them (MET-221).
# Retained artifact slots (ALLRICE_DSH_RETAINED_*) and origin readers
# (ALLRICE_DSH_ORIGIN_READER_*) are retired (MET-221): a non-empty value refuses
# the Worker start.
# Enable read-only subscription percentage/reset-time queries with a trusted
# native Codex executable (not the npm JS shim). Uses the DSH grant above.
# ALLRICE_CODEX_QUOTA_COMMAND=/absolute/path/to/codex
# Optional deployment-owned DSH egress route. AllRice deliberately does not
# inherit ambient host proxy variables into tenant runtime processes.
# ALLRICE_DSH_HTTP_PROXY=http://proxy.example:8080
# ALLRICE_DSH_HTTPS_PROXY=http://proxy.example:8080
# ALLRICE_DSH_NO_PROXY=localhost,127.0.0.1
# Deployment-owned pricing in cents per million tokens. Keep `{}` only for
# local development; production should list every metered API Provider.
ALLRICE_MODEL_PRICING_JSON={}
ALLRICE_PLATFORM_ADMIN_EMAILS=semiokshen@gmail.com
# Trusted operator-created repository catalog, shared by Web and Worker.
# Leave empty to disable private repository repair; never use a company folder.
ALLRICE_REPOSITORY_BASELINE_DIR=

# MET-87 temporary host-bound portal login. Passwords and signing secrets are
# deployment-only values: never commit populated values. The intentionally
# simple bootstrap usernames are admin (platform), snow and drink.
ALLRICE_PORTAL_AUTH_ENABLED=0
# Shared employee login locally; legacy host portals are retained for migration.
ALLRICE_LOCAL_PORTAL=unified
ALLRICE_PORTAL_SESSION_SECRET=
# Set to 0 only for loopback HTTP smoke tests. Public dev/prod domains use 1.
ALLRICE_PORTAL_SECURE_COOKIE=1
ALLRICE_PLATFORM_ADMIN_USER=admin
ALLRICE_PLATFORM_ADMIN_PASSWORD=
ALLRICE_PLATFORM_BOOTSTRAP_EMAIL=semiokshen@gmail.com
ALLRICE_SNOW_USER=snow
ALLRICE_SNOW_PASSWORD=
ALLRICE_DRINK_USER=drink
ALLRICE_DRINK_PASSWORD=
ALLRICE_DRINK_BOOTSTRAP_EMAIL=drink@bootstrap.allrice.local

# Leave blank to let `pnpm dev` provision an isolated pgvector database.
# Set this to use an existing PostgreSQL 17 database instead.
DATABASE_URL=
ALLRICE_DEV_DB_PORT=54329

# Used by both the development database and the full Compose deployment.
POSTGRES_DB=allrice
POSTGRES_USER=allrice
POSTGRES_PASSWORD=allrice
ALLRICE_STORAGE_ROOT=.local/storage
# Required in production; use at least 32 random bytes.
ALLRICE_STORAGE_SIGNING_SECRET=change-this-to-at-least-32-random-bytes

# Required only when running `pnpm identity:bootstrap` for the first account.
# Add the same email to ALLRICE_PLATFORM_ADMIN_EMAILS to make it a platform admin.
# ALLRICE_BOOTSTRAP_ORG_SLUG=tnlabs
# ALLRICE_BOOTSTRAP_ORG_NAME=TNlabs
# ALLRICE_BOOTSTRAP_WORKSPACE_SLUG=default
# ALLRICE_BOOTSTRAP_WORKSPACE_NAME=Default
# ALLRICE_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# ALLRICE_BOOTSTRAP_ADMIN_NAME=Administrator
# ALLRICE_BOOTSTRAP_ADMIN_USERNAME=tnlabs-admin
# Pass the password as a file path on the command line, not in this file.
# ALLRICE_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# AllRice framework rollout. Set to 0 for an emergency visual rollback. For
# scoped canaries, provide the versioned JSON policy documented in MET-74.
ALLRICE_FRAMEWORK_V2=1
# ALLRICE_FRAMEWORK_V2_ROLLOUT_JSON={"schemaVersion":1,"emergencyOff":false,"defaultEnabled":false,"organizationIds":[],"workspaceIds":[],"employeeVersionIds":[],"surfaces":["workspace"]}
ALLRICE_CHATFLOW_REALTIME=1
# ALLRICE_CHATFLOW_REALTIME_ROLLOUT_JSON={"schemaVersion":1,"emergencyOff":false,"defaultEnabled":true,"organizationIds":[],"workspaceIds":[],"employeeVersionIds":[],"harnesses":["dsh"]}

# Implemented employee capabilities are available by default in development.
# Employee selection and publication control usage. Set a flag to 0 only to
# pause a broken service; device folder grants and action approvals still apply.
# MET198 desktop unified modules require db:migrate through 0201_workbench_file_policies.sql.
# Existing mobile navigation and native automation/Bridge execution are unchanged.
ALLRICE_WORKBENCH_ENABLED=1
ALLRICE_ASSISTANTS_ENABLED=1
ALLRICE_CHANGESET_ENABLED=1
ALLRICE_LOCAL_COMMAND_ENABLED=1
ALLRICE_LOCAL_SERVICE_ENABLED=1
ALLRICE_LOCAL_MCP_ENABLED=1
ALLRICE_LOCAL_BROWSER_ENABLED=1
ALLRICE_LOCAL_PREVIEW_ENABLED=1
ALLRICE_BROWSER_CONTROL_ENABLED=1
ALLRICE_CLOUD_RUNNER_ENABLED=1
ALLRICE_CLOUD_MCP_ENABLED=1
# Portal entries of this deployment, comma separated (host, optional :port), in
# addition to the built-in allrice.bplabs.xyz (employees) and allrice-admin.bplabs.xyz
# (platform admin). The first of each list is where links and redirects point; set
# ALLRICE_PUBLIC_URL / ALLRICE_ADMIN_PUBLIC_URL to the same entries (project
# previews use those). A host may not be both an employee and an admin entry.
# ALLRICE_EMPLOYEE_PORTAL_HOSTS=rice.example.com
# ALLRICE_ADMIN_PORTAL_HOSTS=rice-admin.example.com
# Cloud sandbox VM (colima + gVisor). Its CPU architecture follows the host:
# Apple silicon runs the native arm64 toolchain, an Intel Mac the amd64 one.
# Web and Worker must run a native Node: under Rosetta they refuse to start
# unless ALLRICE_CLOUD_ARCHITECTURE (amd64 | arm64) is set explicitly.
# Apple silicon (Homebrew in /opt/homebrew):
# ALLRICE_CLOUD_COLIMA=/opt/homebrew/bin/colima
# ALLRICE_CLOUD_PROFILE=allrice-cloud-arm
# Intel Mac (Homebrew in /usr/local; these are the defaults):
# ALLRICE_CLOUD_COLIMA=/usr/local/bin/colima
# ALLRICE_CLOUD_PROFILE=allrice-cloud-b4
# Shared by Web and Worker; generate once with openssl rand -hex 32 and persist.
# Encrypts private application/OAuth credentials. Public MCP needs no secret.
ALLRICE_MCP_CREDENTIAL_KEY=
ALLRICE_RUNTIME_POLICY_ENABLED=1
ALLRICE_BRIDGE_OPERATION_LEDGER_ENABLED=1
# Experience and memory review is available by default; users still choose
# which content to remember or share from Settings → 记忆与经验.
ALLRICE_EXPERIENCE_REVIEW_ENABLED=1

# Office preview/recalculation. pnpm dev starts the local renderer automatically.
# Set only when using an existing private renderer; this is not an enable switch.
# ALLRICE_OFFICE_RENDERER_URL=http://127.0.0.1:3112
