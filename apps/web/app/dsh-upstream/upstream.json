  "license": "MIT",
  "integration": "source-derived-webui-styles",
  "strategy": "pinned-upstream-plus-allrice-saas-adapter",
  "sources": [
    "packages/client/ui-theme/src/styles/design-platform.css",
    "packages/client/ui-theme/src/styles/base.css",
    "packages/client/ui-theme/src/styles/scrollbar.css",
    "packages/client/ui-layout/src/client/AppFrame.module.css",
    "packages/client/ui-sidebar/src/client/SidebarRoot.module.css",
    "packages/client/ui-conversation/src/client/chat/ChatView.module.css",
    "packages/client/ui-conversation/src/client/chat/MessageItem.module.css",
    "packages/client/ui-conversation/src/client/chat/AssistantMarkdown.module.css",
    "packages/client/ui-conversation/src/client/skeleton/ConversationRoot.module.css",
    "packages/client/ui-conversation/src/client/skeleton/InputBar.module.css",
    "packages/client/ui-conversation/src/client/queue/QueueDock.module.css",
    "packages/client/ui-primitives/src/icons/index.tsx (six QueueDock glyphs and Think glyph)",
    "packages/client/ui-primitives/src/DisclosureRow.tsx",
    "packages/client/ui-primitives/src/DisclosureRow.module.css",
    "packages/client/ui-conversation/src/client/chat/ReasoningRow.module.css"
  ],
  "adaptations": [
    {
      "source": "packages/client/ui-layout/src/client/AppFrame.tsx",
      "target": "apps/web/app/chatflow/workbench-splitter.tsx",
      "reuse": "DragHandle pointer capture, animation-frame throttling, frozen drag origin and frame ResizeObserver; native AppFrame handle/detailsCol CSS",
      "productChanges": "Shared sidebar / deliverables splitter; sidebar 240–420px and deliverables 340px–80vw with protected conversation width; scoped width preferences, cancellation cleanup, keyboard resizing and double-click reset"
    },
    {
      "source": "packages/client/ui-conversation/src/client/queue/QueueDock.tsx",
      "target": "apps/web/app/chatflow/queued-messages-dock.tsx",
      "reuse": "Native single-row / collapsed count list, awaited actions, unmodified QueueDock CSS and six native icons",
      "productChanges": "PostgreSQL authoritative inbox instead of local runtime store; edit returns text and attachments to composer; tenant-scoped remove/steer; no browser scheduler"
    },
    {
      "source": "packages/client/ui-primitives/src/DisclosureRow.tsx; packages/client/ui-conversation/src/client/chat/ReasoningRow.tsx",
      "target": "apps/web/app/chatflow/dsh-upstream/DisclosureRow.tsx; apps/web/app/chatflow/work-process.tsx",
      "reuse": "Native DisclosureRow and styles for the group and non-expandable step rows; category icons imported from the installed official ui-primitives 0.1.7-rc.1 package; keyboard expansion and running pulse.",
      "productChanges": "Chronological Chinese activity descriptions from public lifecycle facts and known tool display fields; no raw reasoning, command bodies or argument JSON. Server wall time appears once in the header, including while expanded. Employee identity and conversation accents follow the selected assignment."
    },
    {
      "source": "packages/client/ui-sidebar-right/src/client/shell/SidebarRight.module.css",
      "target": "apps/web/app/chatflow/workbench.module.css",
      "reuse": "Unmodified native SidebarRight visibility and host structure, native duration and easing, official DockLayout tabs and floating panes.",
      "productChanges": "Keep the inherited dock opening offset on the panel parent so tab visibility changes never replay the entrance. Only docked hosts inherit translation; floating panes stay independent. Reduced motion remains supported."
    },
    {
      "source": "packages/client/ui-chat/src/client/chat/TurnNavigator.tsx",
      "target": "apps/web/app/chatflow/dsh-upstream/turn-navigation/TurnNavigator.tsx",
      "reuse": "Official virtual rail, hover/focus previews, active marks, independent rail scrolling, reduced motion, original stylesheet and bounded preview helper. Component behavior is unchanged; host type imports and a scoped official theme class are adapted.",
      "productChanges": "Map existing Allrice user/assistant messages to loaded turns and Chinese labels; connect transcript anchors, reading position and composer/viewport measurements. Navigating back pauses automatic following. No new endpoint, model call or persisted content."
    }
  ],
