{
  "schemaVersion": 1,
  "harness": "dsh",
  "wireProtocol": "allrice-dsh-jsonrpc-v1",
  "sessionFormat": "dsh-session-jsonl-v3@0.1.5-rc.3",
  "runtimeProfile": "apps/worker/dsh/allrice-restricted.cordis.yml",
  "runtimeAdapter": "apps/worker/dsh/allrice-jsonrpc-runtime.mjs",
  "privateInterfaces": [
    {
      "id": "dsh-admin-webui-entrypoint",
      "upstreamInterface": "@deepseek-ai/dsh/lib/bin.js",
      "adapter": "apps/dsh-admin/dsh-webui-compatibility.mjs",
      "overrideEnvironmentVariable": "ALLRICE_DSH_COMMAND"
    }
  ],
  "configurationTree": [
    "credentials",
    "authorization",
    "attachments",
    "llm-provider-router",
    "llm-deepseek",
    "timer",
    "llm",
    "session",
    "session-title",
    "system-prompt",
    "tools",
    "agent",
    "invariants",
    "session-invariant",
    "agent-invariant",
    "scope-invariant",
    "agent-loop-invariant",
    "agent-loop",
    "skill-registry",
    "tool-skill",
    "sessions",
    "session-checkpoints",
    "llm-retry",
    "tool-call-timeout-policy",
    "repeat-tool-reminder",
    "user-questions",
    "tool-ask-user",
    "tool-todo",
    "session-projection",
    "token-meter",
    "tool-result-pruner",
    "compaction-basic"
  ],
  "securityBoundaries": {
    "shell": false,
    "unrestrictedFilesystem": false,
    "unrestrictedNetwork": false,
    "dynamicPlugins": false,
    "workerEnvironmentInheritance": false,
    "toolBrokerRequired": true
  },
  "productionSkillSources": ["allrice-published-runtime"],
  "excludedSkillSources": ["dsh-repository-development-skills"],
  "goldenReplay": [
    {
      "id": "ordinary-chat",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "maps streaming, turn and usage events into stable HarnessEvents"
    },
    {
      "id": "search",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "keeps native DSH search inside one turn and projects its tool events"
    },
    {
      "id": "skill",
      "testFile": "apps/worker/src/harness/dsh-protocol-runtime.test.ts",
      "testName": "reports the approved version and exposes native lifecycle methods"
    },
    {
      "id": "tool",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "routes tool envelopes only through the AllRice Tool Broker callback"
    },
    {
      "id": "attachment",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "forwards ordered image attachments to the native DSH prompt"
    },
    {
      "id": "cancel",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "interrupts one hung session and can recover with a clean runtime"
    },
    {
      "id": "recovery",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "interrupts one hung session and can recover with a clean runtime"
    },
    {
      "id": "compaction",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "uses DSH native compaction without replacing the live session"
    },
    {
      "id": "legacy-tool-history",
      "testFile": "apps/worker/test/p25/dsh-legacy-replay.test.ts",
      "testName": "resumes historical tool messages without re-executing their callbacks"
    },
    {
      "id": "legacy-question-adoption",
      "testFile": "apps/worker/test/p25/dsh-legacy-replay.test.ts",
      "testName": "adopts the exact answer from %s and continues once"
    },
    {
      "id": "legacy-continuation-no-replay",
      "testFile": "apps/worker/test/p25/dsh-legacy-replay.test.ts",
      "testName": "does not replay a continuation already dispatched by the historical runtime"
    },
    {
      "id": "legacy-format-refusal",
      "testFile": "apps/worker/test/p25/dsh-legacy-replay.test.ts",
      "testName": "refuses %s without rewriting the journal or dispatching a model"
    },
    {
      "id": "durable-question-restart",
      "testFile": "apps/worker/test/p25/task-wait-native.integration.test.ts",
      "testName": "releases the original process, adopts the exact answer after restart and dispatches the continuation once"
    },
    {
      "id": "native-progress-decision",
      "testFile": "apps/worker/test/p25/task-progress-native.integration.test.ts",
      "testName": "pauses after actual repeated tool errors and handles %s"
    }
  ]
}
