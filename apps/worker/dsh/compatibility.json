{
  "schemaVersion": 1,
  "harness": "dsh",
  "wireProtocol": "allrice-dsh-jsonrpc-v1",
  "sessionFormat": "dsh-session-jsonl-v4@0.2.1-rc.2",
  "runtimeProfile": "apps/worker/dsh/allrice-restricted.cordis.yml",
  "runtimeAdapter": "apps/worker/dsh/allrice-jsonrpc-runtime.mjs",
  "privateInterfaces": [
    {
      "id": "dsh-subagent-host-prompt",
      "upstreamInterface": "@deepseek-ai/dsh-subagent/internal",
      "adapter": "apps/worker/dsh/allrice-assistant-runtime.mjs",
      "upstreamVersion": "0.2.1-rc.2",
      "ledgerId": "allrice-development-workflow-v1"
    }
  ],
  "configurationTree": [
    "credentials",
    "authorization",
    "attachments",
    "llm-provider-router",
    "llm-deepseek",
    "timer",
    "llm",
    "session",
    "session-title",
    "system-prompt",
    "tools",
    "agent",
    "agent-loop",
    "skill-registry",
    "tool-skill",
    "sessions",
    "session-checkpoints",
    "llm-retry",
    "tool-call-timeout-policy",
    "repeat-tool-reminder",
    "user-questions",
    "tool-ask-user",
    "tool-todo",
    "session-projection",
    "token-meter",
    "tool-result-pruner",
    "compaction-basic",
    "native-fs",
    "native-working-directory"
  ],
  "securityBoundaries": {
    "shell": false,
    "unrestrictedFilesystem": false,
    "unrestrictedNetwork": false,
    "dynamicPlugins": false,
    "workerEnvironmentInheritance": false,
    "toolBrokerRequired": true
  },
  "productionSkillSources": ["allrice-published-runtime"],
  "excludedSkillSources": ["dsh-repository-development-skills"],
  "goldenReplay": [
    {
      "id": "ordinary-chat",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "maps streaming, turn and usage events into stable HarnessEvents"
    },
    {
      "id": "search",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "keeps native DSH search inside one turn and projects its tool events"
    },
    {
      "id": "skill",
      "testFile": "apps/worker/src/harness/dsh-protocol-runtime.test.ts",
      "testName": "reports the approved version and exposes native lifecycle methods"
    },
    {
      "id": "tool",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "routes tool envelopes only through the AllRice Tool Broker callback"
    },
    {
      "id": "attachment",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "forwards ordered image attachments to the native DSH prompt"
    },
    {
      "id": "cancel",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "interrupts one hung session and can recover with a clean runtime"
    },
    {
      "id": "recovery",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "interrupts one hung session and can recover with a clean runtime"
    },
    {
      "id": "compaction",
      "testFile": "apps/worker/src/harness/dsh-adapter.test.ts",
      "testName": "uses DSH native compaction without replacing the live session"
    },
    {
      "id": "legacy-official-migration",
      "testFile": "apps/worker/test/p25/dsh-legacy-replay.test.ts",
      "testName": "forwards an ordinary historical journal with the official migrators and keeps its bytes"
    },
    {
      "id": "legacy-format-refusal",
      "testFile": "apps/worker/test/p25/dsh-legacy-replay.test.ts",
      "testName": "candidate refuses historical %s instead of rewriting it or creating an empty substitute"
    },
    {
      "id": "durable-question-restart",
      "testFile": "apps/worker/test/p25/task-wait-native.integration.test.ts",
      "testName": "releases and resumes the native question exactly once (kind=%s)"
    },
    {
      "id": "native-progress-decision",
      "testFile": "apps/worker/test/p25/task-progress-native.integration.test.ts",
      "testName": "pauses after actual repeated tool errors and handles %s"
    },
    {
      "id": "journal-contract-surfaces",
      "testFile": "apps/worker/src/harness/native-journal-contract.test.ts",
      "testName": "matches the reviewed descriptor of the current contract version"
    },
    {
      "id": "journal-corpus-versions",
      "testFile": "apps/worker/test/p25/dsh-journal-replay.test.ts",
      "testName": "keeps one corpus for every readable contract version"
    },
    {
      "id": "journal-replay-tool",
      "testFile": "apps/worker/test/p25/dsh-journal-replay.test.ts",
      "testName": "continues after a recorded tool turn without dispatching the tool again"
    },
    {
      "id": "journal-replay-question",
      "testFile": "apps/worker/test/p25/dsh-journal-replay.test.ts",
      "testName": "answers %s with the recorded proof once, then continues it"
    },
    {
      "id": "journal-replay-continued",
      "testFile": "apps/worker/test/p25/dsh-journal-replay.test.ts",
      "testName": "starts a new turn after a continued question and never continues it twice"
    },
    {
      "id": "journal-replay-bootstrap-reference",
      "testFile": "apps/worker/test/p25/dsh-journal-replay.test.ts",
      "testName": "keeps bootstrap coverage and the session reference without injecting it again"
    }
  ],
  "historicalReaderPolicy": {
    "unpinnedDefault": "refused-unless-retained-slot-1-configured",
    "newRoots": "immutable-business-insert-and-independent-artifact-approval",
    "automaticV0V3PrivateMigration": false
  }
}
