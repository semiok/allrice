{
  "name": "@allrice/rice-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "rice-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@allrice/browser-control": "workspace:*",
    "@allrice/contracts": "workspace:*",
    "@allrice/office-runtime": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "crc-32": "1.2.2",
    "fflate": "0.8.3",
    "image-size": "1.2.1",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.62.1",
    "ws": "8.21.3",
    "yaml": "2.9.0",
    "yauzl": "3.2.0",
    "zod": "^4.4.3",
    "chokidar": "4.0.3",
    "@allrice/project-runtime": "workspace:*"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@types/yauzl": "2.10.3",
    "tsx": "^4.21.0"
  }
}
