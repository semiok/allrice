{
  "name": "@allrice/rice-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "rice-bridge": "dist/index.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@allrice/browser-control": "workspace:*",
    "@allrice/contracts": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright-core": "1.62.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "tsx": "^4.21.0"
  }
}
