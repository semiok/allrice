<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>xyz.bplabs.rice-bridge</string>
<!-- People see "AllRice 助手" (zh-Hans.lproj and en.lproj InfoPlist.strings) and
     "AllRice" in the menu bar. CFBundleDisplayName must stay equal to the
     unchanged "Rice Bridge.app" file name, or Finder shows the file name. -->
<key>CFBundleName</key><string>AllRice</string>
<key>CFBundleDisplayName</key><string>Rice Bridge</string>
<key>LSHasLocalizedDisplayName</key><true/>
<key>CFBundleExecutable</key><string>RiceBridgeApp</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.6.0</string>
  <key>CFBundleVersion</key><string>63</string>
<key>AllRicePairingServerURL</key><string>https://allrice-dsh.bplabs.xyz</string>
<key>LSMinimumSystemVersion</key><string>13.0</string>
<key>LSUIElement</key><true/>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
